<UserControl x:Class="CallMan.Views.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CallMan.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:CallMan.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:IndexToNumberConverter x:Key="IndexToNumberConverter"/>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Search & Add Bar -->
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>
            <!-- Input Form (Collapsible) -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- 1. SEARCH & ACTION BAR -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                 materialDesign:HintAssist.Hint="Search by Name or SKU" 
                 Style="{StaticResource MaterialDesignTextBox}"/>
            <Button Content="REFRESH" Command="{Binding RefreshCommand}" Margin="10,0" 
                Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>

        <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="IMPORT PRODUCTS" Command="{Binding OpenImportCommand}"  Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0" Background="#1794A1" BorderBrush="#1794A1" />
            <Button Command="{Binding OpenAddProductCommand}"
            Style="{StaticResource MaterialDesignRaisedButton}"
            Background="#1794A1" 
            BorderBrush="#1794A1"
            Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ADD NEW PRODUCT" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Background="#D9A426" Grid.Row="2"
        CornerRadius="6" 
        Padding="15,12" 
        Margin="0,0,0,15"
        Effect="{DynamicResource MaterialDesignShadowDepth1}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Counter" Width="18" Height="18" Foreground="#5E3A00" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalUniqueProductsCount}" 
                       FontSize="15" FontWeight="Bold" Foreground="#5E3A00" 
                       Margin="6,0,0,0" VerticalAlignment="Center"/>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" 
                       Background="#A37810" Margin="15,2" Height="16"/>

                    <TextBlock Text="Total Inventory Value: " FontSize="14" FontWeight="SemiBold" Foreground="#5E3A00" VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding GlobalInventoryCostValue, StringFormat=C2, ConverterCulture=en-IN}" 
                       FontSize="15" FontWeight="Bold" Foreground="#5E3A00" VerticalAlignment="Center"/>

                    <TextBlock Text=" + " FontSize="15" FontWeight="Bold" Foreground="#784C00" VerticalAlignment="Center" Margin="5,0"/>

                    <TextBlock Text="{Binding GlobalInventoryGstValue, StringFormat=C2, ConverterCulture=en-IN}" 
                       FontSize="15" FontWeight="Bold" Foreground="#5E3A00" VerticalAlignment="Center"/>

                    <TextBlock Text=" = " FontSize="15" FontWeight="Bold" Foreground="#784C00" VerticalAlignment="Center" Margin="5,0"/>

                    <TextBlock Text="{Binding CombinedTotalAssetValue, StringFormat=C2, ConverterCulture=en-IN}" 
                       FontSize="15" FontWeight="Black" Foreground="#422800" VerticalAlignment="Center"/>
                </StackPanel>

                <!--<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="On-Shelf Liquid Assets: " FontSize="13" FontWeight="SemiBold" Foreground="#5E3A00" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CombinedTotalAssetValue, StringFormat=C2, ConverterCulture=en-IN}" 
                       FontSize="15" FontWeight="Bold" Foreground="#610000" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>-->
            </Grid>
        </Border>

        <!-- 3. DATA LIST -->
        <DataGrid Grid.Row="3" x:Name="ProductsGrid" ItemsSource="{Binding FilteredProducts}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                  GridLinesVisibility="All" BorderBrush="Black" BorderThickness="2" HorizontalGridLinesBrush="Black"
                  VerticalGridLinesBrush="Black" AlternationCount="9999" SelectionUnit="FullRow">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                    <Setter Property="RowDetailsVisibilityMode" Value="Collapsed"/>
                </Style>
            </DataGrid.Style>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="5,8"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center" 
                               FontWeight="Bold"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                            <Setter Property="DetailsVisibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="DetailsVisibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="60">
                    <DataGridTemplateColumn.Header>
                        <CheckBox Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" SharedSizeGroup="SrNoGroup"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="TxtSerialNumber"  VerticalAlignment="Center"  HorizontalAlignment="Center" Foreground="DarkSlateGray">
                                    <TextBlock.Text>
                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" Path="(DataGrid.AlternationIndex)" Converter="{StaticResource IndexToNumberConverter}"/>
                                    </TextBlock.Text>
                                </TextBlock>

                                <CheckBox Grid.Row="1" IsChecked="{Binding IsSelectedForAction, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="60" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Product Category" Binding="{Binding CategoryName}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Avg Purchase Price (WAC)" 
                            Binding="{Binding CostPrice, StringFormat=C2, ConverterCulture=en-IN}" 
                            Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignLabelLargeTextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Standard Selling" 
                            Binding="{Binding SellingPrice, StringFormat=C2, ConverterCulture=en-IN}" 
                            Width="1*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Total Received" Binding="{Binding InitialStock}" Width="1*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Current Stock" Binding="{Binding RemainingStock}" Width="1*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Batches" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Center"
                    Padding="8,4"
                    Command="{Binding DataContext.ToggleBatchDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalBatchesCount}" 
                               FontWeight="Bold" 
                               Foreground="#1794A1"
                               Margin="0,0,4,0" 
                               VerticalAlignment="Center"/>

                                    <materialDesign:PackIcon x:Name="ArrowIcon" 
                                             Kind="ChevronDown" 
                                             Foreground="#1794A1"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter TargetName="ArrowIcon" Property="Kind" Value="ChevronUp"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Total Cost (Single Product)" 
                            Binding="{Binding TotalCost, StringFormat=C2, ConverterCulture=en-IN}" 
                            Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!--<DataGridTemplateColumn Header="Actions" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="Edit" Foreground="Orange"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="Delete" Foreground="Red"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,1" Padding="15,10" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Associated Product Lots / Batches" FontSize="12" FontWeight="Bold" Foreground="#1794A1" VerticalAlignment="Center"/>

                                <Button Grid.Column="1" 
                            Content="+ Add New Lot/Batch" 
                            Style="{StaticResource MaterialDesignOutlinedLightButton}"
                            FontSize="11" Height="28" Padding="10,0"
                            Command="{Binding DataContext.AddNewBatchRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                            </Grid>

                            <DataGrid Grid.Row="1"
                          ItemsSource="{Binding InnerBatchesCollection}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          GridLinesVisibility="All"
                          MinHeight="80" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Batch Number" Binding="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="2*"/>
                                    <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                                    <DataGridTextColumn Header="Purchase/Min Selling Price" Binding="{Binding MinimumSellingPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=C2, ConverterCulture=en-IN}" Width="2*"/>
                                    <DataGridTextColumn Header="Mfg Date" Binding="{Binding MfgDate, StringFormat=MMM-yyyy}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat=MMM-yyyy}" Width="1.5*"/>

                                    <DataGridTemplateColumn Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Save Changes" Width="30" Height="30"
                                                    Command="{Binding DataContext.SaveChangesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Foreground="#4CAF50"/>
                                                    </Button>

                                                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Remove Batch" Width="30" Height="30" Margin="5,0,0,0"
                                                    Command="{Binding DataContext.DeleteBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Foreground="#F44336"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>
</UserControl>
