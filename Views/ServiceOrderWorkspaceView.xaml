<UserControl x:Class="Tijori.Views.ServiceOrderWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F8FAFC">
    <UserControl.Resources>
        <materialDesign:BooleanToVisibilityConverter x:Key="InvertedBoolToVisConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <materialDesign:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
    </UserControl.Resources>
    <Grid Margin="16">

        <!-- ========================================================================= -->
        <!-- VIEW 1: ORDERS DIRECTORY / REGISTRY (Shown when IsFormOpen = False)       -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource InvertedBoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. TOOLBAR -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12" Margin="0,0,0,14">
                <DockPanel LastChildFill="False">

                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClipboardTextMultipleOutline" Width="26" Height="26" Foreground="#1794A1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Service Line Orders" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <Border Background="#E0F2FE" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalOrdersCount, StringFormat='{}{0} Orders'}" FontSize="10.5" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Contract manufacturing orders with multi-brand line batch tracking" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Search Box -->
                        <Border Background="#F1F5F9" CornerRadius="6" Width="260" Height="38" Padding="8,0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Grid.Column="0" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="Search by Order #, Customer..."
                                         BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"/>
                            </Grid>
                        </Border>

                        <Button Command="{Binding OpenCreateOrderCommand}" 
                                Background="#1794A1" BorderBrush="#1794A1" Foreground="White" 
                                FontWeight="SemiBold" Height="38" Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="CREATE ORDER" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. DIRECTORY DATA TABLE -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <DataGrid ItemsSource="{Binding FilteredOrders}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True"
                          RowHeight="44" 
                          GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#F1F5F9" 
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Order #" Binding="{Binding OrderNumber}" FontWeight="Bold" Width="140"/>
                        <DataGridTextColumn Header="Customer / Client" Binding="{Binding CustomerName}" FontWeight="SemiBold" Width="2*"/>
                        <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="120"/>
                        <DataGridTextColumn Header="Due Date" Binding="{Binding DeliveryDueDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="120"/>

                        <!-- Batch Work Orders Count Badge -->
                        <DataGridTemplateColumn Header="Batches" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BatchOrdersCount, StringFormat='{}{0} Batches'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Grand Total" Binding="{Binding GrandTotalAmount, StringFormat='{}{0:C}'}" FontWeight="Bold" Width="130"/>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OrderStatus}" FontSize="9.5" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" 
                                                ToolTip="Open / Edit Order"
                                                Width="28" Height="28" Padding="0" Margin="0,0,4,0">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" Foreground="#D97706"/>
                                        </Button>

                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" 
                                                ToolTip="Delete Order"
                                                Width="28" Height="28" Padding="0">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="#EF4444"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- VIEW 2: 2-STEP ORDER CREATION WIZARD (Shown when IsFormOpen = True)       -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- ============================================================= -->
            <!-- STEP 1: PRODUCT SPECS & FORMULA BUILDER (CurrentStep == 1)    -->
            <!-- ============================================================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Top Bar & Wizard Tracker -->
                    <RowDefinition Height="Auto"/>
                    <!-- Order Header Info -->
                    <RowDefinition Height="Auto"/>
                    <!-- Product Specs Drawer -->
                    <RowDefinition Height="*"/>
                    <!-- Live BOM / Recipe Grid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Footer with Counter & Next -->
                </Grid.RowDefinitions>

                <!-- Step 1 Top Bar -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding CloseWizardCommand}" Width="28" Height="28" Padding="0" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="#475569"/>
                            </Button>
                            <TextBlock Text="Step 1: Product Specs &amp; Formulation Builder" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Counter Pill -->
                        <Border DockPanel.Dock="Right" Background="#F0FDFA" BorderBrush="#1794A1" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CartOutline" Width="16" Height="16" Foreground="#1794A1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#1794A1">
                                    <Run Text="{Binding ConfiguredProductsCount, Mode=OneWay}"/>
                                    <Run Text=" Products Configured"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Order Header (Customer locked when item count > 0) -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Order Reference #:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding CurrentOrder.OrderNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="38"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Customer / Client Name:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding CustomersList}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name"
                                      IsEnabled="{Binding CanChangeCustomer}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="Order Date:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding CurrentOrder.OrderDate}" Height="38"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Delivery Due Date:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding CurrentOrder.DeliveryDueDate}" Height="38"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Product & Packaging Specs Drawer -->
                <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Row 1: Brand, FG, Formulation, Qty -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Customer Brand Name:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding CustomerBrandsList}" SelectedItem="{Binding SelectedBrand}" 
                                          Text="{Binding CustomBrandText, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="BrandName" 
                                          IsEditable="True" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Finished Good / Base Product (Optional):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding FinishedProductsList}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name" 
                                          IsEditable="True" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Master Formulation (Optional):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding MasterFormulationsList}" SelectedItem="{Binding SelectedFormulation}" DisplayMemberPath="FormulationName" 
                                          materialDesign:TextFieldAssist.HasClearButton="True" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Order Qty:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding ActiveItem.TargetQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="38"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Packaging Customizations & Pricing -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Packaging Type:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding PackagingTypes}" Text="{Binding ActiveItem.PackagingType}" IsEditable="True" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Pack Size / Vol:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding CommonPackSizes}" Text="{Binding ActiveItem.PackSize}" IsEditable="True" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Color / Shade:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding ActiveItem.ColorShade}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Fragrance / Flavor:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding CommonFragrances}" Text="{Binding ActiveItem.FragranceFlavor}" IsEditable="True" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Unit Rate (₹):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding ActiveItem.UnitPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="38"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live BOM & Recipe Table for Current Product -->
                <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- BOM Table Header -->
                        <TextBlock Grid.Row="0" Text="Recipe Bill of Materials (BOM) — Calculated for Active Item Batch Size" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                        <!-- Ingredient Fast-Adder Bar -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" Text="{Binding NewIngredientPhase}" IsEditable="True" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="36" Margin="0,0,8,0">
                                <ComboBoxItem Content="Phase A"/>
                                <ComboBoxItem Content="Phase B"/>
                                <ComboBoxItem Content="Phase C"/>
                                <ComboBoxItem Content="Phase D"/>
                            </ComboBox>

                            <ComboBox Grid.Column="1" ItemsSource="{Binding RawMaterialsList}" SelectedItem="{Binding SelectedRawMaterialToAdd}" DisplayMemberPath="Name" 
                                      IsEditable="True" materialDesign:HintAssist.Hint="Search &amp; Add Raw Material / Chemical..." Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="36" Margin="0,0,8,0"/>

                            <TextBox Grid.Column="2" Text="{Binding NewIngredientPercentage, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" 
                                     materialDesign:HintAssist.Hint="Qty (%)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="36" Margin="0,0,8,0"/>

                            <Button Grid.Column="3" Command="{Binding AddIngredientToActiveFormulaCommand}" Content="+ ADD RM" Background="#1794A1" Foreground="White" Height="36" Padding="12,0"/>
                        </Grid>

                        <!-- Ingredients Grid -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding ActiveBOMList}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="36" Style="{StaticResource MaterialDesignDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="100"/>
                                <DataGridTextColumn Header="Raw Material Name" Binding="{Binding RawMaterialName}" Width="2.5*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Percentage (%)" Binding="{Binding PercentageValue, StringFormat='{}{0:N2}%'}" FontWeight="Bold" Width="120"/>
                                <DataGridTextColumn Header="Actual Batch Qty" Binding="{Binding CalculatedQuantity, StringFormat='{}{0:N3} Kg'}" FontWeight="Bold" Foreground="#0284C7" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Mixing Remarks" Binding="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="22" Height="22" Padding="0" 
                                                    Command="{Binding DataContext.RemoveIngredientFromActiveFormulaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" Foreground="#EF4444"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Step 1 Footer -->
                <Border Grid.Row="4" Background="#F1F5F9" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="+ ADD PRODUCT TO ORDER" Command="{Binding AddItemToCartCommand}" Background="#0284C7" BorderBrush="#0284C7" Foreground="White" FontWeight="Bold" Height="36" Padding="14,0" Margin="0,0,10,0"/>
                            <Button Content="PROCEED TO REVIEW ➔" Command="{Binding GoToStep2Command}" Background="#1794A1" BorderBrush="#1794A1" Foreground="White" FontWeight="Bold" Height="36" Padding="16,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Active Ingredients: " Foreground="#64748B" FontSize="11.5"/>
                            <TextBlock Text="{Binding ActiveBOMTotalPercentage, StringFormat='{}{0:N2}%'}" FontWeight="Bold" Foreground="#0F172A" FontSize="12" Margin="0,0,14,0"/>
                            <TextBlock Text="Water (Aqua / QS): " Foreground="#0369A1" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActiveBOMWaterPercentage, StringFormat='{}{0:N2}%'}" FontWeight="Bold" Foreground="#0369A1" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============================================================= -->
            <!-- STEP 2: REVIEW & FINAL SUBMISSION (CurrentStep == 2)         -->
            <!-- ============================================================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Banner -->
                    <RowDefinition Height="*"/>
                    <!-- Configured Products Review DataGrid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Commercial Totals & Submit -->
                </Grid.RowDefinitions>

                <!-- Banner with Order & Customer info -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding GoToStep1Command}" Width="28" Height="28" Padding="0" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="#475569"/>
                            </Button>
                            <TextBlock Text="Step 2: Review Order &amp; Configured Product Recipes" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Customer: " Foreground="#64748B" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentOrder.CustomerName}" FontWeight="Bold" Foreground="#0F172A" FontSize="12" Margin="0,0,16,0"/>
                            <TextBlock Text="Order #: " Foreground="#64748B" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentOrder.OrderNumber}" FontWeight="Bold" Foreground="#1794A1" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Configured Products Grid (Review Mode) -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding CurrentOrder.Items}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="42" Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Brand Name" Binding="{Binding BrandName}" FontWeight="Bold" Width="1.5*"/>
                            <DataGridTextColumn Header="Product / Recipe Name" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="Packaging Spec" Binding="{Binding PackagingType}" Width="120"/>
                            <DataGridTextColumn Header="Pack Size" Binding="{Binding PackSize}" FontWeight="SemiBold" Width="100"/>
                            <DataGridTextColumn Header="Order Qty" Binding="{Binding TargetQuantity, StringFormat='{}{0:N0}'}" FontWeight="Bold" Width="100"/>
                            <DataGridTextColumn Header="Unit Rate" Binding="{Binding UnitPrice, StringFormat='{}{0:C}'}" Width="100"/>
                            <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat='{}{0:C}'}" FontWeight="Bold" Foreground="#15803D" Width="120"/>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="24" Height="24" Padding="0" 
                                                Command="{Binding DataContext.RemoveLineItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsOrderLocked, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InvertBooleanConverter}}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#EF4444"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Step 2 Footer -->
                <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="← BACK TO EDIT" Command="{Binding GoToStep1Command}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Margin="0,0,8,0"/>
                            <Button Content="CANCEL" Command="{Binding CloseWizardCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Margin="0,0,8,0"/>
                            <Button Content="SUBMIT SERVICE ORDER" Command="{Binding SubmitOrderCommand}" Background="#1794A1" BorderBrush="#1794A1" Foreground="White" FontWeight="Bold" Height="38" Padding="20,0"
                                    IsEnabled="{Binding IsOrderLocked, Converter={StaticResource InvertBooleanConverter}}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Sub Total:" FontSize="10.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CurrentOrder.SubTotalAmount, StringFormat='{}{0:C}'}" FontSize="13" FontWeight="Bold" Foreground="#334155"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Taxes (GST):" FontSize="10.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CurrentOrder.TaxAmount, StringFormat='{}{0:C}'}" FontSize="13" FontWeight="Bold" Foreground="#334155"/>
                            </StackPanel>

                            <Border Background="#DCFCE7" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Grand Total: " FontWeight="SemiBold" Foreground="#15803D" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentOrder.GrandTotalAmount, StringFormat='{}{0:C}'}" FontWeight="Black" Foreground="#15803D" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
