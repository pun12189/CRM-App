<Window x:Class="Tijori.Dialogs.CreateWorkflowDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Tijori.Converters"
        xmlns:local="clr-namespace:Tijori.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Create Workflow" Width="580" MaxHeight="680" 
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>
    <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Scrollable Form -->
                <RowDefinition Height="Auto"/>
                <!-- Footer Button -->
            </Grid.RowDefinitions>

            <!-- 1. Modal Top Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Create Workflow" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignIconButton}" 
                        Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="24" Height="24">
                    <materialDesign:PackIcon Kind="CloseCircleOutline" Foreground="#64748B" Width="18" Height="18"/>
                </Button>
            </Grid>

            <!-- 2. Scrollable Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <StackPanel>

                    <!-- Row: Select Event & Title -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Event Dropdown -->
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="Select Event" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBlock Text=" *" Foreground="#EF4444" FontSize="11"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding EventOptions}" 
                                      SelectedItem="{Binding CurrentWorkflow.EventName}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="11" Height="34" Padding="6,4"/>
                        </StackPanel>

                        <!-- Title Input -->
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="Title" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBlock Text=" *" Foreground="#EF4444" FontSize="11"/>
                            </StackPanel>
                            <TextBox Text="{Binding CurrentWorkflow.WorkflowName, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:HintAssist.Hint="Enter subject"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="11" Height="34" Padding="6,4"/>
                        </StackPanel>
                    </Grid>

                    <!-- Dynamic Days Field (Revealed on time-based triggers) -->
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding IsDaysInputVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Set number of days after which you want to take action" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text=" *" Foreground="#EF4444" FontSize="11"/>
                        </StackPanel>
                        <TextBox Text="{Binding CurrentWorkflow.ExecutionDays, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="11" Height="34" Padding="6,4"/>
                    </StackPanel>

                    <!-- Select Action: Dropdown with Action Filter Chips -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Select Action" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text=" *" Foreground="#EF4444" FontSize="11"/>
                        </StackPanel>

                        <Border BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="4" Padding="4">
                            <WrapPanel Orientation="Horizontal">
                                <!-- Selected Action Chips -->
                                <Border Background="#F1F5F9" CornerRadius="3" Padding="6,2" Margin="0,0,4,0"
                                        Visibility="{Binding CurrentWorkflow.SendEmail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Send Email" FontSize="10" Foreground="#334155" VerticalAlignment="Center"/>
                                        <Button Command="{Binding RemoveActionCommand}" CommandParameter="Send Email"
                                                Style="{StaticResource MaterialDesignIconButton}" Width="14" Height="14" Margin="4,0,0,0">
                                            <materialDesign:PackIcon Kind="Close" Width="10" Height="10" Foreground="#64748B"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F1F5F9" CornerRadius="3" Padding="6,2" Margin="0,0,4,0"
                                        Visibility="{Binding CurrentWorkflow.SendWhatsApp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Send Whatsapp" FontSize="10" Foreground="#334155" VerticalAlignment="Center"/>
                                        <Button Command="{Binding RemoveActionCommand}" CommandParameter="Send Whatsapp"
                                                Style="{StaticResource MaterialDesignIconButton}" Width="14" Height="14" Margin="4,0,0,0">
                                            <materialDesign:PackIcon Kind="Close" Width="10" Height="10" Foreground="#64748B"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F1F5F9" CornerRadius="3" Padding="6,2" Margin="0,0,4,0"
                                        Visibility="{Binding CurrentWorkflow.SendNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Send Notification" FontSize="10" Foreground="#334155" VerticalAlignment="Center"/>
                                        <Button Command="{Binding RemoveActionCommand}" CommandParameter="Send Notification"
                                                Style="{StaticResource MaterialDesignIconButton}" Width="14" Height="14" Margin="4,0,0,0">
                                            <materialDesign:PackIcon Kind="Close" Width="10" Height="10" Foreground="#64748B"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Available Actions Selector Button -->
                                <ComboBox ItemsSource="{Binding AvailableActions}" 
                                          DisplayMemberPath="Name" 
                                          SelectedItem="{Binding SelectedActionOption, Mode=TwoWay}"
                                          materialDesign:HintAssist.Hint="Select..."
                                          FontSize="10" BorderThickness="0" Height="24" Width="90"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>

                    <!-- CONDITIONAL SECTION 1: WHATSAPP CONFIG -->
                    <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                            Visibility="{Binding CurrentWorkflow.SendWhatsApp, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <!-- Sender & Recipient Pickers -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- From Number -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="From which number to send:" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Primary" IsChecked="{Binding CurrentWorkflow.WhatsAppSender, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Primary}" FontSize="10" Margin="0,0,8,0"/>
                                        <RadioButton Content="Leadholder" IsChecked="{Binding CurrentWorkflow.WhatsAppSender, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Leadholder}" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Recipient Target -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Send WhatsApp to:" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="Lead" IsChecked="{Binding CurrentWorkflow.WhatsAppToLead}" FontSize="10" Margin="0,0,8,0"/>
                                        <CheckBox Content="User" IsChecked="{Binding CurrentWorkflow.WhatsAppToUser}" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Message Body -->
                            <TextBlock Text="Whatsapp Message *" FontSize="10" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding CurrentWorkflow.WhatsAppMessage, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:HintAssist.Hint="Type message, use @ for variables..." 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="60" FontSize="11" Padding="6"/>
                        </StackPanel>
                    </Border>

                    <!-- CONDITIONAL SECTION 2: EMAIL CONFIG -->
                    <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8"
                            Visibility="{Binding CurrentWorkflow.SendEmail, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Send Email to: " FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                <CheckBox Content="Lead" IsChecked="{Binding CurrentWorkflow.EmailToLead}" FontSize="10" Margin="8,0,8,0"/>
                                <CheckBox Content="User" IsChecked="{Binding CurrentWorkflow.EmailToUser}" FontSize="10"/>
                            </StackPanel>

                            <TextBlock Text="Email Message *" FontSize="10" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding CurrentWorkflow.EmailMessage, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:HintAssist.Hint="Type message, use @ for variables..." 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="60" FontSize="11" Padding="6"/>
                        </StackPanel>
                    </Border>

                    <!-- CONDITIONAL SECTION 3: IN-APP TOAST NOTIFICATION CONFIG -->
                    <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,4"
                            Visibility="{Binding CurrentWorkflow.SendNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="In-App Toast Reminder Message *" FontSize="10" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding CurrentWorkflow.NotificationMessage, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:HintAssist.Hint="Reminder banner message (e.g. Lead @LeadName pending)..." 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="48" FontSize="11" Padding="6"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 3. Modal Bottom Bar -->
            <Button Grid.Row="2" 
                    Content="Create" 
                    Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="#F97316" BorderBrush="Transparent" Foreground="White"
                    FontWeight="Bold" FontSize="12" Height="32" Width="100" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
