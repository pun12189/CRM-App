                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" 
                    CommandParameter="Admin"
                    Style="{StaticResource MaterialDesignFlatMidBgButton}"
                    Foreground="White" >
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="ADMIN SETTINGS" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>                
            </Grid>
        </Border>-->

        <ContentControl Grid.Row="2" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
