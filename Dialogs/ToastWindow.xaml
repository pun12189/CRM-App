<Window x:Class="CallMan.Dialogs.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        Icon="/Assets/opn.png"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="Manual">
    
    <materialDesign:Card Width="350" Margin="12" Padding="16" UniformCornerRadius="8"
                         Background="White" materialDesign:ElevationAssist.Elevation="Dp3"
                         BorderBrush="#E5E7EB" BorderThickness="1" MouseDown="CardGrid_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <materialDesign:PackIcon x:Name="NotificationIcon" Kind="BellRing" Grid.Column="0" Grid.Row="0"
                                     Width="24" Height="24" Foreground="#15803D" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Margin="12,0,4,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="Payment Reminder" FontWeight="Bold" FontSize="14" Foreground="#111827"/>

                <TextBlock x:Name="TxtTimeStamp" Text="(12:30 PM)" FontSize="12" Foreground="#9CA3AF" Margin="8,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="2" Grid.Row="0" Style="{StaticResource MaterialDesignFlatButton}"
                    Width="24" Height="24" Padding="0" VerticalAlignment="Top" Click="CloseButton_Click">
                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#9CA3AF"/>
            </Button>

            <TextBlock x:Name="TxtMessage" Grid.Column="1" Grid.Row="1" Margin="12,8,4,12"
                       Text="Description content." FontSize="13" Foreground="#374151" TextWrapping="Wrap"/>

            <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Margin="12,2,0,0">
                <ComboBox x:Name="ComboSnooze" Width="120" FontSize="12" Height="28" Padding="6,4"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          SelectedValuePath="Tag" SelectedIndex="1">
                    <ComboBoxItem Content="1 minute" Tag="1"/>
                    <ComboBoxItem Content="15 minutes" Tag="15"/>
                    <ComboBoxItem Content="1 hour" Tag="60"/>
                    <ComboBoxItem Content="1 day" Tag="1440"/>
                </ComboBox>
                <Button Content="Snooze" Style="{StaticResource MaterialDesignFlatMidBgButton}"
                        FontSize="11" Height="28" Margin="8,0,0,0" Padding="12,0" Click="SnoozeButton_Click"/>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</Window>
