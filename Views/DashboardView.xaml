<UserControl x:Class="CallMan.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CallMan.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="#F5F7F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="20,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Welcome to CallMan Dashboard" FontSize="12" Foreground="#888"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <materialDesign:Chip Content="{Binding LastUpdatedStatus}" 
                         Background="#E0E6ED" Margin="10,0"/>
                <Button Command="{Binding RefreshCommand}" 
                    Background="#FF8A3D" BorderBrush="#FF8A3D"
                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}">
                    <materialDesign:PackIcon Kind="Refresh" Foreground="White"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="1" Style="{StaticResource MaterialDesignLinearProgressBar}" 
             Value="0" IsIndeterminate="True" 
             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              VerticalAlignment="Top"/>
        
        <TabControl Grid.Row="2" Style="{StaticResource MaterialDesignTabControl}" Margin="10,0">
            <TabItem Header="Analytics">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <DockPanel Margin="0,10">
                            <TextBlock Text="{Binding DataUpdatedStatus}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding OpenFilterCommand}" 
                                Content="Filter" Background="#FF8A3D" BorderBrush="#FF8A3D"
                                HorizontalAlignment="Right" Height="25" FontSize="11">
                                    <materialDesign:ButtonAssist.CornerRadius>5</materialDesign:ButtonAssist.CornerRadius>
                                </Button>
                                <Button Command="{Binding ClearFilterCommand}" 
                                Content="Clear Filter" Background="#998A3D" BorderBrush="#998A3D"
                                HorizontalAlignment="Right" Height="25" FontSize="11" Margin="5,0,0,0">
                                    <materialDesign:ButtonAssist.CornerRadius>5</materialDesign:ButtonAssist.CornerRadius>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Columns="5">
                            <Border Background="#1794A1" CornerRadius="8" Margin="5" Height="140">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stats.AllLeads}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ALL LEADS" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1794A1" CornerRadius="8" Margin="5" Height="140">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stats.NewLeads}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="OPEN" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Stats.NewLeadsPercentage, StringFormat={}({0}%)}" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1794A1" CornerRadius="8" Margin="5" Height="140">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stats.FollowupLeads}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="FOLLOW UP" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Stats.FollowupLeadsPercentage, StringFormat={}({0}%)}" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1794A1" CornerRadius="8" Margin="5" Height="140">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stats.NoFollowupLeads}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="NO FOLLOW UP" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="(Since 30 Days)" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                    <TextBlock Text="{Binding Stats.NoFollowupLeadsPercentage, StringFormat={}({0}%)}" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1794A1" CornerRadius="8" Margin="5" Height="140">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stats.Dead}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="DEAD" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Stats.DeadPercentage, StringFormat={}({0}%)}" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#21B19C" CornerRadius="8" Margin="5" Height="140">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stats.Customers}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="CUSTOMERS" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Stats.CustomersPercentage, StringFormat={}({0}%)}" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#21B19C" CornerRadius="8" Margin="5" Height="140">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stats.NoUpdation7Days}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="NO UPDATION" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="(Since 7 Days)" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Background="#21B19C" CornerRadius="8" Margin="5" Height="140">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stats.NoRepeatOrder}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="NO REPEAT ORDER" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>                            

                            <Border Background="#21B19C" CornerRadius="8" Margin="5" Height="140">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stats.NoOrder}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="NO ORDER" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="(Since 30 Days)" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <materialDesign:Card Padding="15" Margin="0,0,0,15" Background="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total Business: " FontWeight="Bold" Foreground="#666" FontSize="16"/>
                                <TextBlock Text="{Binding Stats.TotalBusiness, StringFormat='{}{0:N2}'}" 
                       Foreground="#1794A1" FontWeight="Bold" FontSize="16" Margin="5,0,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <Expander Header="Reminders" Background="White" BorderThickness="0,0,0,1" BorderBrush="#EEE" IsExpanded="True">
                            <ItemsControl ItemsSource="{Binding Reminders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,5" BorderBrush="#F5F5F5" BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" Foreground="#333"/>
                                                <TextBlock Text="{Binding PendingBalance, StringFormat='₹{0:N0}'}" 
                                       HorizontalAlignment="Right" Foreground="Red" FontWeight="Bold"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander Header="Followup Stages" Background="White" BorderThickness="0,0,0,1" BorderBrush="#EEE"/>
                        <Expander Header="Mature Stages" Background="White" BorderThickness="0,0,0,1" BorderBrush="#EEE"/>
                        <Expander Header="Lead Labels" Background="White" BorderThickness="0,0,0,1" BorderBrush="#EEE"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="MIS" />
            <!--<TabItem Header="Virtual Board" />
            <TabItem Header="Attendance" />-->
            <TabItem Header="Reports" />
        </TabControl>
    </Grid>
</UserControl>
