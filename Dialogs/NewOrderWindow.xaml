<Window x:Class="CallMan.Dialogs.NewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        mc:Ignorable="d"
        Icon="/Assets/opn.png"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Create New Order" Height="400" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="NEW ORDER ENTRY" FontSize="18" FontWeight="Bold" 
                       Foreground="#1794A1" Margin="0,0,0,20"/>

            <TextBlock Text="Total Order Value *" Foreground="Red" FontSize="12" Margin="0,5"/>
            <TextBox Text="{Binding TotalAmount, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Enter Total Amount"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Order Description" Foreground="#555" Margin="0,5"/>
            <TextBox Text="{Binding Description}" 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="e.g. 20 Units of Stryder MTB"
                     Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                     Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" IsCancel="True" 
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                <Button Content="SAVE ORDER" Command="{Binding SaveOrderCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#2E7D32" BorderBrush="#2E7D32"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
