<UserControl x:Class="Tijori.Views.MasterFormulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F8FAFC">
    <UserControl.Resources>
        <materialDesign:BooleanToVisibilityConverter x:Key="InvertedBoolToVisConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>

        <!-- ============================================================= -->
        <!-- VIEW 1: MASTER FORMULATION DIRECTORY / REGISTRY TABLE        -->
        <!-- ============================================================= -->
        <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource InvertedBoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Top Bar: Title, Search & Create Action -->
                <RowDefinition Height="*"/>
                <!-- Formulations DataGrid -->
            </Grid.RowDefinitions>

            <!-- TOP TOOLBAR -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12" Margin="0,0,0,14">
                <DockPanel LastChildFill="False">

                    <!-- Left: Header & Total Count Badge -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FlaskRoundBottomOutline" Width="24" Height="24" Foreground="#1794A1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Master Formulation" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <Border Background="#E0F2FE" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalFormulationsCount, StringFormat='{}{0} Recipes'}" FontSize="10.5" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Standardized Bill of Materials (BOM) for batch production" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Search Box + Create Button -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- 🔍 LIVE SEARCH BOX -->
                        <Border Background="#F1F5F9" CornerRadius="6" Width="260" Height="38" Padding="8,0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Grid.Column="0" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="Search by recipe or product..."
                                         BorderThickness="0" 
                                         Background="Transparent" 
                                         VerticalAlignment="Center" 
                                         FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- + CREATE NEW FORMULATION BUTTON -->
                        <Button Command="{Binding OpenNewFormulationCommand}" 
                                Background="#1794A1" 
                                BorderBrush="#1794A1" 
                                Foreground="White" 
                                FontWeight="SemiBold" 
                                Height="38" 
                                Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="CREATE FORMULATION" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- DIRECTORY DATA TABLE -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <DataGrid ItemsSource="{Binding FilteredFormulations}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True"
                          RowHeight="44" 
                          GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#F1F5F9" 
                          Style="{StaticResource MaterialDesignDataGrid}">

                    <DataGrid.Columns>

                        <!-- Formulation Recipe Name -->
                        <DataGridTemplateColumn Header="Formulation Name" Width="2.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#F0FDFA" CornerRadius="4" Padding="5" Margin="0,0,10,0">
                                            <materialDesign:PackIcon Kind="FlaskOutline" Width="14" Height="14" Foreground="#1794A1"/>
                                        </Border>
                                        <TextBlock Text="{Binding FormulationName}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Finished Good Association -->
                        <DataGridTemplateColumn Header="Target Finished Good" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FinishedProductName, FallbackValue='— Generic Base Recipe —'}" 
                                               FontSize="12" Foreground="#334155" FontWeight="Medium" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Standard Batch Size -->
                        <DataGridTemplateColumn Header="Std Batch Capacity" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#475569">
                                            <Run Text="{Binding StandardBatchSize, StringFormat='{}{0:N0}'}"/>
                                            <Run Text=" "/><Run Text="{Binding StandardBatchUnit}"/>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="ACTIVE" FontSize="9.5" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Action Buttons (Edit / Delete) -->
                        <DataGridTemplateColumn Header="Operations" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <!-- Edit Recipe -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                Command="{Binding DataContext.EditFormulationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" 
                                                ToolTip="Edit Formulation Recipe"
                                                Width="28" Height="28" Padding="0" Margin="0,0,6,0">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" Foreground="#D97706"/>
                                        </Button>

                                        <!-- Delete Recipe -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                Command="{Binding DataContext.DeleteFormulationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" 
                                                ToolTip="Delete Formulation"
                                                Width="28" Height="28" Padding="0">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="#EF4444"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- VIEW 2: FORMULATION RECIPE EDITOR (Shown when IsFormOpen = T) -->
        <!-- ============================================================= -->
        <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header & Back Button -->
                <RowDefinition Height="Auto"/>
                <!-- Metadata Card -->
                <RowDefinition Height="Auto"/>
                <!-- Raw Material Selector Bar -->
                <RowDefinition Height="*"/>
                <!-- Ingredients Table -->
                <RowDefinition Height="Auto"/>
                <!-- Footer: Water/QS Balance & Save -->
            </Grid.RowDefinitions>

            <!-- 1. BACK / HEADER BAR -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                Command="{Binding CloseFormCommand}" 
                                ToolTip="Back to Registry" 
                                Width="30" Height="30" Padding="0" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="#475569"/>
                        </Button>
                        <TextBlock Text="{Binding FormTitle}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. FORMULATION METADATA -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Target Finished Good (Optional):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding FinishedProductsList}" 
                                  SelectedValue="{Binding CurrentFormulation.FinishedProductId, Mode=TwoWay}" 
                                  SelectedValuePath="ProductId" Padding="10,0"
                                  DisplayMemberPath="Name"
                                  materialDesign:TextFieldAssist.HasClearButton="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Recipe / Formulation Name:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CurrentFormulation.FormulationName, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="38" Padding="10,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Std Batch (Ltr/Kg):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CurrentFormulation.StandardBatchSize, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="38" Padding="10,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. INGREDIENT SELECTOR BAR -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Text="{Binding NewIngredientPhase}" Padding="10,0" IsEditable="True" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38" Margin="0,0,8,0">
                        <ComboBoxItem Content="Phase A"/>
                        <ComboBoxItem Content="Phase B"/>
                        <ComboBoxItem Content="Phase C"/>
                        <ComboBoxItem Content="Phase D"/>
                    </ComboBox>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding RawMaterialsList}" Padding="10,0" SelectedItem="{Binding SelectedRawMaterialToAdd}" DisplayMemberPath="Name" IsEditable="True"
                              materialDesign:HintAssist.Hint="Search Raw Material / Chemical..." Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="38" Margin="0,0,8,0"/>

                    <TextBox Grid.Column="2" Padding="10,0" Text="{Binding NewIngredientPercentage, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" 
                             materialDesign:HintAssist.Hint="Qty (%)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="38" Margin="0,0,10,0"/>

                    <Button Grid.Column="3" Command="{Binding AddIngredientRowCommand}" Content="+ ADD INGREDIENT" Background="#1794A1" BorderBrush="#1794A1" Foreground="White" Height="38" Padding="14,0"/>
                </Grid>
            </Border>

            <!-- 4. INGREDIENT ITEMS GRID -->
            <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <DataGrid ItemsSource="{Binding CurrentFormulation.Items}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="38" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Phase" Binding="{Binding Phase, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridTextColumn Header="Raw Material Name" Binding="{Binding RawMaterialName}" Width="2.5*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="Quantity (%)" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding PercentageValue, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Remarks / Mixing Instructions" Binding="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="24" Height="24" Padding="0" Command="{Binding DataContext.RemoveIngredientRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#EF4444"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 5. BALANCE FOOTER & SAVE -->
            <Border Grid.Row="4" Background="#F1F5F9" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="CANCEL" Command="{Binding CloseFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="36" Margin="0,0,8,0"/>
                        <Button Content="{Binding SaveButtonText}" Command="{Binding SaveFormulationCommand}" Background="#1794A1" BorderBrush="#1794A1" Foreground="White" FontWeight="Bold" Height="36" Padding="18,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Total Active Ingredients: " Foreground="#64748B" FontSize="12"/>
                        <TextBlock Text="{Binding CurrentFormulation.TotalIngredientsPercentage, StringFormat='{}{0:N2}%'}" FontWeight="Bold" Foreground="#0F172A" FontSize="12.5" Margin="0,0,20,0"/>

                        <Border Background="#E0F2FE" CornerRadius="4" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="WaterPercent" Foreground="#0284C7" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Water (Aqua / QS): " Foreground="#0369A1" FontSize="11.5" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentFormulation.WaterPercentage, StringFormat='{}{0:N2}%'}" FontWeight="Black" Foreground="#0369A1" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
