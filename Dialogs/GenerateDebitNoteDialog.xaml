<Window x:Class="Tijori.Dialogs.GenerateDebitNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tijori.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Generate Purchase Return (Debit Note)" Height="520" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Window.Resources>
        <materialDesign:BooleanToVisibilityConverter TrueValue="Collapsed" FalseValue="Visible" x:Key="InverseBoolConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Issue Vendor Debit Note" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>

        <!-- Metadata -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12" Margin="0,10,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Debit Note #" FontSize="11" Foreground="#64748B"/>
                    <TextBox Text="{Binding DebitNoteNo}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Text="Vendor" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding VendorName}" FontWeight="Bold" Foreground="#0052CC"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Reason" FontSize="11" Foreground="#64748B"/>
                    <TextBox Text="{Binding Reason}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Items Grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding ReturnLines}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" Background="White" BorderBrush="#E2E8F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="110"/>
                <DataGridTextColumn Header="Billed Qty" Binding="{Binding MaxAvailableQty}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="Return Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="Unit Rate" Binding="{Binding UnitPrice, StringFormat=N2}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Total Refund" Binding="{Binding TotalAmount, StringFormat=N2}" Width="100" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Summary & Status -->
        <DockPanel Grid.Row="3" Margin="0,10,0,10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#DC2626" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <TextBlock Text="Total Debit Value: " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CalculatedTotal, StringFormat='₹ {0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#D97706"/>
            </StackPanel>
        </DockPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Height="32" Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
            <Button Content="Post Debit Note" Width="130" Height="32" Background="#DC2626" Foreground="White" 
                    FontWeight="Bold" Command="{Binding SaveDebitNoteCommand}" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"/>
        </StackPanel>
    </Grid>
</Window>
