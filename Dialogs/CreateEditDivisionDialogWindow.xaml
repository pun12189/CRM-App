<Window x:Class="Tijori.Dialogs.CreateEditDivisionDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tijori.Dialogs"
        xmlns:conv="clr-namespace:Tijori.Converters"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Division Profile" Width="720" MaxHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:BoolToEditTitleConverter x:Key="BoolToEditTitleConverter"/>
    </Window.Resources>
    <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title Header -->
                <RowDefinition Height="*"/>
                <!-- Scrollable Form Body -->
                <RowDefinition Height="Auto"/>
                <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{Binding IsEditMode, Converter={StaticResource BoolToEditTitleConverter}, FallbackValue='Create / Edit Division'}" 
                           FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignIconButton}" 
                        Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="24" Height="24">
                    <materialDesign:PackIcon Kind="CloseCircleOutline" Foreground="#64748B" Width="18" Height="18"/>
                </Button>
            </Grid>

            <!-- 2. Scrollable Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <!-- Logo & Stamp Column -->
                        <ColumnDefinition Width="*"/>
                        <!-- Fields Column -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo & Stamp Cards -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <!-- Logo Upload -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Company Logo" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <Border Width="80" Height="80" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6">
                                    <Grid>
                                        <Image Source="{Binding CurrentProfile.LogoImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <materialDesign:PackIcon Kind="ImagePlus" Width="24" Height="24" Foreground="#94A3B8" 
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Visibility="{Binding CurrentProfile.LogoImage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                                <Button Content="Upload Logo" Command="{Binding SelectLogoCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="10" Height="24" Padding="8,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Stamp Upload -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Stamp / Signature" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <Border Width="80" Height="80" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6">
                                    <Grid>
                                        <Image Source="{Binding CurrentProfile.StampImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <materialDesign:PackIcon Kind="ImagePlus" Width="24" Height="24" Foreground="#94A3B8" 
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Visibility="{Binding CurrentProfile.StampImage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                                <Button Content="Upload Stamp" Command="{Binding SelectStampCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="10" Height="24" Padding="8,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Form Fields -->
                    <StackPanel Grid.Column="1">
                        <!-- Division Name Header -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Division Name *" FontSize="10" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding DivisionName, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="e.g. LeadManch, SofricONE"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="11" Height="32" Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Invoice Prefix" FontSize="10" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CurrentProfile.CompanyInitials, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="e.g. LM, SOF"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="11" Height="32" Padding="6,4"/>
                            </StackPanel>
                        </Grid>

                        <!-- Legal Profile -->
                        <TextBlock Text="Legal &amp; Registration" FontSize="11" FontWeight="Bold" Foreground="#0D9488" Margin="0,4,0,4"/>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <StackPanel Margin="0,0,4,0">
                                <TextBox Text="{Binding CurrentProfile.CompanyName, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="Trade / Legal Name"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="11" Height="32" Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <TextBox Text="{Binding CurrentProfile.ProprietorName, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="Proprietor / Signatory"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="11" Height="32" Padding="6,4"/>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,4,0">
                                <TextBox Text="{Binding CurrentProfile.GstNumber, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="GST Number"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="11" Height="32" Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <TextBox Text="{Binding CurrentProfile.PanNumber, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="PAN Number"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="11" Height="32" Padding="6,4"/>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,4,0">
                                <TextBox Text="{Binding CurrentProfile.OfficialEmail, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:HintAssist.Hint="Official Email Address"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="11" Height="32" Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <TextBox Text="{Binding CurrentProfile.ContactNumber, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:HintAssist.Hint="Primary Contact Number"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="11" Height="32" Padding="6,4"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Banking & Financials -->
                        <TextBlock Text="Banking &amp; Settlements" FontSize="11" FontWeight="Bold" Foreground="#0D9488" Margin="0,4,0,4"/>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <StackPanel Margin="0,0,4,0">
                                <TextBox Text="{Binding CurrentProfile.BankName, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="Bank Name"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="11" Height="32" Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <TextBox Text="{Binding CurrentProfile.AccountNumber, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="Account Number"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="11" Height="32" Padding="6,4"/>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,4,0">
                                <TextBox Text="{Binding CurrentProfile.IfscCode, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="IFSC Code"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="11" Height="32" Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <TextBox Text="{Binding CurrentProfile.UpiId, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="UPI ID"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="11" Height="32" Padding="6,4"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Address & Terms -->
                        <TextBlock Text="Address &amp; Invoice Terms" FontSize="11" FontWeight="Bold" Foreground="#0D9488" Margin="0,4,0,4"/>
                        <TextBox Text="{Binding CurrentProfile.RegisteredAddress, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Registered Office Address"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontSize="11" Height="44" Padding="6,4" Margin="0,0,0,6"/>

                        <TextBox Text="{Binding CurrentProfile.TermsAndConditions, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Terms &amp; Conditions (Printed on PDF footer)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontSize="11" Height="44" Padding="6,4"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 3. Footer Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" FontSize="11" Margin="0,0,8,0" Padding="12,0"/>
                <Button Content="Save Division" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="#0D9488" BorderBrush="Transparent" Foreground="White"
                        FontWeight="SemiBold" FontSize="11" Height="28" Padding="14,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
