<Application x:Class="CallMan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnExplicitShutdown"
             xmlns:local="clr-namespace:CallMan">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="SettingTileStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Background" Value="#2CB3A5"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Height" Value="100"/>
                <Setter Property="Margin" Value="10"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#24968B"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SidebarLinkStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Foreground" Value="#444"/>
                <Setter Property="Padding" Value="15,10"/>
                <Setter Property="Height" Value="NaN"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#EEE"/>
            </Style>

            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="Background" Value="#e0e0ea" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <ContentControl x:Key="InformationIcon">
                <materialDesign:PackIcon Kind="Information" Foreground="#1794A1" Width="24" Height="24" VerticalAlignment="Center"/>
            </ContentControl>

            <ContentControl x:Key="SuccessIcon">
                <materialDesign:PackIcon Kind="CheckCircle" Foreground="#16A34A" Width="24" Height="24" VerticalAlignment="Center"/>
            </ContentControl>

            <ContentControl x:Key="WarningIcon">
                <materialDesign:PackIcon Kind="Alert" Foreground="#D97706" Width="24" Height="24" VerticalAlignment="Center"/>
            </ContentControl>

            <ContentControl x:Key="ErrorIcon">
                <materialDesign:PackIcon Kind="CloseCircle" Foreground="#DC2626" Width="24" Height="24" VerticalAlignment="Center"/>
            </ContentControl>           

            <Style x:Key="NotificationText" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody1TextBlock}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Foreground" Value="#374151"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10,2,5,2"/>
            </Style>

            <Style x:Key="NotificationTitle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignSubtitle1TextBlock}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#111827"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="10,2,5,0"/>
            </Style>

            <Style x:Key="NotificationCloseButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="5,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Content">
                    <Setter.Value>
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#9CA3AF"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NotificationWindow" TargetType="Window">
                <Setter Property="AllowsTransparency" Value="True"/>
                <Setter Property="WindowStyle" Value="None"/>
                <Setter Property="ShowInTaskbar" Value="False"/>
                <Setter Property="Topmost" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Window">
                            <materialDesign:Card Background="White" UniformCornerRadius="6" Margin="8" Padding="12" 
                                                 materialDesign:ElevationAssist.Elevation="Dp4" BorderBrush="#E5E7EB" BorderThickness="1">
                                <ContentPresenter />
                            </materialDesign:Card>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
