<UserControl x:Class="Tijori.Views.BatchTrackerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Tijori.Converters"
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F8FAFC">
    <UserControl.Resources>
        <materialDesign:BooleanToVisibilityConverter x:Key="InvertedBoolToVisConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <materialDesign:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
        <conv:StringMatchToVisConverter x:Key="StringMatchToVisConverter" />
        <conv:InvertedStringMatchToVisConverter x:Key="InvertedStringMatchToVisConverter" />
    </UserControl.Resources>
    <Grid Margin="16">

        <!-- ========================================================================= -->
        <!-- VIEW 1: BATCH DIRECTORY / STAGE TRACKER (IsBatchWorkspaceOpen == False)   -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding IsBatchWorkspaceOpen, Converter={StaticResource InvertedBoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header & Stage Filter Chips -->
                <RowDefinition Height="*"/>
                <!-- Batches DataGrid -->
            </Grid.RowDefinitions>

            <!-- 1. TOOLBAR & STAGE CHIPS -->
            <Border Grid.Row="0" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                <DockPanel LastChildFill="False">

                    <!-- Title & Batch Count -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ProgressWrench" Width="26" Height="26" Foreground="#1794A1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Batch Production Tracker" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <Border Background="#E0F2FE" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalBatchesCount, StringFormat='{}{0} Batches'}" FontSize="10.5" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Real-time shop-floor execution, phase mixing &amp; stage sign-offs" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>

                        <!-- STAGE FILTER RADIO BUTTONS / CHIPS -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="All" IsChecked="{Binding SelectedStageFilter, Converter={StaticResource StringMatchToVisConverter}, ConverterParameter='All'}" 
                                         GroupName="StageFilters" Style="{StaticResource MaterialDesignTabRadioButton}" Height="32" Margin="0,0,4,0"/>
                            <RadioButton Content="Dispensing" IsChecked="{Binding SelectedStageFilter, Converter={StaticResource StringMatchToVisConverter}, ConverterParameter='Dispensing'}" 
                                         GroupName="StageFilters" Style="{StaticResource MaterialDesignTabRadioButton}" Height="32" Margin="0,0,4,0"/>
                            <RadioButton Content="Mixing" IsChecked="{Binding SelectedStageFilter, Converter={StaticResource StringMatchToVisConverter}, ConverterParameter='Mixing'}" 
                                         GroupName="StageFilters" Style="{StaticResource MaterialDesignTabRadioButton}" Height="32" Margin="0,0,4,0"/>
                            <RadioButton Content="Filling" IsChecked="{Binding SelectedStageFilter, Converter={StaticResource StringMatchToVisConverter}, ConverterParameter='Filling'}" 
                                         GroupName="StageFilters" Style="{StaticResource MaterialDesignTabRadioButton}" Height="32" Margin="0,0,4,0"/>
                            <RadioButton Content="Packing" IsChecked="{Binding SelectedStageFilter, Converter={StaticResource StringMatchToVisConverter}, ConverterParameter='Packing'}" 
                                         GroupName="StageFilters" Style="{StaticResource MaterialDesignTabRadioButton}" Height="32" Margin="0,0,4,0"/>
                            <RadioButton Content="QC" IsChecked="{Binding SelectedStageFilter, Converter={StaticResource StringMatchToVisConverter}, ConverterParameter='QC'}" 
                                         GroupName="StageFilters" Style="{StaticResource MaterialDesignTabRadioButton}" Height="32" Margin="0,0,4,0"/>
                            <RadioButton Content="Completed" IsChecked="{Binding SelectedStageFilter, Converter={StaticResource StringMatchToVisConverter}, ConverterParameter='Completed'}" 
                                         GroupName="StageFilters" Style="{StaticResource MaterialDesignTabRadioButton}" Height="32"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Search Box -->
                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="6" Width="240" Height="36" Padding="8,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Grid.Column="0" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:HintAssist.Hint="Search Batch #, Brand, Client..." BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="11.5"/>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 2. BATCHES DIRECTORY TABLE -->
            <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                <DataGrid ItemsSource="{Binding FilteredBatches}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="44" Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>

                        <!-- Batch Code -->
                        <DataGridTemplateColumn Header="Batch Number" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#F0FDFA" CornerRadius="4" Padding="5" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="Barcode" Width="15" Height="15" Foreground="#1794A1"/>
                                        </Border>
                                        <TextBlock Text="{Binding BatchNumber}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Brand & Customer -->
                        <DataGridTemplateColumn Header="Brand &amp; Customer" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BrandName}" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding CustomerName}" FontSize="10.5" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Target Batch Volume -->
                        <DataGridTemplateColumn Header="Batch Target" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#334155">
                                            <Run Text="{Binding BatchSize, StringFormat='{}{0:N0}'}"/>
                                            <Run Text=" Units"/>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Current Active Stage Badge -->
                        <DataGridTemplateColumn Header="Current Stage" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FEF3C7" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CogSyncOutline" Width="13" Height="13" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding CurrentStage}" FontSize="10.5" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Mfg / Expiry Dates -->
                        <DataGridTextColumn Header="Mfg Date" Binding="{Binding MfgDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="110"/>
                        <DataGridTextColumn Header="Exp Date" Binding="{Binding ExpiryDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="110"/>

                        <!-- Action: Open Execution Workspace -->
                        <DataGridTemplateColumn Header="Action" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                                            Command="{Binding DataContext.OpenBatchWorkspaceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Height="28" Padding="8,0" FontSize="11">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="PlayOutline" Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="EXECUTE" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- VIEW 2: BATCH EXECUTION & BMR WORKSPACE (IsBatchWorkspaceOpen == True)    -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding IsBatchWorkspaceOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header Banner & Batch Info -->
                <RowDefinition Height="Auto"/>
                <!-- Stage Progression Track -->
                <RowDefinition Height="*"/>
                <!-- Snapshot BOM DataGrid Table -->
                <RowDefinition Height="Auto"/>
                <!-- Stage Sign-off Footer -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER BANNER -->
            <Border Grid.Row="0" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding CloseBatchWorkspaceCommand}" Width="28" Height="28" Padding="0" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="#475569"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ActiveBatch.BatchNumber}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveBatch.BrandName}" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveBatch.ProductionNotes}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Client: " FontSize="10" Foreground="#64748B"/>
                            <TextBlock Text="{Binding ActiveBatch.CustomerName}" FontSize="12" FontWeight="Bold" Foreground="#334155"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Target Batch Size:" FontSize="10" Foreground="#64748B"/>
                            <TextBlock Text="{Binding ActiveBatch.BatchSize, StringFormat='{}{0:N0} Units'}" FontSize="12" FontWeight="Bold" Foreground="#1794A1"/>
                        </StackPanel>

                        <!-- 🖨️ PRINT BMR BUTTON -->
                        <Button Command="{Binding PrintBmrDocumentCommand}" 
                                Background="#0284C7" BorderBrush="#0284C7" Foreground="White" 
                                FontWeight="SemiBold" Height="32" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PrinterOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PRINT BMR" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. STAGE PROGRESSION TIMELINE / CHECKPOINTS -->
            <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding ActiveBatch.Stages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="4,0">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{Binding SequenceOrder, StringFormat='{}Stage {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="5,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="9.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding StageName}" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 3. SNAPSHOT BILL OF MATERIALS (BOM) DATA TABLE -->
            <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Formula Snapshot &amp; Required Raw Material Batch Quantities" FontSize="12" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Active Ingredients: " FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalActiveBOMPercentage, StringFormat='{}{0:N2}%'}" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,16,0"/>
                            <TextBlock Text="Total Batch Weight: " FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalBatchWeightKg, StringFormat='{}{0:N3} Kg'}" FontSize="11.5" FontWeight="Bold" Foreground="#0284C7"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveBatchBOM}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="32" Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" FontWeight="SemiBold" Width="90"/>
                            <DataGridTextColumn Header="Raw Material Name" Binding="{Binding RawMaterialName}" Width="2.5*"/>
                            <DataGridTextColumn Header="Ratio (%)" Binding="{Binding PercentageValue, StringFormat='{}{0:N2}%'}" FontWeight="Bold" Width="100"/>
                            <DataGridTextColumn Header="Target Dispense Qty" Binding="{Binding CalculatedQuantity, StringFormat='{}{0:N3} Kg'}" FontWeight="Bold" Foreground="#0284C7" Width="150"/>
                            <DataGridTextColumn Header="Instructions / Remarks" Binding="{Binding Remarks}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 4. STAGE SIGN-OFF & ADVANCE FOOTER -->
            <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                <DockPanel LastChildFill="True">

                    <!-- Advance Action Button -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="PRINT BMR SHEET" Command="{Binding PrintBmrDocumentCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Margin="0,0,8,0"/>
                        <Button Content="BACK TO BATCHES" Command="{Binding CloseBatchWorkspaceCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Margin="0,0,8,0"/>
                        <Button Content="COMPLETE STAGE &amp; ADVANCE ➔" Command="{Binding AdvanceCurrentStageCommand}" 
                            Background="#1794A1" BorderBrush="#1794A1" Foreground="White" FontWeight="Bold" Height="34" Padding="18,0"/>
                    </StackPanel>

                    <!-- Active Stage Operator Sign-Off Input -->
                    <Grid VerticalAlignment="Center" Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Active Stage:" FontSize="10" Foreground="#64748B"/>
                            <TextBlock Text="{Binding CurrentActiveStage.StageName, FallbackValue='None'}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding StageRemarksEntry, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Enter operator remarks, readings, or test notes..." Padding="10,0"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="34" FontSize="11.5"/>
                    </Grid>

                </DockPanel>
            </Border>

        </Grid>

    </Grid>
</UserControl>
