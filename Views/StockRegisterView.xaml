<UserControl x:Class="Tijori.Views.StockRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:Tijori.Converters"
             xmlns:model="clr-namespace:Tijori.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <model:BindingProxy x:Key="DataContextProxy" Data="{Binding}"/>
        <conv:InwardToVisibilityConverter x:Key="InwardToVisibilityConverter"/>
        <conv:OutwardToVisibilityConverter x:Key="OutwardToVisibilityConverter"/>
    </UserControl.Resources>
    <materialDesign:DialogHost Identifier="StockRegisterDialogHost" DialogTheme="Inherit">

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Top Bar Card -->
                <RowDefinition Height="Auto"/>
                <!-- Item Header Banner -->
                <RowDefinition Height="*"/>
                <!-- Stock Data Grid -->
                <RowDefinition Height="Auto"/>
                <!-- Summary Footer (Received/Issued) -->
            </Grid.RowDefinitions>

            <!-- 1. TOP HEADER BAR -->
            <materialDesign:Card Grid.Row="0" UniformCornerRadius="6" Padding="14,10" Margin="0,0,0,12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                <DockPanel LastChildFill="True">

                    <!-- RIGHT ACTION BUTTONS: Clear Filter + Filter -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">

                        <!-- CLEAR FILTER BUTTON (Visible ONLY when IsFilterActive is true) -->
                        <Button Command="{Binding ClearFiltersCommand}"
                                Visibility="{Binding IsFilterActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="#DC2626"
                                Height="36" Padding="10,0" Margin="0,0,8,0"
                                ToolTip="Reset all active filters">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterOff" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Clear Filter" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- FILTER BUTTON -->
                        <Button Command="{Binding OpenFilterDialogCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" 
                                BorderBrush="#64748B" Foreground="#334155"
                                Height="36" Padding="12,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterVariant" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Filter" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenExportDialogCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="#10B981" BorderBrush="#10B981" Foreground="White"
                                Height="36" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ExportVariant" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Export" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        
                    </StackPanel>

                    <!-- LEFT TITLE TEXT -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClipboardList" Foreground="#2563EB" Width="22" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding HeaderTitleText}" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </materialDesign:Card>

            <!-- 2. MARG-STYLE ITEM HEADLINE & OPENING BALANCE BANNER -->
            <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,8" Margin="0,0,0,8" CornerRadius="4">
                <DockPanel>
                    <TextBlock Text="{Binding SelectedItemDisplayName, FallbackValue='Select an Item from Filter to view report'}" 
                               FontSize="14" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="Opening Balance: " FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBlock Text="{Binding OpeningBalanceQty, StringFormat=\{0:N0\} PCS}" FontSize="13" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 3. MARG STOCK REGISTER DATAGRID -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding StockRegisterRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="36">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <!-- Sale / Outward Row Style: Light Green -->
                            <DataTrigger Binding="{Binding MovementType}" Value="Outward">
                                <Setter Property="Background" Value="#FFF1F2"/>
                            </DataTrigger>
                            <!-- Purchase / Inward (Stock In): Soft Green tint -->
                            <DataTrigger Binding="{Binding MovementType}" Value="Inward">
                                <Setter Property="Background" Value="#F0FDF4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bill No." Binding="{Binding BillNo}" Width="Auto"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat=\{0:dd-MM-yyyy\}}" Width="120"/>
                    <DataGridTemplateColumn Header="Type" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Up Arrow for Purchase (Blue) -->
                                    <materialDesign:PackIcon Kind="ArrowUpBold" Width="14" Height="14" Foreground="#059669" 
                                                 VerticalAlignment="Center" Margin="0,0,4,0"
                                                 Visibility="{Binding MovementType, Converter={StaticResource InwardToVisibilityConverter}}"/>

                                    <!-- Down Arrow + Red Text for Sale (Stock Issue) -->
                                    <materialDesign:PackIcon Kind="ArrowDownBold" Width="14" Height="14" Foreground="#DC2626" 
                                                 VerticalAlignment="Center" Margin="0,0,4,0"
                                                 Visibility="{Binding MovementType, Converter={StaticResource OutwardToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding VoucherType}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Batch Number" Binding="{Binding BatchNumber}" Width="Auto"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=\{0:N0\}}" Width="90"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=\{0:N2\}}" Width="110"/>
                    <DataGridTextColumn Header="Balance Quantity" Binding="{Binding BalanceQuantity, StringFormat=\{0:N0\}}" Width="Auto" FontWeight="Bold"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 4. BOTTOM MARG SUMMARY FOOTER (RECEIVED / ISSUED) -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" Padding="14,10">
                <Grid HorizontalAlignment="Right" Width="440">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <!-- Received Row (Green) -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,12,3">
                        <materialDesign:PackIcon Kind="ArrowUpBold" Foreground="#059669" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Purchase :" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalReceivedQty, StringFormat={}{0:N0}}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,3,12,3" Foreground="#0F172A"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TotalReceivedValue, StringFormat={}{0:₹ #.##0.00}}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,3,0,3" Foreground="#0F172A"/>

                    <!-- Issued Row (Red) -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,12,3">
                        <materialDesign:PackIcon Kind="ArrowDownBold" Foreground="#DC2626" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Sale :" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalIssuedQty, StringFormat={}{0:N0}}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,3,12,3" Foreground="#0F172A"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TotalIssuedValue, StringFormat={}{0:₹ #.##0.00}}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,3,0,3" Foreground="#0F172A"/>
                </Grid>
            </Border>

        </Grid>
    </materialDesign:DialogHost>
</UserControl>
