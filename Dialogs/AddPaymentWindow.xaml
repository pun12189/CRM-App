<Window x:Class="CallMan.Dialogs.AddPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Receive Payment" Height="450" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="RECEIVE PAYMENT" FontSize="18" FontWeight="Bold" 
                       Foreground="#27AE60" Margin="0,0,0,10"/>

            <Border Background="#F9F9F9" Padding="10" CornerRadius="4" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Order Details:" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="{Binding SelectedOrder.Description}" Opacity="0.7"/>
                    <TextBlock Text="{Binding SelectedOrder.TotalAmount, StringFormat='Total: ₹ {0:N2}'}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Amount Received *" Foreground="Red" FontSize="12" Margin="0,5"/>
            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Enter Payment Amount"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Payment Method" Foreground="#555" Margin="0,5"/>
            <ComboBox ItemsSource="{Binding Methods}" 
                      SelectedItem="{Binding Method}"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" IsCancel="True" 
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                <Button Content="SUBMIT PAYMENT" Command="{Binding SubmitPaymentCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#27AE60" BorderBrush="#27AE60"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
