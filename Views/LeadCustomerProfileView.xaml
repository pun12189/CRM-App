<UserControl x:Class="CallMan.Views.LeadCustomerProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CallMan.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1024">
    <UserControl.Resources>
        <materialDesign:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter"/>
        <materialDesign:NullableToVisibilityConverter x:Key="InverseNullToVisibilityConverter" NullValue="Visible" NotNullValue="Collapsed"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel LastChildFill="True">

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#059669" BorderBrush="Transparent" 
                        ToolTip="Send WhatsApp" Command="{Binding DataContext.WhatsappCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding ActiveProfileLead}" Height="36" Width="36" Padding="0" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="Whatsapp" Foreground="White" Width="20" Height="20" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Send Mail Button - Solid Filled Style -->
                    <Button Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#059669" BorderBrush="Transparent" 
                        ToolTip="Send Mail" Height="36" Width="36" Padding="0" >
                        <materialDesign:PackIcon Kind="Email" Foreground="White" Width="20" Height="20" HorizontalAlignment="Center"/>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignFlatButton}" Padding="4" MinWidth="32" Height="32" Margin="8,0,0,0">
                        <materialDesign:PackIcon Kind="DotsVertical" Foreground="#9CA3AF" Width="20" Height="20"/>
                    </Button>
                </StackPanel>

                <Button Command="{Binding HideLeadWorkspaceCommand}" Style="{StaticResource MaterialDesignFlatButton}" DockPanel.Dock="Left" Padding="4" MinWidth="32" Height="32" VerticalAlignment="Center" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="ArrowLeft" Foreground="#4B5563" Width="22" Height="22"/>
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="46" Height="46" Margin="0,0,14,0">
                        <Ellipse Fill="#DBEAFE"/>
                        <TextBlock Text="{Binding ActiveProfileLead.Initials, TargetNullValue='TW'}" Foreground="#1E40AF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ActiveProfileLead.CustomerName}" FontSize="18" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>

                            <!--<Border Background="#F3F4F6" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" Height="20" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Close" Foreground="#9CA3AF" Width="12" Height="12"/>
                            </Border>
                            <Border Background="#F3F4F6" CornerRadius="4" Padding="6,2" Margin="4,0,0,0" Height="20" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="NotebookOutline" Foreground="#9CA3AF" Width="12" Height="12"/>
                            </Border>-->
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding ActiveProfileLead.CompanyName, TargetNullValue='No Associated Company'}" FontSize="13" Foreground="#2563EB" FontWeight="Medium"/>
                            <materialDesign:PackIcon Kind="Crown" Foreground="#F59E0B" Width="14" Height="14" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <TextBlock Text="{Binding ActiveProfileLead.LeadHolder, TargetNullValue='Unassigned Lead Holder'}" FontSize="12" Foreground="#4B5563" Margin="4,0,0,0" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!--<ColumnDefinition Width="Auto"/>-->

                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Visibility="Collapsed" x:Name="LeftInfoSidebar" Width="310" Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="20,15,15,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, ElementName=InfoTab}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, ElementName=InfoTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Basic Info" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,8,0,8"/>
                        <StackPanel Margin="2,0,0,16">
                            <DockPanel Margin="0,6">
                                <materialDesign:PackIcon Kind="EmailOutline" Foreground="#9CA3AF" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveProfileLead.Email, TargetNullValue='--'}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#111827" FontSize="13"/>
                            </DockPanel>
                            <DockPanel Margin="0,6">
                                <materialDesign:PackIcon Kind="PhoneOutline" Foreground="#9CA3AF" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveProfileLead.Phone, TargetNullValue='--'}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#111827" FontSize="13"/>
                            </DockPanel>
                            <DockPanel Margin="0,6">
                                <materialDesign:PackIcon Kind="PhoneInTalkOutline" Foreground="#9CA3AF" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveProfileLead.AltPhone, TargetNullValue='--'}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="13"/>
                            </DockPanel>
                            <DockPanel Margin="0,6">
                                <materialDesign:PackIcon Kind="MapMarkerOutline" Foreground="#9CA3AF" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <StackPanel x:Name="Map" Orientation="Vertical" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ActiveProfileLead.AddressLine}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ActiveProfileLead.City, StringFormat='{}{0}\, '}" FontSize="12" Margin="0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ActiveProfileLead.District, StringFormat='{}{0}\, '}" FontSize="12" Margin="0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ActiveProfileLead.State, StringFormat='{}{0}\, '}" FontSize="12" Margin="0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ActiveProfileLead.Pincode, StringFormat='{}{0}\, '}" FontSize="12" Margin="0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActiveProfileLead.Country}" FontSize="12" Margin="0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Tags" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,8,8,8" VerticalAlignment="Center"/>
                            <Border Background="DarkCyan" Margin="2" CornerRadius="10" Padding="5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding ActiveProfileLead.LeadTag, TargetNullValue='No Tags'}" FontSize="10" TextWrapping="Wrap" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Source" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,8,8,8" VerticalAlignment="Center"/>
                            <Border Background="DarkBlue" Margin="2" CornerRadius="10" Padding="5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding ActiveProfileLead.LeadSource, TargetNullValue='No Source'}" FontSize="10" TextWrapping="Wrap" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Lables" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,8,8,8" VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding ActiveProfileLead.LeadLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#B6F9FA" Margin="2" CornerRadius="10" Padding="8,4">
                                            <TextBlock Text="{Binding TargetNullValue='No Labels'}" FontSize="11" Foreground="Black" FontWeight="Medium"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Divisions" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,8,8,8" VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding ActiveProfileLead.AssignedDivisions }">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="LightGreen" Margin="2" CornerRadius="10" Padding="8,4">
                                            <TextBlock Text="{Binding Name, TargetNullValue='No Divisions'}" FontSize="11" Foreground="Black" FontWeight="Medium"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="Description" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,10,0,6"/>
                        <TextBlock Text="{Binding ActiveProfileLead.LatestUpdate.Message, TargetNullValue='No recent update logs or message descriptions associated with this lead context.'}" 
                                   TextWrapping="Wrap" FontSize="13" Foreground="#4B5563" LineHeight="18" Margin="2,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="0" Background="White">                
                <TabControl x:Name="WorkspaceTabControl" Style="{StaticResource MaterialDesignUniformTabControl}" materialDesign:ColorZoneAssist.Mode="Standard" Background="Transparent" Padding="15,5">

                    <TabItem x:Name="InfoTab" Header="Info" FontSize="13" FontWeight="SemiBold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                            <StackPanel Margin="20">

                                <UniformGrid Rows="1">
                                    <UniformGrid.Style>
                                        <Style TargetType="UniformGrid">
                                            <Setter Property="Columns" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveProfileLead.Status}" Value="Matured">
                                                    <Setter Property="Columns" Value="3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </UniformGrid.Style>

                                    <materialDesign:Card Background="#F8FAFC" UniformCornerRadius="6" Padding="16" Margin="0,0,10,0">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="Primary Contact Details" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <Separator Background="#DCFCE7" Margin="0,0,0,4"/>
                                            <DockPanel>
                                                <materialDesign:PackIcon Kind="Domain" Foreground="#94A3B8" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ActiveProfileLead.CompanyName, StringFormat='Firm: {0}', TargetNullValue='Firm: --'}" FontSize="13" Foreground="#1E293B" Margin="10,0,0,0" FontWeight="Medium"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <materialDesign:PackIcon Kind="EmailOutline" Foreground="#94A3B8" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ActiveProfileLead.Email}" FontSize="13" Foreground="#2563EB" Margin="10,0,0,0"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <materialDesign:PackIcon Kind="PhoneOutline" Foreground="#94A3B8" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ActiveProfileLead.Phone, TargetNullValue='--'}" FontSize="13" Foreground="#1E293B" Margin="10,0,0,0"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <materialDesign:PackIcon Kind="PhoneInTalkOutline" Foreground="#94A3B8" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ActiveProfileLead.AltPhone, StringFormat='Alt Phone: {0}', TargetNullValue='Alt Phone: --'}" FontSize="13" Foreground="#1E293B" Margin="10,0,0,0"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <materialDesign:PackIcon Kind="MapMarkerOutline" Foreground="#94A3B8" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ActiveProfileLead.State, StringFormat='Location: {0}', TargetNullValue='Location: --'}" FontSize="13" Foreground="#1E293B" Margin="10,0,0,0"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Background="#F0FDF4" BorderBrush="#DCFCE7" UniformCornerRadius="6" Padding="16" Margin="10,0,10,0">
                                        <materialDesign:Card.Style>
                                            <Style TargetType="materialDesign:Card">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveProfileLead.Status}" Value="Matured">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:Card.Style>
                                        <StackPanel Margin="10">
                                            <TextBlock Text="Account History &amp; Status" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <Separator Background="#DCFCE7" Margin="0,0,0,4"/>
                                            <DockPanel>
                                                <TextBlock Text="Customer Since:" FontSize="13" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Metrics.CustomerSince, TargetNullValue='No Orders Yet'}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="Last 3 Months Billing:" FontSize="13" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Metrics.Last3MonthsBilling, StringFormat='₹ {0:N2}', TargetNullValue='0.00'}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="Last Order Date:" FontSize="13" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Metrics.LastOrderDate, TargetNullValue='--'}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="Outstanding Balance:" FontSize="13" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Metrics.OutstandingAmount, StringFormat='₹ {0:N2}', TargetNullValue='0.00'}" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" UniformCornerRadius="6" Padding="16" Margin="10,0,0,0">
                                        <materialDesign:Card.Style>
                                            <Style TargetType="materialDesign:Card">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveProfileLead.Status}" Value="Matured">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:Card.Style>
                                        <StackPanel Margin="10">
                                            <TextBlock Text="Business Realization Performance" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <Separator Background="#DCFCE7" Margin="0,0,0,4"/>
                                            <DockPanel>
                                                <TextBlock Text="This Month:" FontSize="13" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Metrics.MonthlyBusiness, StringFormat='₹ {0:N2}', TargetNullValue='0.00'}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="Avg Monthly Billing:" FontSize="13" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Metrics.MonthlyBusiness, StringFormat='₹ {0:N2}', TargetNullValue='0.00'}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="Last Quarter Billing:" FontSize="13" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Metrics.Last3MonthsBusiness, StringFormat='₹ {0:N2}', TargetNullValue='0.00'}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="Overall Business:" FontSize="13" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Metrics.OverallBusiness, StringFormat='₹ {0:N2}', TargetNullValue='0.00'}" HorizontalAlignment="Right" FontSize="14" FontWeight="Black" Foreground="#2563EB"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </materialDesign:Card>
                                </UniformGrid>

                                <!-- ROW B: CLASSIFICATIONS TAGS & SEGMENT LABELS WITH DISTINCT HEADINGS (UPDATED) -->
                                <materialDesign:Card UniformCornerRadius="6" Padding="16" Background="#FAFBFB" Margin="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- SECTION 1: LABELS (Soft Teal / Mint Accent) -->
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Labels" FontSize="11" FontWeight="Bold" Foreground="#0F766E"/>
                                            <ItemsControl ItemsSource="{Binding ActiveProfileLead.LeadLabels}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <materialDesign:Chip Content="{Binding}" Margin="0,2,4,2" Height="24" Background="#CCFBF1" Foreground="#115E59" FontWeight="Medium" IsDeletable="False"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- SECTION 2: TAGS (Soft Green Accent) -->
                                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                            <TextBlock Text="Category Tags" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                                            <Border Background="#DCFCE7" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Visibility="{Binding ActiveProfileLead.LeadTag, Converter={StaticResource NullableToVisibilityConverter}}">
                                                <TextBlock Text="{Binding ActiveProfileLead.LeadTag}" FontSize="12" Foreground="#15803D" FontWeight="SemiBold"/>
                                            </Border>
                                            <!-- Fallback if tag is null -->
                                            <TextBlock Text="--" FontSize="12" Foreground="#94A3B8" Visibility="{Binding ActiveProfileLead.LeadTag, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <!-- SECTION 3: LEAD SOURCE (Soft Indigo / Purple Accent) -->
                                        <StackPanel Grid.Column="2" Margin="10,0,10,0">
                                            <TextBlock Text="Lead Source" FontSize="11" FontWeight="Bold" Foreground="#4338CA"/>
                                            <Border Background="#E0E7FF" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Visibility="{Binding ActiveProfileLead.LeadSource, Converter={StaticResource NullableToVisibilityConverter}}">
                                                <TextBlock Text="{Binding ActiveProfileLead.LeadSource}" FontSize="12" Foreground="#4F46E5" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="--" FontSize="12" Foreground="#94A3B8" Visibility="{Binding ActiveProfileLead.LeadSource, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <!-- SECTION 4: DIVISIONS (Soft Amber / Blue Accent) -->
                                        <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                            <TextBlock Text="Assigned Divisions" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            <ItemsControl ItemsSource="{Binding ActiveProfileLead.AssignedDivisions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#DBEAFE" CornerRadius="4" Padding="8,4" Margin="0,2,4,2">
                                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#1E40AF" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>

                                <materialDesign:Card UniformCornerRadius="6" Padding="16" Background="#FAFBFB">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <!-- Left: Message narrative body text -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Right: Activity Metadata Info Badges -->
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="6" VerticalAlignment="Center">
                                            <TextBlock Text="Latest Activity" FontSize="11" FontWeight="Bold" Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding ActiveProfileLead.LatestUpdate.Message, TargetNullValue='No transaction comments or historical account descriptions are currently appended to this profile log.'}" 
                                               TextWrapping="Wrap" FontSize="13" Foreground="#334155" LineHeight="20" Margin="2,0,15,0"/>
                                        </StackPanel>

                                        <!-- Dynamic Activity Metadata Tracking Side Block -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <!-- Automatically hides the tracking badges if no activity logs exist yet -->
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveProfileLead.LatestUpdate}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <!-- Activity Logging Timestamp Stamp -->
                                            <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CalendarClock" Foreground="#64748B" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding ActiveProfileLead.LatestUpdate.LogDate, StringFormat={}{0:dd-MM-yyyy hh:mm tt}}" FontSize="11" Foreground="#475569" FontWeight="Medium" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Operator Identity Tracking Stamp -->
                                            <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AccountEditOutline" Foreground="#2563EB" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding ActiveProfileLead.LatestUpdate.UpdatedBy, StringFormat='By: {0}'}" FontSize="11" Foreground="#1E40AF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Update Here" FontSize="13" FontWeight="SemiBold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel Margin="5">
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,20">
                                    <RadioButton Content="Matured Followup" IsChecked="True" GroupName="UpdateWorkflowGroup" Margin="0,0,24,0" FontWeight="Medium"/>
                                    <RadioButton Content="Matured Dead" GroupName="UpdateWorkflowGroup" Margin="0,0,24,0" FontWeight="Medium"/>
                                    <RadioButton Content="Create Proforma" GroupName="UpdateWorkflowGroup" FontWeight="Medium"/>
                                </StackPanel>

                                <UniformGrid Columns="2" Margin="0,0,0,15">
                                    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Background="White" Margin="0,0,10,0" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="First Order Amount" FontSize="11" Foreground="#64748B" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding ActiveProfileLead.TotalOrderAmount, StringFormat='A ₹ {0:N2}', TargetNullValue='₹ 10,850.00'}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Background="White" Margin="10,0,0,0" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="Last Order Amount" FontSize="11" Foreground="#64748B" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding ActiveProfileLead.TotalOrderAmount, StringFormat='₹ {0:N2}', TargetNullValue='₹ 10,850.00'}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="Mature Stages *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,4,0,6"/>
                                <ComboBox materialDesign:HintAssist.Hint="Mature Stages *" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="40" Margin="0,0,0,15"/>

                                <CheckBox Content="I have received an order" FontWeight="Medium" Margin="0,4,0,15"/>

                                <UniformGrid Columns="2" Margin="0,5,0,15">
                                    <DatePicker materialDesign:HintAssist.Hint="18-06-2026" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,10,0"/>
                                    <materialDesign:TimePicker materialDesign:HintAssist.Hint="5:20 pm" Style="{StaticResource MaterialDesignOutlinedTimePicker}" Margin="10,0,0,0"/>
                                </UniformGrid>

                                <TextBlock Text="Message *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,5,0,6"/>
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

                                <Button Content="Update" HorizontalAlignment="Right" Width="120" Height="38" Background="#FF8A3D" BorderBrush="#FF8A3D" FontWeight="Bold" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Lead History" FontSize="13" FontWeight="SemiBold">
                        <Grid Margin="10,15">
                            <TextBlock Text="Complete communication log tracking matrix timeline..." Foreground="Gray" FontStyle="Italic"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Products" FontSize="13" FontWeight="SemiBold">
                        <TabItem.Style>
                            <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveProfileLead.Status}" Value="New">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActiveProfileLead.Status}" Value="Followup">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TabItem.Style>
                        <Grid Margin="10,15"/>
                    </TabItem>

                    <TabItem Header="Proforma" FontSize="13" FontWeight="SemiBold">
                        <TabItem.Style>
                            <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveProfileLead.Status}" Value="New">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActiveProfileLead.Status}" Value="Followup">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TabItem.Style>
                        <Grid Margin="10,15"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>    
</UserControl>
