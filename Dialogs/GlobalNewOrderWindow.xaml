<Window x:Class="CallMan.Dialogs.GlobalNewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Create Global Order" Height="500" Width="450"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="CREATE NEW ORDER" FontSize="20" FontWeight="Bold" Foreground="#1794A1" Margin="0,0,0,20"/>

            <TextBlock Text="Select Customer / Shop *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding MaturedCustomers}"
                      SelectedItem="{Binding SelectedCustomer}"
                      DisplayMemberPath="CustomerName"
                      materialDesign:HintAssist.Hint="Search or Select Shop"
                      IsEditable="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,20"/>

            <TextBlock Text="Order Amount *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding TotalAmount, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Enter Total Amount"
                     Margin="0,0,0,20"/>

            <TextBlock Text="Description (Items/Parts) *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Description}" 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="e.g. 50 Sets of Shimano Gears"
                     Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                     Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                <Button Content="CREATE ORDER" Command="{Binding SaveOrderCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Background="#1794A1" BorderBrush="#1794A1"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
