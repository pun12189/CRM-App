<UserControl x:Class="CallMan.Views.LeadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CallMan.Views"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,15" Padding="10" Background="White" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="Gray"/>
                    <Grid Width="250">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalContentAlignment="Center" Height="30"
                             Padding="5,0"/>
                        <TextBlock Text="Search by Name, City, Phone..." 
                               IsHitTestVisible="False" VerticalAlignment="Center" 
                               Margin="10,0" Foreground="LightGray">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <Button Grid.Column="2" Content="+ New Lead" 
                    Command="{Binding OpenAddLeadDialogCommand}"
                    Padding="20,5" Background="#1794A1" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding LeadsCollection}" SelectedItem="{Binding SelectedLead}"
          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" VerticalGridLinesBrush="#DDD">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding LeadId}" Width="50"/>                
                <DataGridTemplateColumn Header="Name" Width="*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Text="{Binding CompanyName, StringFormat=({0})}" FontSize="10" Margin="0,5,0,0" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CustomerName}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,5,5"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button BorderThickness="0" ToolTip="Update Info" Command="{Binding DataContext.OpenLeadProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" HorizontalAlignment="Center" Background="Transparent" Foreground="DarkSlateGray" FontWeight="Bold" Margin="5,0">
                                        <icon:BootstrapIcons Kind="JournalText"/>
                                    </Button>
                                    <Button BorderThickness="0" ToolTip="Edit Info" Command="{Binding DataContext.EditLeadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" HorizontalAlignment="Center" Background="Transparent" Foreground="DarkSlateGray" FontWeight="Bold" Margin="5,0">
                                        <icon:BootstrapIcons Kind="PencilFill"/>
                                    </Button>
                                    <Button BorderThickness="0" ToolTip="Delete" Command="{Binding DataContext.DeleteLeadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" HorizontalAlignment="Center" Background="Transparent" Foreground="DarkSlateGray" FontWeight="Bold" Margin="5,0">
                                        <icon:BootstrapIcons Kind="Trash3Fill"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Center" Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy}}" FontWeight="Bold" Margin="0,10,0,5"/>
                                <!--<TextBlock HorizontalAlignment="Center" Text="{Binding Id, StringFormat=ID: {0}}" FontWeight="Bold" Margin="0,0,0,10"/>-->
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="150"/>
                <DataGridTemplateColumn Header="Status" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="LightBlue" CornerRadius="10" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Other Info" Binding="{Binding CustomInfoSummary}" Width="200"/>
                <DataGridTemplateColumn Header="Last Message" Width="220">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F2F3F7"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="10,5"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding LatestUpdate.Message}" 
                                               TextWrapping="Wrap" Height="40" FontSize="13" Foreground="#2C3E50"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding LatestUpdate.LogDate, StringFormat=d}" 
                                                   FontSize="11" Foreground="#7F8C8D" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding LatestUpdate.UpdatedBy}" 
                                                   FontSize="11" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <Button Content="Lead History" 
                                            Margin="0,10,0,0" Padding="15,4" Height="26"
                                            Background="#1794A1" Foreground="White" BorderThickness="0"
                                            Command="{Binding DataContext.ShowHistoryDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>

                                <TextBlock Text="No message yet" Visibility="Collapsed" 
                                           IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LatestUpdate}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
