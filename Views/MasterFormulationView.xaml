<UserControl x:Class="Tijori.Views.MasterFormulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title & Quick Add -->
            <RowDefinition Height="Auto"/>
            <!-- Header: Finished Good & Batch Info -->
            <RowDefinition Height="Auto"/>
            <!-- 🌟 NEW: Ingredient Selector Bar -->
            <RowDefinition Height="*"/>
            <!-- DataGrid Table -->
            <RowDefinition Height="Auto"/>
            <!-- Balance Meter & Save Footer -->
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Master Formulation" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="+ Quick Add Raw Material" Command="{Binding OpenQuickAddProductCommand}" 
                    Background="#0D9488" Foreground="White" BorderThickness="0" Height="32" Padding="12,0"/>
        </DockPanel>

        <!-- FORMULATION META -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Finished Product Dropdown -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Finished Good Product:" FontWeight="SemiBold" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding FinishedProductsList}" 
                      SelectedValue="{Binding CurrentFormulation.FinishedProductId, Mode=TwoWay}" 
                      SelectedValuePath="ProductId" 
                      DisplayMemberPath="Name" Padding="10,0"
                      materialDesign:HintAssist.Hint="Finished Good Product (Optional)"
                      materialDesign:TextFieldAssist.HasClearButton="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                      Height="36"/>
                </StackPanel>

                <!-- Formulation Name -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Formulation / Recipe Name:" FontWeight="SemiBold" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CurrentFormulation.FormulationName}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="36" Padding="10,0"/>
                </StackPanel>

                <!-- Standard Batch Size -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Std Batch (Ltr/Kg):" FontWeight="SemiBold" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CurrentFormulation.StandardBatchSize}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="36" Padding="10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <!-- Phase Input -->
                    <ColumnDefinition Width="3*"/>
                    <!-- Searchable Raw Material Dropdown -->
                    <ColumnDefinition Width="130"/>
                    <!-- Initial % Input -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Add Button -->
                </Grid.ColumnDefinitions>

                <!-- 1. Phase -->
                <ComboBox Grid.Column="0" 
                      Text="{Binding NewIngredientPhase, UpdateSourceTrigger=PropertyChanged}" 
                      IsEditable="True" Padding="10,0"
                      materialDesign:HintAssist.Hint="Phase"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                      Height="40" Margin="0,0,10,0">
                    <ComboBoxItem Content="Phase A"/>
                    <ComboBoxItem Content="Phase B"/>
                    <ComboBoxItem Content="Phase C"/>
                    <ComboBoxItem Content="Phase D"/>
                </ComboBox>

                <!-- 2. Searchable Raw Material Dropdown -->
                <ComboBox Grid.Column="1" 
                      ItemsSource="{Binding RawMaterialsList}" 
                      SelectedItem="{Binding SelectedRawMaterialToAdd}" 
                      DisplayMemberPath="Name"
                      IsEditable="True" Padding="10,0"
                      materialDesign:HintAssist.Hint="Search &amp; Select Raw Material / Chemical..."
                      materialDesign:TextFieldAssist.HasClearButton="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                      Height="40" Margin="0,0,10,0"/>

                <!-- 3. % Quantity -->
                <TextBox Grid.Column="2" 
                     Text="{Binding NewIngredientPercentage, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" 
                     materialDesign:HintAssist.Hint="Quantity (%)" Padding="10,0"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                     Height="40" Margin="0,0,12,0"/>

                <!-- 4. Add Button -->
                <Button Grid.Column="3" 
                    Command="{Binding AddIngredientRowCommand}" 
                    CommandParameter="{Binding SelectedRawMaterialToAdd}"
                    Content="+ ADD INGREDIENT" 
                    Background="#1794A1" 
                    BorderBrush="#1794A1" 
                    Foreground="White" 
                    FontWeight="SemiBold" 
                    Height="40" Padding="14,0"/>
            </Grid>
        </Border>

        <!-- INGREDIENTS TABLE -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding CurrentFormulation.Items}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="90"/>
                    <DataGridTextColumn Header="Raw Material Name" Binding="{Binding RawMaterialName}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70" IsReadOnly="True"/>

                    <!-- % Quantity Input -->
                    <DataGridTemplateColumn Header="Quantity (%)" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding PercentageValue, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Remarks / Mixing Instructions" Binding="{Binding Remarks}" Width="*"/>

                    <!-- Delete Row Action -->
                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignIconButton}" Width="24" Height="24" Padding="0"
                                        Command="{Binding DataContext.RemoveIngredientRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <materialDesign:PackIcon Kind="Trash" Width="12" Height="12" Foreground="#EF4444"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 🌟 100% BALANCING WATER / QS METER FOOTER 🌟 -->
        <Border Grid.Row="4" Background="#F1F5F9" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Save Formulation Master" Command="{Binding SaveFormulationCommand}" Background="#1794A1" Foreground="White" FontWeight="Bold" Height="36" Padding="20,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Total Ingredients -->
                    <TextBlock Text="Total Active Ingredients: " Foreground="#64748B" FontSize="12.5"/>
                    <TextBlock Text="{Binding CurrentFormulation.TotalIngredientsPercentage, StringFormat='{}{0:N2}%'}" FontWeight="Bold" Foreground="#0F172A" FontSize="13" Margin="0,0,24,0"/>

                    <!-- Auto-Calculated Water / QS -->
                    <Border Background="#E0F2FE" CornerRadius="4" Padding="8,4" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="WaterPercent" Foreground="#0284C7" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Water (Aqua / QS): " Foreground="#0369A1" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentFormulation.WaterPercentage, StringFormat='{}{0:N2}%'}" FontWeight="Black" Foreground="#0369A1" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MODAL OVERLAY: QUICK ADD UNLISTED RAW MATERIAL -->
        <materialDesign:DialogHost IsOpen="{Binding IsQuickAddProductOpen}" Grid.RowSpan="5">
            <materialDesign:DialogHost.DialogContent>
                <Border Width="380" Padding="20" Background="White" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Quick Add Raw Material" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                        <TextBlock Text="Product / Chemical Name:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding QuickProductName}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Unit (Kg/Ltr/GM):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding QuickProductUnit}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Recipe %:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding QuickProductPercentage}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Cancel" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
                            <Button Content="Save &amp; Add" Command="{Binding SubmitQuickAddProductCommand}" Background="#0D9488" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</UserControl>
