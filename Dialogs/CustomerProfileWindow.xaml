<Window x:Class="CallMan.Dialogs.CustomerProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        mc:Ignorable="d"
        Title="Customer Section" Height="700" Width="900"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <materialDesign:BooleanToVisibilityConverter x:Key="InvertedVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Details Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Tabs & Data -->
        <materialDesign:Card Grid.Row="0" Padding="20" Background="#F5F5F5" Visibility="{Binding IsInfoTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Contact -->
                <StackPanel Grid.Column="0">
                    <TextBlock><Run Text="Firm name: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.CompanyName}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Email: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.Email}" Foreground="#2196F3"/></TextBlock>
                    <TextBlock><Run Text="Phone: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.Phone}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Location: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.State}"/></TextBlock>
                </StackPanel>

                <!-- Column 2: Status -->
                <StackPanel Grid.Column="1">
                    <TextBlock><Run Text="Customer Since: " FontWeight="Bold"/><Run Text="{Binding Metrics.CustomerSince}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Last 3 months billing: " FontWeight="Bold"/><Run Text="{Binding Metrics.Last3MonthsBilling}"/></TextBlock>
                    <TextBlock><Run Text="Last order date: " FontWeight="Bold"/><Run Text="{Binding Metrics.LastOrderDate}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Outstanding: " FontWeight="Bold"/><Run Text="{Binding Metrics.OutstandingAmount}" Foreground="Red"/></TextBlock>
                </StackPanel>

                <!-- Column 3: Business/Target -->
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Business Done/Target" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock><Run Text="Monthly: " Foreground="Red"/><Run Text="{Binding Metrics.MonthlyBusiness}"/></TextBlock>
                        <TextBlock><Run Text="Last 3 Months: " Foreground="Red"/><Run Text="{Binding Metrics.Last3MonthsBusiness}"/></TextBlock>
                        <TextBlock><Run Text="Overall: " Foreground="#2196F3"/><Run Text="{Binding Metrics.OverallBusiness}"/></TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </materialDesign:Card>

        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}" Margin="10" SelectedIndex="{Binding SelectedTabWorkspaceIndex, UpdateSourceTrigger=PropertyChanged}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Margin="0,0,4,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="ArrowDown" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsInfoTabSelected, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="True">
                                            <Setter Property="Kind" Value="ArrowUp"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Text="Info"/>
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem Header="Profile"/>
            <TabItem Header="Update Here" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="15" Orientation='Vertical'>
                        <!-- 1. ACTION SELECTION (image_0d55ea.png radio buttons) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <RadioButton Content="Matured Followup" IsChecked="{Binding IsMaturedFollowup}" Margin="0,0,15,0"/>
                            <RadioButton Content="Matured Dead" IsChecked="{Binding IsMaturedDead}" Margin="0,0,15,0"/>
                            <RadioButton Content="Create Proforma" IsChecked="{Binding IsCreatingProforma}" Margin="0,0,15,0" Visibility="Visible"/>
                            <RadioButton Content="Create Order" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- 2. ORDER AMOUNTS (Specialized analytics) -->
                        <Grid Margin="0,0,0,15" Visibility="{Binding IsMaturedFollowup, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding Data.FirstOrderAmount, StringFormat={}{0:C2}, ConverterCulture=en-IN, Mode=OneWay}"
                                 materialDesign:HintAssist.Hint="First Order Amount" IsReadOnly="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <TextBox Grid.Column="2" Text="{Binding Data.LastOrderAmount, StringFormat={}{0:C2}, ConverterCulture=en-IN, Mode=OneWay}"
                                 materialDesign:HintAssist.Hint="Last Order Amount" IsReadOnly="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            <!-- Subtext for last order date/time would go here -->
                        </Grid>

                        <StackPanel Margin="0,0,0,15" Visibility="{Binding IsMaturedDead, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Dead Reason *" Foreground="#555"/>
                            <ComboBox ItemsSource="{Binding DeadStages}" Margin="0,5,0,0" SelectedItem="{Binding SelectedDeadStage}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Dead Reasons *" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15" Visibility="{Binding IsMaturedFollowup, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Visibility="{Binding IsOrderReceived, Converter={StaticResource InvertedVisibilityConverter}}">
                                <TextBlock Text="Mature Stages *" Foreground="#555"/>
                                <ComboBox ItemsSource="{Binding MatureStages}" SelectedItem="{Binding SelectedMatureStage}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Mature Stages *" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,5,0,15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <CheckBox Content="I have received an order" IsChecked="{Binding IsOrderReceived}" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsOrderReceived, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!-- Order Amount (Only show if checked) -->
                                    <TextBox Text="{Binding OrderValue}" materialDesign:HintAssist.Hint="Order Amount" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="10,0,0,10"/>

                                    <TextBox Text="{Binding PaymentReceived}" materialDesign:HintAssist.Hint="Payment Received" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="10,0,0,10"/>
                                </StackPanel>
                                <Border Background="#FFF4F4" Padding="10" CornerRadius="4" Visibility="{Binding IsOrderReceived, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Balance Due: " VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding BalancePayment, StringFormat='₹ {0:N2}'}" FontWeight="Bold" Foreground="Red" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Next Followup Date *"/>
                                    <DatePicker SelectedDate="{Binding NextFollowupDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayDateStart="{Binding MinDate}" Margin="0,5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

                                    <TextBlock Text="Next Followup Time" Foreground="#555" Margin="0,0,0,5"/>

                                    <materialDesign:TimePicker SelectedTime="{Binding SelectedTime}" Is24Hours="False" materialDesign:HintAssist.Hint="Pick Time" materialDesign:TextFieldAssist.HasClearButton="True" VerticalAlignment="Center" xml:lang="en-IN" />

                                    <TextBlock Text="Clock icon appears on hover/focus" FontSize="10" FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>                      

                        <!-- 6. MESSAGE/HISTORY -->
                        <TextBox Text="{Binding Message}" Visibility="{Binding IsCreatingProforma, Converter={StaticResource InvertedVisibilityConverter}}" materialDesign:HintAssist.Hint="Message *"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="100" TextWrapping="Wrap"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                        <!-- 7. SAVE BUTTON -->
                        <Button Command="{Binding UpdateCustomerCommand}" Visibility="{Binding IsCreatingProforma, Converter={StaticResource InvertedVisibilityConverter}}" Content="Update" HorizontalAlignment="Right" 
                            Background="#FF8A3D" BorderBrush="#FF8A3D" Width="120" Height="40"/>

                        <Grid Margin="10" Visibility="{Binding IsCreatingProforma, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Product Selection Bar -->
                                <RowDefinition Height="*"/>
                                <!-- Items List -->
                                <RowDefinition Height="Auto"/>
                                <!-- Summary & Actions -->
                            </Grid.RowDefinitions>

                            <!-- 1. PRODUCT SELECTION -->
                            <materialDesign:Card Grid.Row="0" Padding="10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <!-- Product Dropdown -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Qty -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Add Button -->
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableProducts}" 
                      SelectedItem="{Binding SelectedProduct}"
                      DisplayMemberPath="Name"
                      materialDesign:HintAssist.Hint="Search Inventory..."
                      IsEditable="True" Margin="5"/>

                                    <TextBox Grid.Column="1" Text="{Binding Quantity}" 
                     materialDesign:HintAssist.Hint="Qty" Width="60" 
                     Margin="10,5" HorizontalContentAlignment="Center"/>

                                    <Button Grid.Column="2" Command="{Binding AddItemCommand}" 
                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                    Background="#1794A1" BorderBrush="#1794A1">
                                        <materialDesign:PackIcon Kind="Plus" />
                                    </Button>
                                </Grid>
                            </materialDesign:Card>

                            <!-- 2. SELECTED ITEMS DATAGRID -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedItems}" HorizontalAlignment="Stretch" AutoGenerateColumns="False" CanUserAddRows="False" Foreground="Black" 
          RowBackground="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Rate" Binding="{Binding UnitPrice, StringFormat='₹{0:N2}'}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="GST %" Binding="{Binding GstPercent}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Subtotal" Binding="{Binding SubTotal, StringFormat='₹{0:N2}'}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="Action">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MaterialDesignIconButton}" 
                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="Red"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 3. FOOTER -->
                            <StackPanel Grid.Row="2" Margin="0,15,0,0">
                                <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="0,0,0,10"/>
                                <Grid>
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock Text="PROFORMA QUOTATION" Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                                        <TextBlock Text="No Stock Commitment" Foreground="Orange" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="Grand Total" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                                            <TextBlock Text="{Binding GrandTotal, StringFormat='₹{0:N2}'}" 
                               FontSize="22" FontWeight="Bold" Foreground="#1794A1"/>
                                        </StackPanel>

                                        <Button Content="GENERATE PROFORMA" Command="{Binding SaveProformaCommand}" 
                        Height="50" Width="200"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Other Tabs (Products, Lead History) here -->
        </TabControl>
    </Grid>
</Window>
