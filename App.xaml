<Application x:Class="Tijori.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:security="clr-namespace:Tijori.Core"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             ShutdownMode="OnExplicitShutdown"
             xmlns:local="clr-namespace:Tijori">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="SettingTileStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Background" Value="#2CB3A5"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Height" Value="100"/>
                <Setter Property="Margin" Value="10"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#24968B"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SidebarLinkStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Foreground" Value="#444"/>
                <Setter Property="Padding" Value="15,10"/>
                <Setter Property="Height" Value="NaN"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#EEE"/>
            </Style>

            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="Background" Value="#e0e0ea" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style x:Key="MaterialToastWindowStyle" TargetType="Window">
                <Setter Property="WindowStyle" Value="None"/>
                <Setter Property="AllowsTransparency" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ShowInTaskbar" Value="False"/>
                <Setter Property="Topmost" Value="True"/>
                <Setter Property="SizeToContent" Value="WidthAndHeight"/>
                <Setter Property="ResizeMode" Value="NoResize"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Window">
                            <materialDesign:Card Width="350" 
                                     Margin="12" 
                                     Padding="16" 
                                     UniformCornerRadius="8"
                                     Background="White" 
                                     materialDesign:ElevationAssist.Elevation="Dp3"
                                     BorderBrush="#E5E7EB" 
                                     BorderThickness="1">
                                <ContentPresenter />
                            </materialDesign:Card>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ==================================================================== -->
            <!-- HIGH-DENSITY COMPACT TILE CARD STYLE & TEMPLATE                     -->
            <!-- ==================================================================== -->
            <Style x:Key="UniversalTileCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Width" Value="270"/>
                <!-- Compact Width to fit 4-5 cards per row -->
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#0F172A" Opacity="0.06"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- Elevated floating hover effect with crisp border -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Panel.ZIndex" Value="99"/>
                        <Setter Property="BorderBrush" Value="#14838F"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#0F172A" Opacity="0.16"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="UniversalTileCardTemplate">
                <Border Style="{StaticResource UniversalTileCardStyle}">
                    <StackPanel>
                        <!-- 1. TOP HEADER: CHECKBOX, COMPANY NAME & TOP-RIGHT HOVER ACTIONS -->
                        <Grid Height="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <!-- 🌟 Checkbox -->
                                <ColumnDefinition Width="*"/>
                                <!-- Company Name -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Hover Action Buttons -->
                            </Grid.ColumnDefinitions>

                            <!-- 🌟 SELECTION CHECKBOX 🌟 -->
                            <CheckBox Grid.Column="0" 
          IsChecked="{Binding IsSelectedForAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
          VerticalAlignment="Center" 
          Margin="0,0,6,0">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click">
                                        <i:InvokeCommandAction Command="{Binding DataContext.ItemSelectionChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding RawModel}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </CheckBox>

                            <!-- COMPANY NAME -->
                            <TextBlock Grid.Column="1" 
                           Text="{Binding HeaderTag}" 
                           FontSize="10.5" 
                           FontWeight="Medium" 
                           Foreground="#64748B" 
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                            <!-- 🌟 TOP-RIGHT ACTION BUTTONS (VISIBLE ON HOVER) 🌟 -->
                            <StackPanel x:Name="TopActionButtons" 
                            Grid.Column="2" 
                            Orientation="Horizontal" 
                            Visibility="Collapsed" 
                            Margin="0,-2,-2,0">

                                <!-- UPDATE / PROFILE WORKSPACE -->
                                <Button Style="{StaticResource MaterialDesignIconButton}" 
                            Width="22" Height="22" Padding="0" Margin="1,0"
                            ToolTip="Open Workspace"
                            Foreground="Green"
                            Command="{Binding DataContext.UpdateStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding RawModel}"
                            security:SecurityGuard.Requires="Lead:Update">
                                    <materialDesign:PackIcon Kind="Journal" Width="11" Height="11"/>
                                </Button>

                                <!-- EDIT BUTTON -->
                                <Button Style="{StaticResource MaterialDesignIconButton}" 
                            Width="22" Height="22" Padding="0" Margin="1,0"
                            ToolTip="Edit Lead"
                            Foreground="CadetBlue"
                            Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding RawModel}"
                            security:SecurityGuard.Requires="Lead:Edit">
                                    <materialDesign:PackIcon Kind="Pencil" Width="11" Height="11"/>
                                </Button>

                                <!-- DELETE BUTTON -->
                                <Button Style="{StaticResource MaterialDesignIconButton}" 
                            Width="22" Height="22" Padding="0" Margin="1,0"
                            ToolTip="Delete Lead"
                            Foreground="MediumPurple"
                            Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding RawModel}"
                            security:SecurityGuard.Requires="Lead:Delete">
                                    <materialDesign:PackIcon Kind="Trash" Width="11" Height="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 2. PRIMARY ROW: AVATAR & CUSTOMER NAME -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="13" 
                        Background="{Binding BadgeBackgroundHex}" 
                        Margin="0,0,8,0">
                                <TextBlock Text="{Binding BadgeText}" 
                               FontWeight="Bold" FontSize="10.5" 
                               Foreground="{Binding BadgeForegroundHex}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="{Binding PrimaryTitle}" 
                           FontWeight="Bold" FontSize="13" 
                           Foreground="#0F172A" 
                           Cursor="Hand"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="210">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                      Command="{Binding DataContext.ShowLeadWorkspaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                      CommandParameter="{Binding RawModel}" />
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </StackPanel>

                        <Border Height="1" Background="#F1F5F9" Margin="-10,0,-10,6"/>

                        <!-- 3. COMPACT SUMMARY META ROW -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: HOLDER, STATUS, TAG & SOURCE -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Person" Width="11" Height="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock Text="{Binding OwnerOrMetaLabel}" FontSize="10" Foreground="#475569" FontWeight="Medium" Margin="0,0,5,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="80"/>

                                <!-- STATUS BADGE -->
                                <Border Background="{Binding StatusColorHex}" CornerRadius="3" Padding="4,1" Margin="0,0,3,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding StatusTextColorHex}"/>
                                </Border>

                                <!-- SINGLE TAG BADGE -->
                                <Border Background="{Binding TagColorHex}" CornerRadius="3" Padding="4,1" Margin="0,0,3,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TagText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TagText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TagText}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding TagTextColorHex}"/>
                                </Border>

                                <!-- SOURCE BADGE -->
                                <Border Background="#F1F5F9" CornerRadius="3" Padding="4,1">
                                    <TextBlock Text="{Binding SourceOrCategory}" FontSize="9" Foreground="#64748B"/>
                                </Border>
                            </StackPanel>

                            <!-- RIGHT: 3 VERTICAL DOTS (⋮) BUTTON -->
                            <Button Grid.Column="1"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="22" Height="22" 
                        Padding="0" Margin="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip="More Options"
                        Command="{Binding DataContext.MoreOptionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RawModel}">
                                <materialDesign:PackIcon Kind="DotsVertical" Width="16" Height="16" Foreground="#64748B"/>
                            </Button>
                        </Grid>

                        <!-- 4. EXPANDABLE HOVER DETAILS -->
                        <StackPanel x:Name="ExpandedDetailsPanel" Visibility="Collapsed" Margin="0,6,0,0">
                            <Border Height="1" Background="#E2E8F0" Margin="-10,0,-10,8"/>

                            <ItemsControl ItemsSource="{Binding ExpandedDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Width="78">
                                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="11" Height="11" Foreground="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10.5" Foreground="{Binding ValueColorHex}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding BadgesOrLabels}" Margin="0,3,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#EEF2FF" CornerRadius="4" Padding="4,1" Margin="0,0,3,3">
                                            <TextBlock Text="{Binding}" FontSize="9" Foreground="#4F46E5" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <DataTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="TopActionButtons" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="ExpandedDetailsPanel" Property="Visibility" Value="Visible"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
