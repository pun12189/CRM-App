<UserControl x:Class="CallMan.Views.SchemeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CallMan.Views"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <md:ColorZone Grid.Row="0" Mode="Standard" Padding="20,15" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Incentive &amp; Policy Control Center" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold"/>
                    <TextBlock Text="Manage active sales pipeline campaigns, customer rebates, and staff targeted milestone achievements." Style="{StaticResource MaterialDesignBody2TextBlock}" TextWrapping="Wrap" Opacity="0.6" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📥 EXPORT DATA" 
                            Command="{Binding ExportReportCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Height="42" Margin="0,0,12,0" FontWeight="SemiBold"/>

                    <Button Content="+ NEW INCENTIVE RULE" 
                            Command="{Binding OpenCreateSchemeCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#1794A1" BorderBrush="#1794A1" Height="42" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </md:ColorZone>

        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignUniformTabControl}" BorderThickness="0">

            <TabItem Header="🤝 LEADS &amp; CUSTOMERS OFFERS">
                <Grid Margin="10">
                    <DataGrid ItemsSource="{Binding CustomerSchemesCollection}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Scheme Title" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat={}{0:dd-MM-yyyy}}" Width="130"/>
                            <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat={}{0:dd-MM-yyyy}}" Width="130"/>
                            <DataGridTextColumn Header="Target Threshold (₹)" Binding="{Binding MinimumOrderThreshold, StringFormat={}{0:N2}}" Width="150"/>
                            <DataGridTextColumn Header="Benefit Type" Binding="{Binding RewardType}" Width="110"/>
                            <DataGridTemplateColumn Header="Status" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Layout container holding both status states -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                            <!-- 1. EXPIRED BADGE TEXT Token: Hidden by default, visible only when expired -->
                                            <Border x:Name="ExpiredBadge" 
                                                Background="#FEE2E2" 
                                                CornerRadius="4" 
                                                Padding="6,3" 
                                                Margin="0,0,8,0" 
                                                Visibility="Collapsed">
                                                <TextBlock Text="EXPIRED" 
                                                   Foreground="#EF4444" 
                                                   FontSize="10" 
                                                   FontWeight="Bold" 
                                                   VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- 2. STATUS TOGGLE SWITCH -->
                                            <ToggleButton x:Name="StatusToggle" 
                                              IsChecked="{Binding IsActive, Mode=TwoWay}" 
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                              ToolTip="Toggle Active State Mode"/>
                                        </StackPanel>

                                        <!-- TRIDGERS CONFIGURATION TO AUTOMATE INTERACTIVE LAYOUT CHANGING -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                <!-- If scheme is expired: Display the red badge, disable the toggle switch, and fade its opacity -->
                                                <Setter TargetName="ExpiredBadge" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="StatusToggle" Property="IsEnabled" Value="False"/>
                                                <Setter TargetName="StatusToggle" Property="Opacity" Value="0.4"/>
                                                <Setter TargetName="StatusToggle" Property="IsChecked" Value="False"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                            <!-- EDIT BUTTON ROW TRIGGER -->
                                            <Button Command="{Binding DataContext.EditSchemeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}" 
                                                ToolTip="Modify Strategy Parameters"
                                                Width="32" Height="32" Padding="0" Margin="0,0,4,0">
                                                <md:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </Button>

                                            <!-- PERMANENT PURGE DELETE ROW TRIGGER -->
                                            <Button Command="{Binding DataContext.DeleteSchemeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}" 
                                                ToolTip="Permanently Delete Policy"
                                                Width="32" Height="32" Padding="0">
                                                <md:PackIcon Kind="Delete" Width="18" Height="18" Foreground="{DynamicResource ErrorColor}"/>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="🎯 STAFF ACHIEVEMENT CONTROLS">
                <Grid Margin="10">
                    <DataGrid ItemsSource="{Binding StaffSchemesCollection}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Incentive Program" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat={}{0:dd-MM-yyyy}}" Width="140"/>
                            <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat={}{0:dd-MM-yyyy}}" Width="140"/>
                            <DataGridTextColumn Header="Volume Target Required (₹)" Binding="{Binding MinimumOrderThreshold, StringFormat={}{0:N2}}" Width="170"/>
                            <DataGridTextColumn Header="Reward Item" Binding="{Binding GiftItemName}" Width="180"/>
                            <DataGridTemplateColumn Header="Status" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Layout container holding both status states -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                            <!-- 1. EXPIRED BADGE TEXT Token: Hidden by default, visible only when expired -->
                                            <Border x:Name="StaffExpiredBadge" 
                                                Background="#FEE2E2" 
                                                CornerRadius="4" 
                                                Padding="6,3" 
                                                Margin="0,0,8,0" 
                                                Visibility="Collapsed">
                                                <TextBlock Text="EXPIRED" 
                                                   Foreground="#EF4444" 
                                                   FontSize="10" 
                                                   FontWeight="Bold" 
                                                   VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- 2. STATUS TOGGLE SWITCH -->
                                            <ToggleButton x:Name="StaffStatusToggle" 
                                              IsChecked="{Binding IsActive, Mode=TwoWay}" 
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                              ToolTip="Toggle Active State Mode"/>
                                        </StackPanel>

                                        <!-- TRIDGERS CONFIGURATION TO AUTOMATE INTERACTIVE LAYOUT CHANGING -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                <!-- If scheme is expired: Display the red badge, disable the toggle switch, and fade its opacity -->
                                                <Setter TargetName="StaffExpiredBadge" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="StaffStatusToggle" Property="IsEnabled" Value="False"/>
                                                <Setter TargetName="StaffStatusToggle" Property="Opacity" Value="0.4"/>
                                                <Setter TargetName="StaffStatusToggle" Property="IsChecked" Value="False"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                            <!-- EDIT BUTTON ROW TRIGGER -->
                                            <Button Command="{Binding DataContext.EditSchemeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}" 
                                                ToolTip="Modify Strategy Parameters"
                                                Width="32" Height="32" Padding="0" Margin="0,0,4,0">
                                                <md:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </Button>

                                            <!-- PERMANENT PURGE DELETE ROW TRIGGER -->
                                            <Button Command="{Binding DataContext.DeleteSchemeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}" 
                                                ToolTip="Permanently Delete Policy"
                                                Width="32" Height="32" Padding="0">
                                                <md:PackIcon Kind="Delete" Width="18" Height="18" Foreground="{DynamicResource ErrorColor}"/>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
