<Window x:Class="Tijori.Dialogs.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tijori.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Tijori.Converters"
        mc:Ignorable="d"
        Icon="/Assets/opn.png"
        Title="Product License Activation" 
        Height="Auto" Width="440" SizeToContent="Height" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Window.Resources>
        <materialDesign:BooleanToVisibilityConverter TrueValue="Collapsed" FalseValue="Visible" x:Key="InvertedBooleanConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Border Padding="24" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>

                <!-- Section Header Row Layout Descriptor -->
                <StackPanel Margin="4">
                    <TextBlock Text="Software Activation Desk" FontSize="18" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Left"/>
                    <TextBlock Text="Activate your enterprise product key offline securely." FontSize="12" Foreground="#64748B" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Input Field 1: Immutable Hardware/DB System ID Challenge Token Input Control -->
                <StackPanel Margin="6">
                    <TextBlock Text="Your Unique System Identifier Token:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Left"/>
                    <TextBox Text="{Binding ChallengeSystemId, Mode=OneWay}" 
                             IsReadOnly="True" Background="#F1F5F9" FontWeight="Bold" Foreground="#0F172A"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Provide the token above to your software provider to generate a key." FontSize="11" FontStyle="Italic" Foreground="#94A3B8" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Input Field 2: Responsive Serial Entry Input Control Box -->
                <StackPanel Margin="6">
                    <TextBlock Text="Enter Activation Serial Key:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Left"/>
                    <TextBox Text="{Binding EnteredSerialResponseKey, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Paste your activation key here" Height="100" 
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Padding="8"
                             FontSize="13"
                             Background="#F9FAFC"
                             BorderBrush="#CCCCCC"
                             BorderThickness="1"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" VerticalContentAlignment="Center"/>
                    <TextBlock Name="TxtPlaceholderTip" 
                               Text="Paste the full encrypted block provided by your vendor."
                               FontSize="11" 
                               FontStyle="Italic"
                               Foreground="#888888"
                               Margin="0,3,0,10"
                               HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- System Runtime Validation Feedback Messaging Element Field Box -->
                <TextBlock Text="{Binding ErrorNotificationMessage}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" 
                           HorizontalAlignment="Left" TextWrapping="Wrap" Visibility="{Binding ErrorNotificationMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <Separator Background="#E2E8F0" Margin="0,4"/>

                <!-- Operational Action Submission Run Button -->
                <Button Content="Activate Product Parameters" Command="{Binding SubmitLicenseRegistrationCommand}" 
                        IsEnabled="{Binding IsActionExecuting, Converter={StaticResource InvertedBooleanConverter}}"
                        Height="40" Background="#1794A1" BorderBrush="#1794A1" FontSize="13" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
