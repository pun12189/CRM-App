<Window x:Class="CallMan.Dialogs.GlobalNewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:CallMan.Converters"
        xmlns:models="clr-namespace:CallMan.Models"
        mc:Ignorable="d" x:Name="win"
        Icon="/Assets/opn.png"
        Title="Create Global Order" Height="700" Width="1024"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:IntToVisibilityConverter x:Key="IntToVisibility"/>
        <conv:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </Window.Resources>

    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="CREATE NEW ORDER" FontSize="20" FontWeight="Bold" Foreground="#1794A1" Margin="0,0,0,20"/>
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource IntToVisibility}, ConverterParameter=1}">
                
                <TextBlock Text="Select Customer / Company *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                
                <ComboBox ItemsSource="{Binding MaturedCustomers}"
                      SelectedItem="{Binding SelectedCustomer}"
                      DisplayMemberPath="CustomerName"
                      materialDesign:HintAssist.Hint="Search or Select Shop"
                      IsEditable="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding OrderValue, StringFormat='{}{0:N2}'}"
                 materialDesign:HintAssist.Hint="Order Value" IsReadOnly="True" Margin="5" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <TextBox Grid.Column="1" Text="{Binding AmountReceived}" 
                 materialDesign:HintAssist.Hint="Amount Received" Margin="5" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <RadioButton Content="Cash" IsChecked="{Binding PaymentMode, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Cash}" Margin="5,0"/>
                        <RadioButton Content="Self" IsChecked="{Binding PaymentMode, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Self}" Margin="5,0"/>
                        <RadioButton Content="Sample" IsChecked="{Binding PaymentMode, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Sample}" Margin="5,0"/>
                        <RadioButton Content="Credit" IsChecked="{Binding PaymentMode, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Credit}" Margin="5,0"/>
                    </StackPanel>
                </Grid>

                <materialDesign:Card Padding="10" Background="#F9F9F9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="5"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ComboBox Grid.Row="2" x:Name="ProductSelectionCombo"
                              ItemsSource="{Binding ProductsLookupCollection}"
                              SelectedItem="{Binding SelectedLookupRow}"
                              TextSearch.TextPath="DisplayText"
                              materialDesign:HintAssist.Hint="Select Product or Specific Batch"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              IsEditable="True"
                              VerticalAlignment="Center">

                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:OrderProductLookupItem}">
                                    <StackPanel x:Name="ItemRowContainer" Orientation="Horizontal" Margin="4,2">
                                        <materialDesign:PackIcon x:Name="RowIcon" Kind="PackageVariant" Margin="0,0,6,0" VerticalAlignment="Center" Width="16" Height="16"/>
                                        <TextBlock x:Name="RowText" Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsBatchRow}" Value="True">
                                            <Setter TargetName="ItemRowContainer" Property="Margin" Value="20,0,0,0"/>
                                            <Setter TargetName="RowIcon" Property="Kind" Value="ArrowRightBottom"/>
                                            <Setter TargetName="RowIcon" Property="Foreground" Value="#1794A1"/>
                                            <Setter TargetName="RowText" Property="Opacity" Value="0.85"/>
                                        </DataTrigger>
                                </DataTemplate.Triggers>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBox Grid.Column="1" Grid.Row="2" Margin="10,0" Text="{Binding Quantity}" materialDesign:HintAssist.Hint="Quantity">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQuantityValid}" Value="False">
                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsQuantityValid}" Value="True">
                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        
                        <TextBox Grid.Column="2" Grid.Row="2" Margin="10,0" x:Name="RateTextBox" Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" materialDesign:HintAssist.Hint="Rate (Per Unit)">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPriceProfitable}" Value="False">
                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPriceProfitable}" Value="True">
                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CurrentStock, StringFormat='Stock: {0}'}" Margin="10,0" FontSize="11" Opacity="0.6"/>
                        <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding MinimumAllowedPrice, StringFormat='Min price: {0}'}" Margin="10,0" FontSize="11" Opacity="0.6"/>

                        <ComboBox Grid.Column="3" Grid.Row="2" ItemsSource="{Binding GstRates}" SelectedItem="{Binding GstPercent}" 
                      materialDesign:HintAssist.Hint="GST" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                        <TextBlock Grid.Column="1" Grid.Row="3" Margin="10,0" TextWrapping="Wrap"
                               Text="{Binding QuantityStatusText}" 
                               FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQuantityValid}" Value="True">
                                            <Setter Property="Foreground" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <TextBlock Grid.Column="2" Grid.Row="3" Margin="10,0" Text="{Binding PriceStatusText}" 
                               FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                               HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#4B5563"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPriceProfitable}" Value="False">
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPriceProfitable}" Value="True">
                                            <Setter Property="Foreground" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Column="4" Grid.Row="2" Content="Add to Cart" Command="{Binding AddToCartCommand}" 
                    Background="#1B8756" BorderBrush="#1B8756" Margin="10,0,0,0"/>
                    </Grid>
                </materialDesign:Card>

                <DataGrid Margin="0,10" ItemsSource="{Binding CartItems}" MaxHeight="150" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding ProductName}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="ForestGreen"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Batch / Lot No" Binding="{Binding BatchNumber}" Width="1.2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1794A1"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Rate" Binding="{Binding UnitPrice}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding SubTotal}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="GST" Binding="{Binding GstAmount, StringFormat='({0:N2})'}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" FontWeight="Bold" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Action" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Height="28" Width="28" Foreground="#2196F3">
                                            <materialDesign:PackIcon Kind="Pencil" Height="20" Width="20"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Height="28" Width="28" Foreground="#F44336"
                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Delete" Height="20" Width="20"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="Next" Command="{Binding NextStepCommand}" Margin="0,10" Background="#FF914D"/>

            </StackPanel>
            <ScrollViewer Height="550">
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource IntToVisibility}, ConverterParameter=2}">
                    <TextBlock Text="{Binding OrderValue, Mode=OneWay, StringFormat='Order Value: {0:N2}'}" FontWeight="Bold"/>
                    <materialDesign:ColorZone Mode="Standard" Padding="10" CornerRadius="3" Background="#E0E0E0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowDown" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding CartItems.Count, StringFormat='You cart has {0} items.'}"/>
                        </StackPanel>
                    </materialDesign:ColorZone>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Bill To" Grid.Column="0" Margin="5">
                            <TextBox Text="{Binding BillTo}" AcceptsReturn="True"/>
                        </GroupBox>
                        <GroupBox Header="Deliver To" Grid.Column="1" Margin="0,5">
                            <TextBox Text="{Binding DeliverTo}" AcceptsReturn="True"/>
                        </GroupBox>
                        <GroupBox Header="Terms &amp; Conditions" Grid.Column="2" Margin="5">
                            <TextBox Text="{Binding TermsAndConditions}" AcceptsReturn="True"/>
                        </GroupBox>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="5">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" 
                Command="{Binding AddExtraChargeCommand}"
                Style="{StaticResource MaterialDesignFloatingActionMiniButton}" 
                Background="#FF914D" BorderBrush="#FF914D"
                Width="30" Height="30" VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="Plus" Foreground="White"/>
                                </Button>
                                <TextBlock Text="Other Charges/discounts" Opacity="0.6" VerticalAlignment="Center"/>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding OtherCharges}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Text="{Binding Name}" materialDesign:HintAssist.Hint="e.g. carriage" Margin="2"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding Action}" Margin="2"/>
                                            <TextBox Grid.Column="2" Text="{Binding Value}" materialDesign:HintAssist.Hint="Value" Margin="2"/>
                                            <ComboBox Grid.Column="3" ItemsSource="{Binding GstOptions}" SelectedItem="{Binding GstPercent}" Margin="2"/>

                                            <Button Grid.Column="4" Content="x" 
                            Command="{Binding DataContext.RemoveExtraChargeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Background="#E91E63" BorderBrush="#E91E63" 
                            Width="25" Height="25" Padding="0" Margin="2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="15,0">
                            <TextBlock Text="Grand Value" Opacity="0.6" Margin="0,0,0,5"/>
                            <materialDesign:Card Background="White" Padding="10" Margin="0,0,0,15">
                                <TextBlock Text="{Binding CalculatedGrandValue, StringFormat='{}{0:N2}'}" 
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </materialDesign:Card>

                            <TextBox materialDesign:HintAssist.Hint="Prefered Transport" 
                 Text="{Binding PreferedTransport}" 
                 Margin="0,0,0,10"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <CheckBox Content="Send Email" 
                  IsChecked="{Binding SendEmail}" 
                  Style="{StaticResource MaterialDesignFilterChipPrimaryCheckBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Grid.Column="2">
                            <StackPanel>
                                <TextBlock Text="Remarks" Opacity="0.6" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Remarks}" 
                 AcceptsReturn="True" 
                 Height="100" 
                 VerticalContentAlignment="Top"
                 materialDesign:HintAssist.Hint="Add internal notes here..." 
                 Style="{StaticResource MaterialDesignFilledTextBox}"/>
                            </StackPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Next Followup Date *"/>
                                    <DatePicker SelectedDate="{Binding NextFollowupDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayDateStart="{Binding MinDate}" Margin="0,5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

                                    <TextBlock Text="Next Followup Time" Foreground="#555" Margin="0,0,0,5"/>

                                    <materialDesign:TimePicker SelectedTime="{Binding SelectedTime}" Is24Hours="False" materialDesign:HintAssist.Hint="Pick Time" materialDesign:TextFieldAssist.HasClearButton="True" VerticalAlignment="Center" xml:lang="en-IN" />

                                    <TextBlock Text="Clock icon appears on hover/focus" FontSize="10" FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                        <Button Content="Back" Command="{Binding BackCommand}" 
            Style="{StaticResource MaterialDesignFlatButton}" Width="100" Margin="5"/>
                        <Button Content="Submit" Command="{Binding SubmitOrderCommand}" 
            Background="#FF914D" BorderBrush="#FF914D" Width="120" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
