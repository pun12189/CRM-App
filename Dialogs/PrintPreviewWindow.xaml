<Window x:Class="Tijori.Dialogs.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tijori.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tax Invoice Print Preview" 
        Height="768" Width="1024" 
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid Margin="12">
        <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True">
            <!-- Full WPF DocumentViewer with built-in Zoom, Page Selector & Print Toolbar -->
            <DocumentViewer x:Name="DocViewer" />
        </Border>
    </Grid>
</Window>
