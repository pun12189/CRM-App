<UserControl x:Class="Tijori.Views.OrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:Tijori.Converters"
             xmlns:model="clr-namespace:Tijori.Models"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100"
             Background="#F8FAFC">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <model:BindingProxy x:Key="DataContextProxy" Data="{Binding}" />
        <conv:LessThanZeroToBoolConverter x:Key="LessThanZeroToBoolConverter"/>
        <!-- Tab Header Style -->
        <Style x:Key="ModernTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Bar with Back Button & Order ID -->
            <RowDefinition Height="*"/>
            <!-- Main Content Container with Tabs -->
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- TOP NAVIGATION BAR (BACK BUTTON & ORDER TITLE)                   -->
        <!-- ================================================================= -->
        <materialDesign:Card Grid.Row="0" Padding="12,8" Margin="0,0,0,16" Background="White" materialDesign:ElevationAssist.Elevation="Dp1">
            <DockPanel LastChildFill="True">
                <!-- Back Button to Return to Main Orders List -->
                <Button Command="{Binding BackToOrdersCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="#1794A1" Foreground="#1794A1"
                        Height="36" Padding="12,0" DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Back to Orders" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Order Title Indicator -->
                <TextBlock Text="{Binding SelectedOrder.FormattedOrderId, FallbackValue='KLK00001071'}" 
                           FontSize="20" FontWeight="Bold" Foreground="#1E293B" 
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </materialDesign:Card>

        <!-- ================================================================= -->
        <!-- MAIN TAB CONTROL CONTAINER                                         -->
        <!-- ================================================================= -->
        <materialDesign:Card Grid.Row="1" Background="White" materialDesign:ElevationAssist.Elevation="Dp1">
            <TabControl Style="{StaticResource MaterialDesignTabControl}" SelectedIndex="{Binding SelectedTabWorkspaceIndex}">

                <!-- ========================================================= -->
                <!-- TAB 1: ORDER DETAILS                                      -->
                <!-- ========================================================= -->
                <TabItem Header="Order Details" Style="{StaticResource ModernTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>

                            <!-- Action Header Bar -->
                            <DockPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                    <TextBlock Text="Order Status: " FontSize="16" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                    <Border Background="#F59E0B" CornerRadius="4" Padding="10,4" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding SelectedOrder.Status, FallbackValue='Pending'}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Command="{Binding SendEmailInvoiceCommand}" Content="Send Invoice on email" 
                                            Background="#F97316" BorderBrush="#F97316" Foreground="White" 
                                            Margin="0,0,10,0" Style="{StaticResource MaterialDesignRaisedButton}"/>

                                    <Button Command="{Binding SendWhatsappInvoiceCommand}" Content="Send Invoice on Whatsapp" 
                                            Background="#25D366" BorderBrush="#25D366" Foreground="White" 
                                            Margin="0,0,10,0" Style="{StaticResource MaterialDesignRaisedButton}"/>

                                    <Button Command="{Binding AcceptOrderCommand}" Content="Accept Order" 
                                            Background="#0D9488" BorderBrush="#0D9488" Foreground="White" 
                                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Customer Information Block -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                                <UniformGrid Columns="3">
                                    <!-- Column 1: Core Name & Tax IDs -->
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{Binding SelectedLead.CustomerName, StringFormat='Name: {0}', FallbackValue='Name: N/A'}" 
                                            FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>

                                        <TextBlock Text="{Binding SelectedLead.CompanyName, StringFormat='C/O: {0}', FallbackValue='C/O: N/A'}" 
                                            Foreground="#64748B" Margin="0,0,0,4"/>

                                        <!--<TextBlock Text="{Binding SelectedLead.Gstin, StringFormat='GSTIN: {0}', FallbackValue='GSTIN: N/A'}" 
                                            Foreground="#64748B"/>-->
                                    </StackPanel>

                                    <!-- Column 2: Contact Numbers & WhatsApp -->
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{Binding SelectedLead.Email, StringFormat='Email: {0}', FallbackValue='Email: N/A'}" 
                                            Foreground="#64748B" Margin="0,0,0,4"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding SelectedLead.Phone, StringFormat='Phone: {0}', FallbackValue='Phone: N/A'}" 
                                            Foreground="#0284C7" FontWeight="SemiBold"/>
                                            <materialDesign:PackIcon Kind="Whatsapp" Foreground="#25D366" Width="16" Height="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding SelectedLead.AlternateNumber, StringFormat='Alternate Number: {0}', FallbackValue='Alternate Number: N/A'}" 
                                            Foreground="#64748B"/>
                                    </StackPanel>

                                    <!-- Column 3: Address & Transport -->
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedLead.Address, StringFormat='Address: {0}', FallbackValue='Address: N/A'}" 
                                            Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                        <TextBlock Text="{Binding SelectedOrder.PreferedTransport, StringFormat='Preferred Transport: {0}', FallbackValue='Preferred Transport: N/A'}" 
                                            Foreground="#64748B"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <!-- Order ID and Date Bar -->
                            <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                                <Grid>
                                    <TextBlock Text="{Binding SelectedOrder.FormattedOrderId, StringFormat='Order ID: {0}', FallbackValue='Order ID: KLK00001071'}" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding SelectedOrder.CreatedDate, StringFormat='Order Date: {0:yyyy-MM-dd HH:mm:ss}', FallbackValue='Order Date: 2026-05-30 18:10:10'}" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,24">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <!-- Displays this panel ONLY if there are no itemized products -->
                                            <DataTrigger Binding="{Binding SelectedOrder.Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <materialDesign:PackIcon Kind="Receipt" Foreground="#1794A1" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Flat-Amount / Direct Summary Order" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="This order was booked as a direct lump-sum figure without itemized product line-items." Foreground="#64748B" FontSize="13"/>
                                    </StackPanel>

                                    <!-- Main Display Badge for Flat Total -->
                                    <Border Grid.Column="1" Background="#CCFBF1" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="6" Padding="20,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Total Amount: " FontSize="14" FontWeight="SemiBold" Foreground="#0F766E" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedOrder.TotalAmount, StringFormat='₹ {0:N2}', FallbackValue='₹ 5,000.00'}" 
                                           FontSize="20" FontWeight="Black" Foreground="#0D9488" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>


                            <!-- ================================================================= -->
                            <!-- MODE B: ITEMIZED PRODUCTS GRID (When Items.Count > 0)             -->
                            <!-- ================================================================= -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <!-- Hides the products table if this is a flat-amount order -->
                                            <DataTrigger Binding="{Binding SelectedOrder.Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Ordered Products" FontWeight="Bold" FontSize="14" Foreground="#334155" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding SelectedOrder.Items}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" BorderThickness="0,1,0,1" BorderBrush="#E2E8F0" Margin="0,0,0,20">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding ProductName}" Width="*"/>
                                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="Auto"/>
                                        <DataGridTextColumn Header="Batch no." Binding="{Binding BatchNumber}" Width="Auto"/>
                                        <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat='yyyy-MM-dd'}" Width="Auto"/>
                                        <DataGridTextColumn Header="MRP" Binding="{Binding UnitPrice, StringFormat='₹ {0:N2}'}" Width="Auto"/>
                                        <DataGridTextColumn Header="Subtotal" Binding="{Binding SubTotal, StringFormat='₹ {0:N2}'}" Width="Auto"/>
                                        <DataGridTextColumn Header="GST" Binding="{Binding GstPercent, StringFormat='{}{0}%'}" Width="Auto"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='₹ {0:N2}'}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>


                            <!-- ================================================================= -->
                            <!-- EXTRA CHARGES TABLE (Appears for both modes if ExtraCharges exist)-->
                            <!-- ================================================================= -->
                            <StackPanel Margin="0,0,0,24">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedOrder.ExtraCharges.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Extra Charges &amp; Adjustments" FontWeight="Bold" FontSize="14" Foreground="#334155" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding SelectedOrder.ExtraCharges}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" BorderThickness="0,1,0,1" BorderBrush="#E2E8F0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Charge Name" Binding="{Binding Name}" Width="*"/>

                                        <!-- Action (Add or Subtract) -->
                                        <DataGridTextColumn Header="Type" Binding="{Binding Action}" Width="120"/>

                                        <!-- Base Value -->
                                        <DataGridTextColumn Header="Base Amount" Binding="{Binding Value, StringFormat='₹ {0:N2}'}" Width="150"/>

                                        <!-- GST Percent -->
                                        <DataGridTextColumn Header="GST %" Binding="{Binding GstPercent, StringFormat='{}{0}%'}" Width="100"/>

                                        <!-- Total Net Charge -->
                                        <DataGridTextColumn Header="Net Charge" Binding="{Binding TotalCharge, StringFormat='₹ {0:N2}'}" Width="150">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>


                            <!-- ================================================================= -->
                            <!-- BOTTOM NOTE & SUMMARY CALCULATION CARD                            -->
                            <!-- ================================================================= -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="350"/>
                                </Grid.ColumnDefinitions>

                                <!-- Order Note / Description -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Note / Description:" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedOrder.Description, FallbackValue='N/A'}" Foreground="#334155" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Grand Totals Summary Box -->
                                <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                                    <StackPanel>

                                        <!-- Shows Products Subtotal ONLY if there are products -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedOrder.Items.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Grid Margin="12,8">
                                                <TextBlock Text="Products Subtotal:" Foreground="#64748B" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding SubTotalAmount, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Separator Background="#E2E8F0" Margin="0"/>
                                            <Grid Margin="12,8">
                                                <TextBlock Text="Products GST:" Foreground="#64748B" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding TotalGstAmount, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Separator Background="#E2E8F0" Margin="0"/>
                                        </StackPanel>

                                        <!-- Base Amount for Flat Orders -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedOrder.Items.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Margin="12,8">
                                                <TextBlock Text="Order Amount:" Foreground="#64748B" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding SelectedOrder.TotalAmount, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Separator Background="#E2E8F0" Margin="0"/>
                                        </StackPanel>

                                        <!-- Extra Charges Line (Shown if ExtraCharges exist) -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedOrder.ExtraCharges.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Margin="12,8">
                                                <TextBlock Text="Extra Charges / Fees:" Foreground="#64748B" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ExtraChargesSum, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" Foreground="#D97706" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Separator Background="#E2E8F0" Margin="0"/>
                                        </StackPanel>

                                        <!-- Final Grand Total -->
                                        <Grid Margin="12,12" Background="#F8FAFC">
                                            <TextBlock Text="Invoice Grand Total:" FontWeight="Bold" FontSize="14" Foreground="#1E293B" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding GrandTotal, StringFormat='₹ {0:N2}'}" FontWeight="Black" FontSize="18" Foreground="#1794A1" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================================= -->
                <!-- TAB 2: ORDER PAYMENT DETAILS                              -->
                <!-- ========================================================= -->
                <TabItem Header="Order Payment Details" Style="{StaticResource ModernTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>

                            <!-- Top Action & Status Header Bar -->
                            <DockPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                    <TextBlock Text="Payment Status: " FontSize="16" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>

                                    <!-- Dynamic Payment Status Badge -->
                                    <Border CornerRadius="4" Padding="10,4" Margin="8,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EF4444"/>
                                                <!-- Red for Unpaid -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OrderPaymentStatusBadge}" Value="Partially Paid">
                                                        <Setter Property="Background" Value="#F59E0B"/>
                                                        <!-- Amber -->
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OrderPaymentStatusBadge}" Value="Fully Paid">
                                                        <Setter Property="Background" Value="#10B981"/>
                                                        <!-- Green -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding OrderPaymentStatusBadge, FallbackValue='Unpaid'}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <!-- Action to invoke existing Payment Dialog -->
                                    <Button Command="{Binding OpenAddPaymentDialogCommand}" Content="Add Payment" 
                                        Background="#1794A1" BorderBrush="#1794A1" Foreground="White" 
                                        Margin="0,0,10,0" Style="{StaticResource MaterialDesignRaisedButton}">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="PlusCircle" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Record Payment" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                    <Button Command="{Binding DispatchOrderCommand}" Content="Dispatch Order" 
                            Background="#F97316" BorderBrush="#F97316" Foreground="White" 
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Outstanding & Paid Financial Badges Bar -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                                <UniformGrid Columns="3">

                                    <!-- Grand Invoice Value -->
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="16,10" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="Total Invoice: " Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding GrandTotal, StringFormat='₹ {0:N2}', FallbackValue='₹ 5,000.00'}" Foreground="#0F172A" FontWeight="Black" FontSize="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Paid Badge -->
                                    <Border Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="16,10" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="Total Received: " Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalPaymentsReceived, StringFormat='₹ {0:N2}', FallbackValue='₹ 2,000.00'}" Foreground="#16A34A" FontWeight="Black" FontSize="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Outstanding Balance Badge -->
                                    <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="16,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="Outstanding: " Foreground="#B91C1C" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding OutstandingPaymentBalance, StringFormat='₹ {0:N2}', FallbackValue='₹ 3,000.00'}" Foreground="#DC2626" FontWeight="Black" FontSize="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                </UniformGrid>
                            </Border>

                            <!-- ========================================================= -->
                            <!-- PAYMENTS LEDGER TABLE                                     -->
                            <!-- ========================================================= -->
                            <TextBlock Text="Payment Transactions Ledger" FontWeight="Bold" FontSize="14" Foreground="#334155" Margin="0,0,0,8"/>

                            <DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" BorderThickness="0,1,0,1" BorderBrush="#E2E8F0">

                                <!-- Fallback empty indicator message -->
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                                                <Setter Property="Background" Value="#FAF5FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>

                                <DataGrid.Columns>
                                    <!-- Payment ID -->
                                    <DataGridTextColumn Header="Payment ID" Binding="{Binding PaymentId, StringFormat='PAY-{0:D6}'}" Width="120"/>

                                    <!-- Transaction Date -->
                                    <DataGridTextColumn Header="Payment Date" Binding="{Binding DisplayDate, FallbackValue='29 May 2026'}" Width="150"/>

                                    <!-- Payment Method (Cash, GPay, Bank, etc.) -->
                                    <DataGridTemplateColumn Header="Method" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding PaymentMethod, FallbackValue='Bank Transfer'}" Foreground="#334155" FontSize="12" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Amount Processed -->
                                    <DataGridTextColumn Header="Amount" Binding="{Binding AmountReceived, StringFormat='₹ {0:N2}'}" Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Remaining Order Balance Snapshot -->
                                    <DataGridTextColumn Header="Remaining Balance" Binding="{Binding BalanceAmount, StringFormat='₹ {0:N2}'}" Width="160"/>

                                    <!-- Remarks / Notes -->
                                    <DataGridTextColumn Header="Remarks / Notes" Binding="{Binding Remarks}" Width="*"/>

                                    <!-- Transaction Type Badge (Credit vs Debit) -->
                                    <DataGridTemplateColumn Header="Type" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Check if amount is positive (Credit) or negative/refund (Debit) -->
                                                <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <!-- Default: Credit (Payment In) -->
                                                            <Setter Property="Background" Value="#16A34A"/>
                                                            <Style.Triggers>
                                                                <!-- If amount is negative, switch badge to Red Debit -->
                                                                <DataTrigger Binding="{Binding AmountReceived, Converter={StaticResource LessThanZeroToBoolConverter}}" Value="True">
                                                                    <Setter Property="Background" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Credit (+)"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AmountReceived, Converter={StaticResource LessThanZeroToBoolConverter}}" Value="True">
                                                                        <Setter Property="Text" Value="Debit (-)"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================================= -->
                <!-- TAB 3: ORDER HISTORY                                      -->
                <!-- ========================================================= -->
                <TabItem Header="Order History" Style="{StaticResource ModernTabItemStyle}">
                    <local:OrderHistoryView/>
                </TabItem>

                <!-- ========================================================= -->
                <!-- TAB 4: ORDER DOCUMENTS                                    -->
                <!-- ========================================================= -->
                <TabItem Header="Documents" Style="{StaticResource ModernTabItemStyle}">
                    <materialDesign:DialogHost Identifier="DocumentTabDialogHost" DialogTheme="Inherit">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Top Inline Mini-Upload Dialog Block -->
                                <RowDefinition Height="*"/>
                                <!-- Single Central DataGrid Workspace -->
                            </Grid.RowDefinitions>

                            <!-- TOP BAR: STREAMLINED MINI-UPLOAD BAR PANEL -->
                            <materialDesign:Card Grid.Row="0" UniformCornerRadius="6" Padding="14,10" Margin="0,0,0,15" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                <DockPanel LastChildFill="True">

                                    <!-- RIGHT ACTION BUTTONS: Filter, Import, Export -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">

                                        <Button Command="{Binding ClearFiltersCommand}"
                        Visibility="{Binding IsFilterActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="#DC2626"
                        Height="36" Padding="10,0" Margin="0,0,8,0"
                        ToolTip="Reset all active filters">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FilterOff" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Clear Filter" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 1. FILTER BUTTON -->
                                        <Button Command="{Binding OpenFilterDialogCommand}"
        Style="{StaticResource MaterialDesignOutlinedButton}" 
        BorderBrush="#64748B" Foreground="#334155"
        Height="36" Padding="12,0" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FilterVariant" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Filter" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 2. IMPORT BUTTON -->
                                        <Button Command="{Binding OpenImportDialogCommand}"
        Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#059669" BorderBrush="Transparent"
        Height="36" Padding="12,0" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Upload" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Import" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 3. EXPORT BUTTON WITH DROPDOWN MENU -->
                                        <!-- EXPORT BUTTON WITH DROPDOWN MENU -->
                                        <materialDesign:PopupBox
         PlacementMode="BottomAndAlignRightEdges"
         ToolTip="Export Documents"
         Height="36" Padding="0">
                                            <materialDesign:PopupBox.ToggleContent>
                                                <Border Background="#2563EB" CornerRadius="4" Padding="12,0" Height="36">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Download" Foreground="White" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Export" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <materialDesign:PackIcon Kind="ChevronDown" Foreground="White" Width="16" Height="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </materialDesign:PopupBox.ToggleContent>

                                            <!-- FIXED WIDER CONTAINER (Width="190") TO PREVENT TEXT TRUNCATION -->
                                            <StackPanel Background="White" Margin="4">

                                                <!-- 1. ALL -->
                                                <MenuItem Command="{Binding ExportZipCommand}" 
  CommandParameter="All"
  Padding="8,6" Margin="0">
                                                    <MenuItem.Header>
                                                        <TextBlock Text="ALL" FontWeight="SemiBold" Foreground="#1E293B" Margin="-10,0,0,0"/>
                                                    </MenuItem.Header>
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="FolderZip" Foreground="#2563EB" Width="18" Height="18"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <!-- 2. FILTERED -->
                                                <MenuItem Command="{Binding ExportZipCommand}" 
  CommandParameter="Filtered"
  IsEnabled="{Binding IsFilteredEnabled}"
  Padding="8,6" Margin="0">
                                                    <MenuItem.Header>
                                                        <TextBlock Text="Filtered" FontWeight="SemiBold" Margin="-10,0,0,0"/>
                                                    </MenuItem.Header>
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="Filter" Foreground="#D97706" Width="18" Height="18"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <!-- 3. SELECTED -->
                                                <MenuItem Command="{Binding ExportZipCommand}" 
  CommandParameter="Selected"
  IsEnabled="{Binding IsSelectedEnabled}"
  Padding="8,6" Margin="0">
                                                    <MenuItem.Header>
                                                        <TextBlock Text="Selected" FontWeight="SemiBold" Margin="-10,0,0,0"/>
                                                    </MenuItem.Header>
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="CheckboxMarked" Foreground="#059669" Width="18" Height="18"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                            </StackPanel>
                                        </materialDesign:PopupBox>
                                    </StackPanel>

                                    <!-- LEFT SUMMARY TEXT -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FolderFile" Foreground="#2563EB" Width="22" Height="22" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DocumentCountSummaryText}" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </materialDesign:Card>

                            <!-- BOTTOM PORTION: CENTRAL COMPLIANCE DATA TABLE GRID -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DisplayedDocuments, IsAsync=True}" AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox Command="{Binding Data.ToggleSelectAllCommand, Source={StaticResource DataContextProxy}}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Color-Coded Category Label Column -->
                                    <DataGridTemplateColumn Header="Category Classification" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" Foreground="#334155"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Dynamic filename metadata column rows values mapping -->
                                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="3.5*" IsReadOnly="True" FontWeight="Medium"/>
                                    <DataGridTextColumn Header="Uploaded By User" Binding="{Binding UploadedBy}" Width="1.5*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Date Logged" Binding="{Binding UploadedAt, StringFormat={}{0:dd-MM-yyyy hh:mm tt}}" Width="2*" IsReadOnly="True"/>

                                    <!-- CONTEXT COMPONENT ACTIONS PANEL ROUTE -->
                                    <DataGridTemplateColumn Header="Actions" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                                                    <Button Command="{Binding DataContext.ReplaceDocumentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#F59E0B" BorderBrush="Transparent" 
                                Padding="0" Width="28" Height="28" Margin="0,0,6,0" ToolTip="Replace / Overwrite File">
                                                        <materialDesign:PackIcon Kind="FileReplace" Foreground="White" Width="14" Height="14"/>
                                                    </Button>

                                                    <Button Command="{Binding DataContext.DownloadDocumentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#0284C7" BorderBrush="Transparent" 
                                Padding="0" Width="28" Height="28" Margin="0,0,6,0" ToolTip="Download File to System">
                                                        <materialDesign:PackIcon Kind="Download" Foreground="White" Width="14" Height="14"/>
                                                    </Button>

                                                    <Button Command="{Binding DataContext.DeleteDocumentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#DC2626" BorderBrush="Transparent" 
                                Padding="0" Width="28" Height="28" ToolTip="Delete Document Permanently">
                                                        <materialDesign:PackIcon Kind="Delete" Foreground="White" Width="14" Height="14"/>
                                                    </Button>

                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:DialogHost>
                </TabItem>

            </TabControl>
        </materialDesign:Card>
    </Grid>
</UserControl>
