<Window x:Class="Tijori.Dialogs.CreateLedgerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tijori.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Create Ledger" Height="650" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title Bar -->
                <RowDefinition Height="*"/>
                <!-- Form Fields -->
                <RowDefinition Height="Auto"/>
                <!-- Footer Button -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Create Ledger" FontSize="18" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                <Button Command="{Binding CloseCommand}"
                        Style="{StaticResource MaterialDesignIconButton}" 
                        HorizontalAlignment="Right" Width="28" Height="28" Padding="0">
                    <materialDesign:PackIcon Kind="CloseCircleOutline" Width="22" Height="22" Foreground="#64748B"/>
                </Button>
            </DockPanel>

            <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#F1F5F9" Margin="-24,0,-24,0"/>

            <!-- FORM CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel>

                    <!-- SELECT CUSTOMER -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Select Customer" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                            <TextBlock Text=" *" Foreground="#EF4444" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>

                        <ComboBox ItemsSource="{Binding Customers}" 
                                  SelectedItem="{Binding SelectedCustomer}"
                                  DisplayMemberPath="CustomerName"
                                  Padding="10,8" Height="38"
                                  BorderBrush="#CBD5E1" BorderThickness="1"
                                  Background="White">
                            <ComboBox.Resources>
                                <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
                            </ComboBox.Resources>
                        </ComboBox>

                        <!-- Loading Indicator Text -->
                        <TextBlock Text="{Binding LoadingStatusText}" 
                                   Foreground="#16A34A" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding IsLoadingCustomers, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- SELECT ORDER -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Select Order" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                            <TextBlock Text=" *" Foreground="#EF4444" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>

                        <ComboBox ItemsSource="{Binding Orders}" 
                                  SelectedItem="{Binding SelectedOrder}"
                                  DisplayMemberPath="FormattedOrderId"
                                  Padding="10,8" Height="38"
                                  BorderBrush="#CBD5E1" BorderThickness="1"
                                  Background="White"/>
                    </StackPanel>

                    <!-- AMOUNT -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total Pending" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PendingBalance, StringFormat='₹ {0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="New Remaining" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RemainingBalance, StringFormat='₹ {0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DYNAMIC FUN MOOD BANNER -->
                    <Border Background="{Binding MoodBadgeColor}" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                        <DockPanel>
                            <TextBlock Text="{Binding MoodEmoji}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding MoodMessage}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <!-- AMOUNT (WITH CAP) -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Amount" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                            <TextBlock Text=" *" Foreground="#EF4444" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="{Binding PendingBalance, StringFormat=' (Max: ₹ {0:N0})'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                                 materialDesign:HintAssist.Hint="Enter Amount"
                                 Padding="10,8" Height="38"
                                 BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>

                    <!-- TRANSACTION DATE -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Transaction Date" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                            <TextBlock Text=" *" Foreground="#EF4444" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>

                        <DatePicker SelectedDate="{Binding TransactionDate}" 
                                    Padding="10,8" Height="38"
                                    BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                    </StackPanel>

                    <!-- MESSAGE -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Message" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                            <TextBlock Text=" *" Foreground="#EF4444" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>

                        <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Enter message"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                                 Padding="10,8"
                                 BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Separator Grid.Row="1" VerticalAlignment="Bottom" Background="#F1F5F9" Margin="-24,0,-24,0"/>

            <!-- SUBMIT BUTTON -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Command="{Binding SubmitCommand}" 
                        Content="Submit" 
                        Background="#FF8A48" BorderBrush="#FF8A48" Foreground="White" 
                        Width="100" Height="36" FontWeight="SemiBold"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
