<Window x:Class="CallMan.Dialogs.AddDivisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        mc:Ignorable="d"
        Icon="/Assets/opn.png"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Add New Division" Height="300" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="CREATE NEW DIVISION" FontSize="18" FontWeight="Bold" 
                       Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,20"/>

            <TextBox x:Name="txtDivisionName" 
                     Text="{Binding NewDivision.Name, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Division / Branch Name"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Margin="0,0,0,15"/>            

            <CheckBox IsChecked="{Binding NewDivision.IsActive}" 
                      Content="Active and Operational" 
                      Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" IsCancel="True" 
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>

                <Button Content="CREATE DIVISION" 
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Width="150" Background="#1B8756" BorderBrush="#1B8756"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
