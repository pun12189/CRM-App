<UserControl x:Class="Tijori.Views.FilterDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="380" Padding="20" Background="White">
    <StackPanel>
        <TextBlock Text="Filter Documents" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- 1. Category Filter -->
        <ComboBox materialDesign:HintAssist.Hint="Select Category"
                  ItemsSource="{Binding AvailableDocumentCategories}"
                  DisplayMemberPath="CategoryName"
                  SelectedItem="{Binding FilterCategory}"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12"/>

        <!-- 2. Date Logged Filter -->
        <DatePicker materialDesign:HintAssist.Hint="Date Logged"
                    SelectedDate="{Binding FilterDateLogged}"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,12"/>

        <!-- 3. Logged User Filter -->
        <TextBox materialDesign:HintAssist.Hint="Logged User (Username)"
                 Text="{Binding FilterLoggedUser, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,20"/>

        <!-- Dialog Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" 
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
            <Button Content="Apply Filter" Command="{Binding ApplyFilterCommand}" 
                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#2563EB"/>
        </StackPanel>
    </StackPanel>
</UserControl>
