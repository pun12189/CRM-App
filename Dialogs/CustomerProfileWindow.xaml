<Window x:Class="CallMan.Dialogs.CustomerProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        xmlns:view="clr-namespace:CallMan.Views"
        mc:Ignorable="d" x:Name="cpView"
        Icon="/Assets/opn.png"
        Title="Customer Section" Height="700" Width="1024" WindowStartupLocation="CenterOwner">
    <view:CustomerProfileView DataContext="{Binding ElementName=cpView, Path=DataContext}"/>
</Window>
