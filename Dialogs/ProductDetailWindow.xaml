<Window x:Class="CallMan.Dialogs.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Icon="/Assets/opn.png" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="Product Details" Width="600" Height="Auto" SizeToContent="Height">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="16" Background="#F5F5F5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Add New Product Entry" 
                           FontSize="20" FontWeight="Bold" Foreground="#333333" Margin="5,0,5,15"/>

                <materialDesign:Card Grid.Row="1" Margin="5" Padding="12" UniformCornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Core Specifications" FontSize="14" FontWeight="SemiBold" Foreground="#1794A1" Margin="0,0,0,10"/>

                        <UniformGrid Columns="3">
                            <TextBox materialDesign:HintAssist.Hint="Product Name *" 
                                     Text="{Binding NewProduct.Name, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5"/>

                            <TextBox materialDesign:HintAssist.Hint="Short Name (Auto-Generated) *" 
                                     Text="{Binding NewProduct.ShortName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5"
                                     ToolTip="Must be completely unique across your catalogue."/>

                            <TextBox materialDesign:HintAssist.Hint="SKU (Stock Keeping Unit) *" 
                                     Text="{Binding NewProduct.SKU, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5"
                                     ToolTip="Used to send low-stock notification alerts."/>

                            <ComboBox materialDesign:HintAssist.Hint="Measurement Unit *" 
                                      SelectedValue="{Binding NewProduct.Unit, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Content"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="5">
                                <ComboBoxItem Content="Pcs"/>
                                <ComboBoxItem Content="Litres"/>
                                <ComboBoxItem Content="Boxes"/>
                                <ComboBoxItem Content="Meters"/>
                                <ComboBoxItem Content="Kgs"/>
                            </ComboBox>

                            <ComboBox materialDesign:HintAssist.Hint="Category Selection *" 
                                      ItemsSource="{Binding Categories}"
                                      SelectedValue="{Binding NewProduct.CategoryId}"
                                      SelectedValuePath="Id" DisplayMemberPath="CategoryName"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="5"/>

                            <TextBox materialDesign:HintAssist.Hint="Brand Name (Optional)" 
                                     Text="{Binding NewProduct.BrandName}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5"/>

                            <TextBox materialDesign:HintAssist.Hint="Manufacturer (Optional)" 
                                     Text="{Binding NewProduct.Manufacturer}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5"/>

                            <TextBox materialDesign:HintAssist.Hint="Packaging Configuration (Optional)" 
                                     Text="{Binding NewProduct.Packaging}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5"
                                     ToolTip="e.g., Pack of 10, Bottle of 500ml"/>
                        </UniformGrid>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="2" Margin="5,15,5,5" Padding="12" UniformCornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Initial Batch Setup &amp; Pricing Metrics" FontSize="14" FontWeight="SemiBold" Foreground="#1794A1" Margin="0,0,0,10"/>

                        <UniformGrid Columns="3">
                            <TextBox materialDesign:HintAssist.Hint="Batch Number/Lot Code *" 
                                     Text="{Binding TargetBatch.BatchNumber, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5"
                                     ToolTip="Validation: System flags an error immediately if this batch exists."/>

                            <TextBox materialDesign:HintAssist.Hint="Initial Batch Quantity Received *" 
                                     Text="{Binding TargetBatch.QuantityReceived, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5"/>

                            <TextBox materialDesign:HintAssist.Hint="Purchase Price (Min Selling Price) *" 
                                     Text="{Binding TargetBatch.MinimumSellingPrice, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5"/>

                            <TextBox materialDesign:HintAssist.Hint="Maximum Retail Price (MRP) *" 
                                     Text="{Binding NewProduct.MRP, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5"/>

                            <TextBox materialDesign:HintAssist.Hint="Standard Outbound Selling Price *" 
                                     Text="{Binding NewProduct.SellingPrice, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5"/>

                            <TextBox materialDesign:HintAssist.Hint="GST Percent (%)" 
                                     Text="{Binding NewProduct.GstPercent, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5"/>

                            <DatePicker materialDesign:HintAssist.Hint="Manufacturing Date (Mfg)" 
                                        SelectedDate="{Binding TargetBatch.MfgDate}"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="5"/>

                            <DatePicker materialDesign:HintAssist.Hint="Expiration Date (Expiry)" 
                                        SelectedDate="{Binding TargetBatch.ExpiryDate}"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="5"/>
                        </UniformGrid>
                    </StackPanel>
                </materialDesign:Card>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5,20,5,5">
                    <TextBlock Text="{Binding ValidationErrorMessage}" 
                               Foreground="#C62828" FontWeight="SemiBold" 
                               VerticalAlignment="Center" Margin="0,0,15,0"
                               Visibility="{Binding IsValidationErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="Reset Fields" 
                            Command="{Binding ClearFormCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Width="120" Margin="0,0,10,0"/>

                    <Button Content="Save Product" 
                            Command="{Binding SaveProductAssemblyCommand}"
                            Background="#1794A1" BorderBrush="#1794A1" Foreground="White"
                            Width="200"/>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
