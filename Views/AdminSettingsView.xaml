<UserControl x:Class="CallMan.Views.AdminSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CallMan.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <materialDesign:BooleanToVisibilityConverter x:Key="InverseBoolToVis" TrueValue="Collapsed" FalseValue="Visible" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="#F5F7F9" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Admin Settings" FontSize="24" FontWeight="Bold" Foreground="#1794A1" HorizontalAlignment="Left"/>
            <Button Command="{Binding BackToGridCommand}" 
                Visibility="{Binding IsMainGridVisible, Converter={StaticResource InverseBoolToVis}}"
                Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Right" Content="↑ Back to Settings" FontSize="15"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" Visibility="{Binding IsMainGridVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <VirtualizingStackPanel Orientation="Vertical">

                <materialDesign:Card Padding="20" Margin="5,0,5,16" Background="White" UniformCornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4">
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Left">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Network Connectivity Mode"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToggleVisible}" Value="False">
                                                <Setter Property="Text" Value="Cloud Environment Mode"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Allows cloud communications like external webhook automations, email server syncing, and background notifications."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToggleVisible}" Value="False">
                                                <Setter Property="Text" Value="TIJORI is running on an active cloud configuration environment. Core communications, webhooks, and live background synchronization pipelines are permanently operational."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⚠️ Keeping the software offline is highly recommended for isolated local office speeds."/>
                                        <Setter Property="Foreground" Value="#EA580C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToggleVisible}" Value="False">
                                                <Setter Property="Text" Value="✅ Cloud database synchronization pipelines are operating securely over a verified network connection."/>
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Command="{Binding ChangeDatabaseConfigCommand}" 
                                Content="🔧 Change Database Server Configuration" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="#2563EB" FontSize="12" FontWeight="SemiBold" 
                                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="0" Height="24"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock Width="65" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" FontWeight="Black">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="OFFLINE"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ToggleOnlineServices}" Value="True">
                                                <Setter Property="Text" Value="ONLINE"/>
                                                <Setter Property="Foreground" Value="#1794A1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToggleVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ToggleButton Cursor="Hand" VerticalAlignment="Center"
                                  IsChecked="{Binding ToggleOnlineServices, Mode=TwoWay}"
                                  Command="{Binding UpdateOnlineServicesOptionCommand}"
                                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                  ToolTip="Switch software modes between connected networks and completely local network layers.">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToggleVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <Expander Background="Transparent" Tag="1" Margin="5,10" BorderThickness="1" BorderBrush="Black" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsExpander1Open, Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <materialDesign:PackIcon Kind="Build" VerticalAlignment="Center" Height="24" Width="24"/>
                            <TextBlock Text="Internal Setup" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <UniformGrid Columns="4" VerticalAlignment="Top">
                        <Button Style="{StaticResource SettingTileStyle}" Content="Divisions" CommandParameter="CProfile" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Departments" Visibility="Collapsed" CommandParameter="Departments" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Staff" CommandParameter="Staff" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Order Stages" CommandParameter="OrderStages" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Content="Custom Fields" Style="{StaticResource SettingTileStyle}" CommandParameter="CustomFields" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Item Categories" CommandParameter="Category" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Proforma Settings" IsEnabled="False" CommandParameter="Fetch" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Notice Board" IsEnabled="False" CommandParameter="Notice" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Login Logs" CommandParameter="Logs" Command="{Binding NavigateToSettingCommand}"/>
                    </UniformGrid>
                </Expander>

                <Expander Background="Transparent" Tag="2" Margin="5,10" BorderThickness="1" BorderBrush="Black" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsExpander2Open, Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <materialDesign:PackIcon Kind="Settings" VerticalAlignment="Center" Height="24" Width="24"/>
                            <TextBlock Text="Lead Settings" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <UniformGrid Columns="4" VerticalAlignment="Top">
                        <Button Content="Add New Location" Style="{StaticResource SettingTileStyle}" IsEnabled="False"/>
                        <Button Content="Dead Reasons" Style="{StaticResource SettingTileStyle}" CommandParameter="Dead Reasons" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Content="Followup Stages" Style="{StaticResource SettingTileStyle}" CommandParameter="Followup Stages" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Content="Mature Stages" Style="{StaticResource SettingTileStyle}" CommandParameter="Mature Stages" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Content="Lead Categories" Style="{StaticResource SettingTileStyle}" CommandParameter="Lead Tags" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Content="Lead Source" Style="{StaticResource SettingTileStyle}" CommandParameter="Lead Source" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Content="Lead Label" Style="{StaticResource SettingTileStyle}" CommandParameter="Lead Labels" Command="{Binding NavigateToSettingCommand}"/>
                    </UniformGrid>
                </Expander>

                <Expander Background="Transparent" Tag="3" Margin="5,10" BorderThickness="1" BorderBrush="Black" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsExpander3Open, Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <materialDesign:PackIcon Kind="SourceMerge" VerticalAlignment="Center" Height="24" Width="24"/>
                            <TextBlock Text="Third Party Integrations" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <UniformGrid Columns="4" VerticalAlignment="Top">
                        <Button Style="{StaticResource SettingTileStyle}" Content="Connect Email" CommandParameter="Email" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Connect Whatsapp" CommandParameter="Whatsapp" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Connect CallMan" CommandParameter="CallMan" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Connect ECom" CommandParameter="ECom" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Marg/Tally etc." CommandParameter="MargTally" Command="{Binding NavigateToSettingCommand}"/>
                    </UniformGrid>
                </Expander>

                <Expander Background="Transparent" Tag="4" Margin="5,10" BorderThickness="1" BorderBrush="Black" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsExpander4Open, Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <materialDesign:PackIcon Kind="Automatic" VerticalAlignment="Center" Height="24" Width="24"/>
                            <TextBlock Text="Automations" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <UniformGrid Columns="4" VerticalAlignment="Top">
                        <Button Style="{StaticResource SettingTileStyle}" Content="Templates" IsEnabled="False" CommandParameter="Templates" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Enable AI" CommandParameter="Workflows" Command="{Binding NavigateToSettingCommand}"/>
                    </UniformGrid>
                </Expander>

            </VirtualizingStackPanel>
        </ScrollViewer>

        <ContentControl Grid.Row="1" Content="{Binding CurrentSettingView}" 
                    Visibility="{Binding IsMainGridVisible, Converter={StaticResource InverseBoolToVis}}"/>
    </Grid>
</UserControl>
