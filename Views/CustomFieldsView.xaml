<UserControl x:Class="Tijori.Views.CustomFieldsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F8FAFC">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <materialDesign:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- 1. LEFT SIDEBAR NAVIGATION (MODULES) -->
            <ColumnDefinition Width="220"/>
            <!-- GAP -->
            <ColumnDefinition Width="16"/>
            <!-- 2. RIGHT WORKSPACE (DATAGRID & HEADER) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR: DOMAIN / MODULE SELECTOR -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
            <DockPanel>
                <TextBlock Text="SETTING MODULES" DockPanel.Dock="Top" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="8,4,0,12"/>

                <ListBox ItemsSource="{Binding AvailableModules}" 
                         SelectedItem="{Binding SelectedModule}"
                         Style="{StaticResource {x:Type ListBox}}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FolderOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#64748B"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- RIGHT WORKSPACE AREA -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP HEADER BAR -->
            <Border Grid.Row="0" Margin="0,0,0,15" Padding="12,10" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <TextBlock Text="{Binding SelectedModule}" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <TextBlock Text=" Custom Fields" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ModuleInfoNotice}" 
                                   FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" FontStyle="Italic" 
                                   Margin="24,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right">
                        <!-- ACTION MENU -->
                        <Menu Background="#FF8A3D" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Menu.Style>
                                <Style TargetType="Menu">
                                    <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4"/>
                                </Style>
                            </Menu.Style>
                            <MenuItem Header="Action" FontWeight="SemiBold" FontSize="13" Height="32" Padding="15,5" VerticalAlignment="Center"/>
                            <MenuItem Height="32" Width="30" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <MenuItem.Header>
                                    <materialDesign:PackIcon Kind="MenuDown" Width="20" Height="20" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </MenuItem.Header>
                                <MenuItem.Items>
                                    <MenuItem Header="Batch Delete Selection" Height="36" FontSize="12" FontWeight="SemiBold" Background="White" Foreground="#334155"/>
                                </MenuItem.Items>
                            </MenuItem>
                        </Menu>

                        <!-- ADD NEW BUTTON -->
                        <Button Content="Add New" 
                                Command="{Binding OpenCreateFieldDialogCommand}"
                                Padding="16,0" Height="34" Background="#1794A1" BorderBrush="#1794A1" 
                                Foreground="White" FontWeight="Bold" Style="{StaticResource MaterialDesignFlatSecondaryDarkBgButton}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- DATAGRID WORKSPACE -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding CustomFieldsSource, IsAsync=True}" AutoGenerateColumns="False" 
                      IsReadOnly="True" GridLinesVisibility="All" BorderBrush="#CBD5E1" BorderThickness="1" 
                      HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0" Background="White"
                      RowHeight="46" HeadersVisibility="Column">

                <DataGrid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- CHECKBOX COLUMN -->
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.Header>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>                   

                    <!-- FIELD NAME -->
                    <DataGridTextColumn Header="Field Name" Binding="{Binding FieldName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter Property="Margin" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- TYPE -->
                    <DataGridTextColumn Header="Type" Binding="{Binding FieldType}" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="Margin" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                     <!--MODULE TYPE-->
                    <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayLabel}" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="Margin" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- VALUE OPTIONS -->
                    <DataGridTemplateColumn Header="Value" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding SeedValueOptionsList}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='{}{0}, '}" FontSize="12" Foreground="#475569" FontWeight="Medium"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- REQUIRED -->
                    <DataGridTemplateColumn Header="Required" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="No" Foreground="#94A3B8" FontWeight="Medium" Visibility="{Binding IsRequired, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="Yes" Foreground="#DC2626" FontWeight="Bold" Visibility="{Binding IsRequired, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Header="Action" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding DataContext.EditFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="4" MinWidth="24" Height="24" Margin="0,0,6,0">
                                        <materialDesign:PackIcon Kind="Pencil" Foreground="#F59E0B" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding DataContext.DeleteFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="4" MinWidth="24" Height="24">
                                        <materialDesign:PackIcon Kind="TrashCan" Foreground="#EF4444" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
