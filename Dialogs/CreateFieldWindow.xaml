<Window x:Class="Tijori.Dialogs.CreateFieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tijori.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Field Configuration" Height="780" Width="1150" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" 
        Background="Transparent" AllowsTransparency="True" WindowStyle="None" 
        Icon="/Assets/opn.png" ShowInTaskbar="False">

    <Grid Margin="16">
        <Border Padding="20" Background="#F8FAFC" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="20" ShadowDepth="4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Command="{Binding CloseDialogCommand}" 
                            Style="{StaticResource MaterialDesignFlatButton}" Width="32" Height="32" Padding="0" Cursor="Hand">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#64748B"/>
                    </Button>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Target Scope: " FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ModuleType}" FontSize="13" Foreground="#1794A1" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ModuleInfoNotice}" FontSize="12" Foreground="#E11D48" FontStyle="Italic" Margin="16,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- 2-COLUMN MAIN BODY -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <!-- Col 1: Chips & Creator -->
                        <ColumnDefinition Width="20"/>
                        <!-- Spacer -->
                        <ColumnDefinition Width="1.8*"/>
                        <!-- Col 2: Registry DataGrid -->
                    </Grid.ColumnDefinitions>

                    <!-- ================= COLUMN 1: FIELD CATALOG & CREATOR ================= -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel Margin="10">

                                <!-- ROW 1 TOP: AVAILABLE MODEL FIELDS (TIER 2 CHIPS) -->
                                <TextBlock Text="Available System Fields" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                <TextBlock Text="Click a chip to edit its label or toggle advanced flags." FontSize="11" Foreground="#64748B" Margin="0,2,0,12"/>

                                <ItemsControl ItemsSource="{Binding StandardModelChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Outer Button configured to stay completely transparent without square backgrounds -->
                                            <Button Command="{Binding DataContext.SelectFieldForEditCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="6" 
                                                Margin="0,0,4,4" 
                                                Height="Auto"
                                                Cursor="Hand" 
                                                ToolTipService.InitialShowDelay="50"
                                                ToolTipService.BetweenShowDelay="0"
                                                ToolTipService.ShowDuration="12000">

                                                <Button.ToolTip>
                                                    <ToolTip MaxWidth="300" 
                                                         Background="#0F172A" 
                                                         Foreground="White" 
                                                         Padding="10,8" 
                                                         HasDropShadow="True">
                                                        <TextBlock Text="{Binding InfoTooltip}" 
                                                           TextWrapping="Wrap" 
                                                           FontSize="11" 
                                                           LineHeight="16"/>
                                                    </ToolTip>
                                                </Button.ToolTip>

                                                <!-- Inner Pill Border with Matching CornerRadius and Soft Shadow -->
                                                <Border Background="#EFF6FF" 
                                                    CornerRadius="16" 
                                                    Padding="12,6" 
                                                    BorderBrush="#93C5FD" 
                                                    BorderThickness="1">

                                                    <!-- SOFT ROUNDED PILL SHADOW -->
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#1E40AF" 
                                                          BlurRadius="10" 
                                                          ShadowDepth="2" 
                                                          Direction="270" 
                                                          Opacity="0.15"/>
                                                    </Border.Effect>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding EffectiveLabel}" 
                                                           FontSize="12" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#1E40AF" 
                                                           VerticalAlignment="Center"/>

                                                        <materialDesign:PackIcon Kind="InformationOutline" 
                                                             Width="14" 
                                                             Height="14" 
                                                             Margin="6,0,0,0" 
                                                             Foreground="#60A5FA">
                                                            <materialDesign:PackIcon.ToolTip>
                                                                <ToolTip MaxWidth="280">
                                                                    <TextBlock Text="{Binding InfoTooltip}" TextWrapping="Wrap" FontSize="11"/>
                                                                </ToolTip>
                                                            </materialDesign:PackIcon.ToolTip>
                                                        </materialDesign:PackIcon>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Margin="0,16" Background="#E2E8F0"/>

                                <!-- ROW 1 BOTTOM: USER CREATED CUSTOM FIELDS (TIER 3 CHIPS) -->
                                <!--<TextBlock Text="Custom Dynamic Fields" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                <TextBlock Text="Fields created manually for this module." FontSize="11" Foreground="#64748B" Margin="0,2,0,12"/>

                                <ItemsControl ItemsSource="{Binding CustomFieldChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            --><!-- Outer Button configured to stay completely transparent without square backgrounds --><!--
                                            <Button Command="{Binding DataContext.SelectFieldForEditCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="6" 
                                                Margin="0,0,4,4" 
                                                Height="Auto"
                                                Cursor="Hand">

                                                --><!-- Inner Pill Border with Matching CornerRadius and Soft Shadow --><!--
                                                <Border Background="#EFF6FF" 
                                                    CornerRadius="16" 
                                                    Padding="12,6" 
                                                    BorderBrush="#93C5FD" 
                                                    BorderThickness="1">

                                                    --><!-- SOFT ROUNDED PILL SHADOW --><!--
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#1E40AF" 
                                                          BlurRadius="10" 
                                                          ShadowDepth="2" 
                                                          Direction="270" 
                                                          Opacity="0.15"/>
                                                    </Border.Effect>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding EffectiveLabel}" 
                                                           FontSize="12" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#1E40AF" 
                                                           VerticalAlignment="Center"/>

                                                        <materialDesign:PackIcon Kind="InformationOutline" 
                                                             Width="14" 
                                                             Height="14" 
                                                             Margin="6,0,0,0" 
                                                             Foreground="#60A5FA" 
                                                             ToolTip="{Binding FieldType, StringFormat='Control Type: {0}'}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>-->

                                <!--<Separator Margin="0,16" Background="#E2E8F0"/>-->

                                <!-- FIELD CREATOR FORM -->
                                <TextBlock Text="Field Editor" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,16"/>

                                <!-- Field Name -->
                                <TextBox Text="{Binding NewField.FieldName, UpdateSourceTrigger=PropertyChanged}" 
                                         IsEnabled="{Binding IsFieldNameEditable}"
                                         materialDesign:HintAssist.Hint="Database Field Name (e.g. GSTNumber) *" 
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>

                                <!-- Display Label -->
                                <TextBox Text="{Binding NewField.DisplayLabel, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="Form Display Label (e.g. Enter GST) *" 
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>

                                <!-- Control Type -->
                                <ComboBox SelectedValue="{Binding NewField.FieldType}" SelectedValuePath="Content"
                                          IsEnabled="{Binding IsControlTypeEditable}"
                                          materialDesign:HintAssist.Hint="Control Type" 
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16">
                                    <ComboBoxItem Content="Textbox"/>
                                    <ComboBoxItem Content="TextArea"/>
                                    <ComboBoxItem Content="DropdownSingle"/>
                                    <ComboBoxItem Content="DropdownMultiple"/>
                                    <ComboBoxItem Content="CalendarClock"/>
                                </ComboBox>

                                <!-- Dropdown Options (Visible only if Dropdown type is selected) -->
                                <StackPanel Margin="0,0,0,16">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewField.FieldType}" Value="DropdownSingle">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NewField.FieldType}" Value="DropdownMultiple">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Dropdown Options" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewValueOptionText, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Type choice value..."
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Grid.Column="0" Margin="0,0,8,0">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AddValueOptionCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Command="{Binding AddValueOptionCommand}" Content="Add" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding NewField.SeedValueOptionsList}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <materialDesign:Chip Content="{Binding}" Margin="0,0,4,4" IsDeletable="True"
                                                                     DeleteCommand="{Binding DataContext.RemoveValueOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     DeleteCommandParameter="{Binding}" Background="#EFF6FF" Foreground="#1E40AF" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- SAVE BUTTON -->
                                <Button Content="Add To List" Command="{Binding SubmitCustomFieldCommand}" 
                                        Height="42" FontSize="14" FontWeight="Bold" Background="#0D9488" BorderBrush="#0D9488" Foreground="White"
                                        Style="{StaticResource MaterialDesignFlatDarkBgButton}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ================= COLUMN 2: CONFIGURED REGISTERED FIELDS LIST ================= -->
                    <!-- COLUMN 2: ACTIVE FORM REGISTRY & SUBMIT BUTTON -->
                    <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <!-- FOOTER ACTION ROW -->
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Active Form Fields &amp; Toggles" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,12"/>

                            <!-- DATAGRID LIST -->
                            <!-- ACTIVE FORM REGISTRY DATAGRID -->
                            <DataGrid Grid.Row="1" 
          ItemsSource="{Binding RegisteredFieldsList}" 
          AutoGenerateColumns="False" 
          CanUserAddRows="False" 
          HeadersVisibility="Column" 
          Background="Transparent"
          GridLinesVisibility="Horizontal" 
          HorizontalGridLinesBrush="#F1F5F9" 
          BorderThickness="0"
          RowHeight="52" 
          VerticalScrollBarVisibility="Auto">

                                <DataGrid.Resources>
                                    <!-- TRANSPARENT SELECTION HIGHLIGHT -->
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>

                                    <!-- CLEAN MODERN HEADER STYLE -->
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Height" Value="36"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>

                                    <!-- 1. FIELD MAPPING -->
                                    <DataGridTemplateColumn Header="Field Mapping" Width="1.8*">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                <Setter Property="Padding" Value="12,0,0,0"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding FieldName}" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 2. INPUT TYPE -->
                                    <DataGridTextColumn Header="Type" 
                            Binding="{Binding FieldType}" 
                            Width="1.1*" 
                            Foreground="#475569" 
                            FontSize="12" 
                            ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>

                                    <!-- 3. REQUIRED TOGGLE -->
                                    <DataGridTemplateColumn Width="72">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="Req." ToolTip="Is Mandatory Field?" TextAlignment="Center"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsRequired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              Command="{Binding DataContext.UpdateFieldFlagsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                              CommandParameter="{Binding}" 
                              HorizontalAlignment="Center">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FieldTier}" Value="1">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 4. FILTER TOGGLE -->
                                    <DataGridTemplateColumn Width="60">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="Filter" ToolTip="Enable in Advanced Search Filters" TextAlignment="Center"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              Command="{Binding DataContext.UpdateFieldFlagsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                              CommandParameter="{Binding}" 
                              HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 5. ADMIN TOGGLE -->
                                    <DataGridTemplateColumn Width="60">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="Admin" ToolTip="Restrict Visibility to Admin Role Only" TextAlignment="Center"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsAdmin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              Command="{Binding DataContext.UpdateFieldFlagsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                              CommandParameter="{Binding}" 
                              HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 6. PDF TOGGLE -->
                                    <DataGridTemplateColumn Width="55">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="PDF" ToolTip="Include in Invoices &amp; PDF Exports" TextAlignment="Center"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding InPdf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              Command="{Binding DataContext.UpdateFieldFlagsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                              CommandParameter="{Binding}" 
                              HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 7. ACTIONS -->
                                    <DataGridTemplateColumn Header="Actions" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- EDIT BUTTON -->
                                                    <Button Command="{Binding DataContext.SelectFieldForEditCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                                CommandParameter="{Binding}" 
                                Style="{StaticResource MaterialDesignIconButton}" 
                                Width="30" Height="30" ToolTip="Edit Configuration">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" Foreground="#0284C7"/>
                                                    </Button>

                                                    <!-- DELETE BUTTON (HIDDEN FOR TIER 1 MANDATORY FIELDS) -->
                                                    <Button Command="{Binding DataContext.DeleteFieldCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                                CommandParameter="{Binding}" 
                                Width="30" Height="30" ToolTip="Delete Field" Margin="2,0,0,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FieldTier}" Value="1">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <materialDesign:PackIcon Kind="Delete" Width="15" Height="15" Foreground="#E11D48"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- FOOTER: SUBMIT / DONE BUTTON -->
                            <DockPanel Grid.Row="2" Margin="0,16,0,0">
                                <Button Command="{Binding CloseDialogCommand}" 
                    Content="Submit &amp; Close" 
                    DockPanel.Dock="Right"
                    Height="40" Padding="20,0" 
                    Background="#1794A1" BorderBrush="#1794A1" Foreground="White" 
                    FontWeight="Bold" FontSize="13" 
                    Style="{StaticResource MaterialDesignFlatDarkBgButton}"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>