<UserControl x:Class="CallMan.Views.E2EReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CallMan.Views"
             xmlns:models="clr-namespace:CallMan.Models.Enums"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:CallMan.Converters"
             mc:Ignorable="d" 
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
    </UserControl.Resources>
    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <!-- The top row height can now be dynamically resized via the splitter -->
            <RowDefinition Height="Auto" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <!-- Row dedicated entirely to the GridSplitter -->
            <RowDefinition Height="*"/>
            <!-- BOTTOM VIEW: Report Data Results -->
        </Grid.RowDefinitions>

        <!-- ==================== TOP VIEW ==================== -->
        <materialDesign:Card Grid.Row="0" Margin="15,15,15,5" Padding="20" UniformCornerRadius="6" Background="White">
            <StackPanel>
                <!-- Core Parameter Bar (Horizontal layout) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Primary Selection Zone -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Mid Label Context -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Comparison Selection Zone -->
                        <ColumnDefinition Width="*"/>
                        <!-- Date Filters Spacer -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Actions Layout Panel -->
                    </Grid.ColumnDefinitions>

                    <!-- Primary Parameter Selection -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Width="220" VerticalAlignment="Top">
                        <TextBlock Text="Primary Parameter" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding PrimaryDropdownOptions}"
                              SelectedItem="{Binding SelectedPrimaryOption}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Height="40" Padding="10,0"/>
                    </StackPanel>

                    <!-- Comparative Text Label Anchor -->
                    <TextBlock Grid.Column="1" Text="compare with" VerticalAlignment="Center" 
                           HorizontalAlignment="Center" Margin="15,15,15,0" 
                           FontWeight="Medium" FontStyle="Italic" Foreground="#94A3B8"/>

                    <!-- Comparison Parameter Selection -->
                    <StackPanel Grid.Column="2" Orientation="Vertical" Width="220" VerticalAlignment="Top">
                        <TextBlock Text="Comparison Parameter" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ComparisonDropdownOptions}"
                              SelectedItem="{Binding SelectedComparisonOption}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Height="40" Padding="10,0"/>
                    </StackPanel>

                    <!-- Date Range Configuration Layout Elements -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="30,0,0,0">
                        <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                            <TextBlock Text="From Date" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <!-- FIX: Increased Width from 120 to 150 to resolve text truncation -->
                            <DatePicker SelectedDate="{Binding FromDate}" Width="150" Height="40" Padding="10,0" VerticalContentAlignment="Center" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="To Date" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <!-- FIX: Increased Width from 120 to 150 to resolve text truncation -->
                            <DatePicker SelectedDate="{Binding ToDate}" Width="150" Height="40" Padding="10,0" VerticalContentAlignment="Center" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Direct Execution Interactive Button Elements -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                        <Button Content="GENERATE" Command="{Binding GenerateStandardReportCommand}" 
                            Height="40" Padding="20,0" Background="#1794A1" BorderBrush="#1794A1" 
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0"/>
                        <Button Content="AI REPORT" Command="{Binding GenerateAIReportCommand}" 
                            Height="40" Padding="20,0" Background="#6366F1" BorderBrush="#6366F1" 
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </StackPanel>
                </Grid>

                <!-- DYNAMIC SUB-SELECTION ELEMENT LISTS -->
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Primary Target Entity Checklist Viewport -->
                    <!-- FIX: Set MaxHeight to 140 to optimize space usage -->
                    <Border Grid.Column="0" BorderThickness="1" BorderBrush="#E2E8F0" Background="#F8FAFC" CornerRadius="4" MaxHeight="140" MinHeight="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPrimaryEntitiesList}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <CheckBox Grid.Row="0" Content="Select All Items" IsChecked="{Binding PrimarySelectAll, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Margin="4,0,0,6"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PrimaryEntitiesCollection}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Margin="4,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Secondary Comparison Entity Checklist Viewport -->
                    <!-- FIX: Set MaxHeight to 140 to optimize space usage -->
                    <Border Grid.Column="2" BorderThickness="1" BorderBrush="#E2E8F0" Background="#F8FAFC" CornerRadius="4" MaxHeight="140" MinHeight="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowComparisonEntitiesList}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <CheckBox Grid.Row="0" Content="Select All Items" IsChecked="{Binding ComparisonSelectAll, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Margin="4,0,0,6"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ComparisonEntitiesCollection}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Margin="4,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- ==================== GRID SPLITTER ==================== -->
        <!-- FIX: Provides draggable control to resize top and bottom panes manually -->
        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                  Background="#E2E8F0" ShowsPreview="True" Margin="15,0,15,0"/>

        <!-- ==================== BOTTOM VIEW ==================== -->
        <materialDesign:Card Grid.Row="2" Margin="15,5,15,15" Background="White" UniformCornerRadius="6" Padding="10">
            <DataGrid ItemsSource="{Binding ReportGridSource}" AutoGenerateColumns="True" IsReadOnly="True" ColumnWidth="*"
                  Background="White" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
