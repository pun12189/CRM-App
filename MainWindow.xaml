<Window x:Class="CallMan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan"
        xmlns:vm="clr-namespace:CallMan.ViewModels"
        xmlns:views="clr-namespace:CallMan.Views"
        mc:Ignorable="d"
        Title="SofricONE CRM" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LeadViewModel}">
            <views:LeadView />
        </DataTemplate>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!--<Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>-->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="LightGray" BorderBrush="#DCDDE1" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                
                <Image Source="/Assets/logo.png" Width="100" Stretch="Uniform" Margin="0,0,10,0"/>                

                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#F1F3F6" CornerRadius="18" Width="400" Height="36">
                    <Grid>
                        <TextBox BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="15,0" Text="Search for leads, customers..."/>
                        <TextBlock Text="🔍" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#7F8C8D"/>
                    </Grid>
                </Border>

                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <Grid>
                            <Ellipse Width="40" Height="40" Fill="#3498DB"/>
                            <TextBlock Text="S" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#2C3E50">
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <Button Content="Dashboard" Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                <Button Content="Leads" Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Leads"/>
                <Button Content="Customers" Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Customers"/>
                <Button Content="Admin Settings" Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
