<UserControl x:Class="CallMan.Views.OrderStagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CallMan.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <materialDesign:BooleanToVisibilityConverter x:Key="InvertedVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- List -->
            <ColumnDefinition Width="350"/>
            <!-- Editor -->
        </Grid.ColumnDefinitions>

        <!-- LIST AREA -->
        <materialDesign:Card Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="16" HorizontalAlignment="Stretch">
                    <TextBlock Text="Order Pipeline Stages" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                    <Button Command="{Binding AddNewStageCommand}" HorizontalAlignment="Right" Content="ADD STAGE" Style="{StaticResource MaterialDesignRaisedButton}"/>
                </DockPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Stages}" SelectedItem="{Binding SelectedStage}"
                      AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" Background="Transparent">
                    <DataGrid.Columns>
                        
                        <DataGridTemplateColumn Header="Order" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SequenceOrder}" VerticalAlignment="Center" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Color" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="20" Height="20" CornerRadius="10" 
                                    Background="{Binding HexColor}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>                        
                        <DataGridTemplateColumn Header="Stage Name" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StageName}" VerticalAlignment="Center" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Deduct Stock" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Icon shown only if DeductStock is True -->
                                        <materialDesign:PackIcon Kind="CheckCircle" 
                                             Foreground="#4CAF50" 
                                             Visibility="{Binding DeductStock, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <!-- Icon shown only if DeductStock is False (Optional) -->
                                        <materialDesign:PackIcon Kind="MinusCircleOutline" 
                                             Foreground="#E0E0E0" 
                                             Visibility="{Binding DeductStock, Converter={StaticResource InvertedVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Cancellation Stage" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PackIcon Kind="RotateLeft" 
                                         HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                         Foreground="#F44336" 
                                         Visibility="{Binding IsCancellationStage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="*"/>
                        <DataGridTemplateColumn Header="Actions" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Delete Button -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Delete Stage"
                            Command="{Binding DataContext.DeleteStageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <ScrollViewer Grid.Column="1">
            <materialDesign:Card  VerticalAlignment="Top" Padding="20">
                <StackPanel>
                    <TextBlock Text="Stage Configuration" FontWeight="Bold" Margin="0,0,0,20"/>

                    <TextBox Text="{Binding SelectedStage.StageName}" materialDesign:HintAssist.Hint="Stage Name" Margin="0,0,0,16"/>
                    <TextBox Text="{Binding SelectedStage.Description}" materialDesign:HintAssist.Hint="Description" Margin="0,0,0,16" AcceptsReturn="True"/>
                    <TextBox Text="{Binding SelectedStage.SequenceOrder}" materialDesign:HintAssist.Hint="Pipeline Position" Margin="0,0,0,16"/>

                    <!-- Inventory Trigger Section -->
                    <Border Background="#FFF3E0" Padding="12" CornerRadius="4" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="ChartLineStacked" Foreground="#E65100" VerticalAlignment="Center"/>
                                <TextBlock Text="Inventory Rules" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              IsChecked="{Binding SelectedStage.DeductStock}"
                              HorizontalAlignment="Left"
                              ToolTip="If enabled, moving an order to this stage will reduce items from current stock."/>
                            <TextBlock Text="Deduct Stock at this stage?" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFEBEE" Padding="12" CornerRadius="4" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="RotateLeft" Foreground="#C62828" VerticalAlignment="Center"/>
                                <TextBlock Text="Cancellation Rule" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                      IsChecked="{Binding SelectedStage.IsCancellationStage}"
                      HorizontalAlignment="Left"/>
                            <TextBlock Text="Reverse stock when moving to this stage?" 
                   Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="UI Accent Color" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Color Preview Button -->
                            <Button Grid.Column="0" 
                Width="40" Height="40"
                Background="{Binding SelectedStage.HexColor}"
                Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                Command="{Binding OpenColorPickerCommand}">
                                <materialDesign:PackIcon Kind="Palette" Foreground="White"/>
                            </Button>

                            <!-- The Popup Palette -->
                            <Popup IsOpen="{Binding IsColorPickerOpen}" 
               StaysOpen="False" 
               AllowsTransparency="True" 
               PlacementTarget="{Binding ElementName=ColorBtn}"
               Placement="Bottom">
                                <materialDesign:Card Margin="5" Padding="8">
                                    <ItemsControl ItemsSource="{Binding StandardColors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Width="160"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="30" Height="30" Margin="2"
                                    Background="{Binding}"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </materialDesign:Card>
                            </Popup>

                            <TextBox Grid.Column="1" 
                 Text="{Binding SelectedStage.HexColor}" 
                 Margin="12,0,0,0"
                 IsReadOnly="True"
                 VerticalAlignment="Center"
                 materialDesign:HintAssist.Hint="Selected Color Code"/>
                        </Grid>                        
                    </StackPanel>

                    <Button Command="{Binding SaveStagesCommand}" Content="SAVE STAGE SETTINGS" 
                Background="#1794A1" BorderBrush="#1794A1" Height="45"/>
                </StackPanel>
            </materialDesign:Card>
        </ScrollViewer>
    </Grid>
</UserControl>
