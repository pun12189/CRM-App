<Window x:Class="Tijori.Dialogs.CreateFieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tijori.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Field Configuration" Height="720" Width="1160" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" 
        Background="Transparent" AllowsTransparency="True" WindowStyle="None" 
        Icon="/Assets/opn.png" ShowInTaskbar="False">

    <Grid Margin="16">
        <Border Padding="20" Background="#F8FAFC" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="20" ShadowDepth="4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Top Section: Chips (Left) & Field Editor (Right) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Bottom Section: Active Fields DataGrid (Full Width) -->
                    <RowDefinition Height="*"/>
                    <!-- Footer: Submit & Close Button -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= 1. HEADER ================= -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Command="{Binding CloseDialogCommand}" 
                            Style="{StaticResource MaterialDesignFlatButton}" Width="32" Height="32" Padding="0" Cursor="Hand">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#64748B"/>
                    </Button>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="Target Scope: " FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ModuleType}" FontSize="12" Foreground="#1794A1" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ModuleInfoNotice}" FontSize="11" Foreground="#E11D48" FontStyle="Italic" Margin="14,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- ================= 2. TOP SECTION: HORIZONTAL SPLIT ================= -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Available System Fields Chips -->
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="14"/>
                        <!-- Right: Field Editor -->
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TOP-LEFT: AVAILABLE SYSTEM FIELDS CHIPS -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Available System Fields" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="Click a chip to edit its label or toggle advanced flags." FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding StandardModelChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectFieldForEditCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                                                    CommandParameter="{Binding}" 
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="3" 
                                                    Margin="0,0,4,4" 
                                                    Height="Auto"
                                                    Cursor="Hand" 
                                                    ToolTipService.InitialShowDelay="50"
                                                    ToolTipService.BetweenShowDelay="0"
                                                    ToolTipService.ShowDuration="12000">

                                                <Button.ToolTip>
                                                    <ToolTip MaxWidth="300" 
                                                             Background="#0F172A" 
                                                             Foreground="White" 
                                                             Padding="8,6" 
                                                             HasDropShadow="True">
                                                        <TextBlock Text="{Binding InfoTooltip}" TextWrapping="Wrap" FontSize="11" LineHeight="15"/>
                                                    </ToolTip>
                                                </Button.ToolTip>

                                                <Border Background="#EFF6FF" 
                                                        CornerRadius="13" 
                                                        Padding="9,4" 
                                                        BorderBrush="#93C5FD" 
                                                        BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#1E40AF" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.10"/>
                                                    </Border.Effect>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding EffectiveLabel}" 
                                                                   FontSize="11" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="#1E40AF" 
                                                                   VerticalAlignment="Center"/>
                                                        <materialDesign:PackIcon Kind="InformationOutline" 
                                                                                 Width="12" 
                                                                                 Height="12" 
                                                                                 Margin="4,0,0,0" 
                                                                                 Foreground="#60A5FA"
                                                                                 VerticalAlignment="Center">
                                                            <materialDesign:PackIcon.ToolTip>
                                                                <ToolTip MaxWidth="280">
                                                                    <TextBlock Text="{Binding InfoTooltip}" TextWrapping="Wrap" FontSize="11"/>
                                                                </ToolTip>
                                                            </materialDesign:PackIcon.ToolTip>
                                                        </materialDesign:PackIcon>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- TOP-RIGHT: FIELD EDITOR -->
                    <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Field Editor" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,10"/>

                            <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Field Name & Display Label (2 Columns) -->
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <TextBox Text="{Binding NewField.FieldName, UpdateSourceTrigger=PropertyChanged}" 
                                                 IsEnabled="{Binding IsFieldNameEditable}"
                                                 materialDesign:HintAssist.Hint="Database Field Name *" 
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                                 FontSize="11" Height="34" Padding="6,3" Margin="0,0,4,0"/>

                                        <TextBox Text="{Binding NewField.DisplayLabel, UpdateSourceTrigger=PropertyChanged}" 
                                                 materialDesign:HintAssist.Hint="Form Display Label *" 
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                                 FontSize="11" Height="34" Padding="6,3" Margin="4,0,0,0"/>
                                    </UniformGrid>

                                    <!-- Control Type -->
                                    <ComboBox SelectedValue="{Binding NewField.FieldType}" SelectedValuePath="Content"
                                              IsEnabled="{Binding IsControlTypeEditable}"
                                              materialDesign:HintAssist.Hint="Control Type" 
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                                              FontSize="11" Height="34" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Textbox"/>
                                        <ComboBoxItem Content="TextArea"/>
                                        <ComboBoxItem Content="DropdownSingle"/>
                                        <ComboBoxItem Content="DropdownMultiple"/>
                                        <ComboBoxItem Content="CalendarClock"/>
                                    </ComboBox>

                                    <!-- Dropdown Options (Visible only if Dropdown type is selected) -->
                                    <StackPanel Margin="0,0,0,8">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NewField.FieldType}" Value="DropdownSingle">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NewField.FieldType}" Value="DropdownMultiple">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding NewValueOptionText, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Type choice value..."
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                                     FontSize="11" Height="32" Padding="6,2" Grid.Column="0" Margin="0,0,6,0">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding AddValueOptionCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button Grid.Column="1" Command="{Binding AddValueOptionCommand}" Content="Add" 
                                                    Height="32" Padding="10,0" FontSize="11"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding NewField.SeedValueOptionsList}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <materialDesign:Chip Content="{Binding}" Margin="0,0,4,4" IsDeletable="True"
                                                                         DeleteCommand="{Binding DataContext.RemoveValueOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         DeleteCommandParameter="{Binding}" Background="#EFF6FF" Foreground="#1E40AF" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- SAVE BUTTON -->
                                    <Button Content="Add To List" Command="{Binding SubmitCustomFieldCommand}" 
                                            Height="36" FontSize="12" FontWeight="Bold" Background="#0D9488" BorderBrush="#0D9488" Foreground="White"
                                            Style="{StaticResource MaterialDesignFlatDarkBgButton}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= 3. BOTTOM SECTION: ACTIVE REGISTRY DATAGRID (WIDE VIEW) ================= -->
                <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Active Form Fields &amp; Toggles" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,10"/>

                        <!-- ACTIVE FORM REGISTRY DATAGRID -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding RegisteredFieldsList}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  HeadersVisibility="Column"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.CacheLengthUnit="Item"
                                  VirtualizingPanel.CacheLength="10,20"
                                  ScrollViewer.CanContentScroll="True"
                                  Background="Transparent"
                                  GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="#F1F5F9" 
                                  BorderThickness="0"
                                  RowHeight="46" 
                                  VerticalScrollBarVisibility="Hidden">

                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>

                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <!-- 1. FIELD MAPPING -->
                                <DataGridTemplateColumn Header="Field Mapping" Width="2*">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="Padding" Value="14,0,0,0"/>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0">
                                                <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding FieldName}" FontSize="10.5" Foreground="#64748B"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 2. INPUT TYPE -->
                                <DataGridTextColumn Header="Type" 
                                                    Binding="{Binding FieldType}" 
                                                    Width="1.5*" 
                                                    Foreground="#475569" 
                                                    FontSize="11.5" 
                                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="Padding" Value="10,0,0,0"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>

                                <!-- 3. REQUIRED TOGGLE -->
                                <DataGridTemplateColumn Width="85">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Req." ToolTip="Is Mandatory Field?" TextAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsRequired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                      Command="{Binding DataContext.UpdateFieldFlagsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      CommandParameter="{Binding}" 
                                                      HorizontalAlignment="Center">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FieldTier}" Value="1">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 4. FILTER TOGGLE -->
                                <DataGridTemplateColumn Width="85">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Filter" ToolTip="Enable in Advanced Search Filters" TextAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                      Command="{Binding DataContext.UpdateFieldFlagsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      CommandParameter="{Binding}" 
                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 5. ADMIN TOGGLE -->
                                <DataGridTemplateColumn Width="85">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Admin" ToolTip="Restrict Visibility to Admin Role Only" TextAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsAdmin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                      Command="{Binding DataContext.UpdateFieldFlagsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      CommandParameter="{Binding}" 
                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 6. PDF TOGGLE -->
                                <DataGridTemplateColumn Width="85">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="PDF" ToolTip="Include in Invoices &amp; PDF Exports" TextAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding InPdf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                      Command="{Binding DataContext.UpdateFieldFlagsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      CommandParameter="{Binding}" 
                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="85">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Table" ToolTip="Include in Table views" TextAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding InTable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                      Command="{Binding DataContext.UpdateFieldFlagsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                              CommandParameter="{Binding}" 
                                              HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 7. ACTIONS -->
                                <DataGridTemplateColumn Header="Actions" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.SelectFieldForEditCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                                                        CommandParameter="{Binding}" 
                                                        Style="{StaticResource MaterialDesignIconButton}" 
                                                        Width="26" Height="26" ToolTip="Edit Configuration">
                                                    <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Foreground="#0284C7"/>
                                                </Button>

                                                <Button Command="{Binding DataContext.DeleteFieldCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                                                        CommandParameter="{Binding}" 
                                                        Width="26" Height="26" ToolTip="Delete Field" Margin="2,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FieldTier}" Value="1">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Foreground="#E11D48"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ================= 4. FOOTER ACTION ================= -->
                <DockPanel Grid.Row="3" Margin="0,14,0,0">
                    <Button Command="{Binding CloseDialogCommand}" 
                            Content="Submit &amp; Close" 
                            DockPanel.Dock="Right"
                            Height="40" Padding="28,0" 
                            Background="#0D9488" BorderBrush="#0D9488" Foreground="White" 
                            FontWeight="Bold" FontSize="13" 
                            Style="{StaticResource MaterialDesignFlatDarkBgButton}"/>
                </DockPanel>

            </Grid>
        </Border>
    </Grid>
</Window>