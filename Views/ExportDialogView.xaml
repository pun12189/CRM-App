<UserControl x:Class="Tijori.Views.ExportDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="620" Padding="24" Background="White">
    <StackPanel>

        <!-- DIALOG HEADER -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="FileExportOutline" Foreground="#2563EB" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Export Report Options" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            </StackPanel>
        </DockPanel>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: EXPORT FORMAT SELECTION -->
            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="Select Export Format" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12"/>

                    <!-- Excel Option -->
                    <RadioButton IsChecked="{Binding ExportAsExcel}" GroupName="ExportFormat" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileExcel" Foreground="#16A34A" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Excel Spreadsheet (.xlsx)" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- PDF Option -->
                    <RadioButton IsChecked="{Binding ExportAsPdf}" GroupName="ExportFormat" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FilePdfBox" Foreground="#DC2626" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="PDF Document (.pdf)" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- CSV Option -->
                    <RadioButton IsChecked="{Binding ExportAsCsv}" GroupName="ExportFormat">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileCsv" Foreground="#0284C7" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="CSV File (.csv)" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- RIGHT COLUMN: CHOOSE COLUMNS TO INCLUDE -->
            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button Content="Select All" Command="{Binding SelectAllColumnsCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="#2563EB" 
                                DockPanel.Dock="Right" Padding="4,0" Height="24" FontSize="11"/>
                        <TextBlock Text="Include Columns" FontSize="13" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                        <StackPanel>
                            <CheckBox Content="Bill / Invoice No." IsChecked="{Binding IncludeBillNo}" Margin="0,3"/>
                            <CheckBox Content="Transaction Date" IsChecked="{Binding IncludeDate}" Margin="0,3"/>
                            <CheckBox Content="Voucher Type (Sale/Purchase)" IsChecked="{Binding IncludeType}" Margin="0,3"/>
                            <CheckBox Content="Description (Customer/Vendor)" IsChecked="{Binding IncludeDescription}" Margin="0,3"/>
                            <CheckBox Content="Batch Number" IsChecked="{Binding IncludeBatchNumber}" Margin="0,3"/>
                            <CheckBox Content="Quantity" IsChecked="{Binding IncludeQuantity}" Margin="0,3"/>
                            <CheckBox Content="Total Value (₹)" IsChecked="{Binding IncludeValue}" Margin="0,3"/>
                            <CheckBox Content="Balance Quantity" IsChecked="{Binding IncludeBalanceQuantity}" Margin="0,3"/>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER ACTION BUTTONS -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" 
                    Command="{Binding CloseExportDialogCommand}" 
                    Style="{StaticResource MaterialDesignFlatButton}" 
                    Foreground="#64748B" Height="38" Padding="16,0" Margin="0,0,8,0"/>

            <Button Command="{Binding ExecuteExportCommand}" 
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Background="#10B981" BorderBrush="#10B981" Foreground="White"
                    Height="38" Padding="20,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Download" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Export File" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </StackPanel>
</UserControl>
