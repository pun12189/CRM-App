<UserControl x:Class="Tijori.Views.AllOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:conv="clr-namespace:Tijori.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>

        <DataTemplate x:Key="MainGridLeadLayoutTemplate">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Padding="15" Margin="0,0,0,15" Background="#F5F5F5">
                    <DockPanel>
                        <TextBlock Text="ORDER's" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="Gray" HorizontalAlignment="Left"/>
                            <Grid Width="250" Margin="30,0,0,0" HorizontalAlignment="Left">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Height="30" Padding="5,0"/>
                                <TextBlock Text="Search Order, Batch..." IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0" Foreground="LightGray">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="1" Content="IMPORT ORDER's" Command="{Binding ImportOrdersCommand}" HorizontalAlignment="Right"
                                Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" BorderBrush="#2E7D32" Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Content="NEW ORDER" Command="{Binding AddNewOrderCommand}" 
                                 Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" BorderBrush="#2E7D32" Margin="0,0,10,0" HorizontalAlignment="Right"/>
                            <ComboBox Grid.Column="3" x:Name="AskAIComboBox" Height="34" Padding="10,0"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="Ask AI"
                              materialDesign:HintAssist.Foreground="#7B1FA2"
                              BorderBrush="#7B1FA2"
                              Foreground="#4A148C"
                              FontWeight="SemiBold"
                              Width="150"
                              VerticalAlignment="Center">
                                <ComboBoxItem Padding="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileExcel" 
                                     Foreground="#1D6F42" 
                                     Width="22" Height="22" 
                                     Margin="0,0,12,0" 
                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="Upload Excel" 
                       Foreground="#2E7D32" 
                       FontWeight="SemiBold" 
                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>

                                <!-- Upload Image -->
                                <ComboBoxItem Padding="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ImageOutline" 
                                     Foreground="#0288D1" 
                                     Width="22" Height="22" 
                                     Margin="0,0,12,0" 
                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="Upload Image" 
                       Foreground="#0277BD" 
                       FontWeight="SemiBold" 
                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>

                                <!-- Upload PDF -->
                                <ComboBoxItem Padding="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilePdfBox" 
                                     Foreground="#D32F2F" 
                                     Width="22" Height="22" 
                                     Margin="0,0,12,0" 
                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="Upload Pdf" 
                       Foreground="#C62828" 
                       FontWeight="SemiBold" 
                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>

                                <!-- Prompt / AI -->
                                <ComboBoxItem Padding="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Sparkles" 
                                     Foreground="#FFB300" 
                                     Width="22" Height="22" 
                                     Margin="0,0,12,0" 
                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="Prompt" 
                       Foreground="#6A1B9A" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                            
                            <ToggleButton Grid.Column="4" 
                              IsChecked="{Binding IsCounterPanelExpanded}" 
                              Cursor="Hand"
                              Margin="5,0"
                                  ToolTip="Toggle Counter &amp; Summary Panels"
                                  Style="{StaticResource MaterialDesignFlatButton}"
                                  Height="32" Width="32" Padding="0" 
                                  Background="Transparent" Foreground="#2C3E50" VerticalAlignment="Center">
                                <materialDesign:PackIcon Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="ChevronDown"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCounterPanelExpanded}" Value="True">
                                                    <Setter Property="Kind" Value="ChevronUp"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </ToggleButton>
                        </Grid>
                    </DockPanel>
                </materialDesign:Card>

                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCounterPanelExpanded}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <UniformGrid Columns="6">

                        <Border Background="#14B8A6" CornerRadius="6" Height="75" Margin="0,0,10,0" Padding="12,10">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="NEW ORDERS" FontSize="11" FontWeight="Bold" Foreground="#CCFFFFFF"/>
                                <TextBlock Text="{Binding NewOrdersCount}" FontSize="22" FontWeight="Black" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#14B8A6" CornerRadius="6" Height="75" Margin="0,0,10,0" Padding="12,10">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="REPEAT ORDERS" FontSize="11" FontWeight="Bold" Foreground="#CCFFFFFF"/>
                                <TextBlock Text="{Binding RepeatOrdersCount}" FontSize="22" FontWeight="Black" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#14B8A6" CornerRadius="6" Height="75" Margin="0,0,10,0" Padding="12,10">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="PAID" FontSize="11" FontWeight="Bold" Foreground="#CCFFFFFF"/>
                                <TextBlock Text="{Binding PaidOrdersCount}" FontSize="22" FontWeight="Black" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#14B8A6" CornerRadius="6" Height="75" Margin="0,0,10,0" Padding="12,10">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="UNPAID" FontSize="11" FontWeight="Bold" Foreground="#CCFFFFFF"/>
                                <TextBlock Text="{Binding UnpaidOrdersCount}" FontSize="22" FontWeight="Black" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#14B8A6" CornerRadius="6" Height="75" Margin="0,0,10,0" Padding="12,10">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="PARTIALLY PAID" FontSize="11" FontWeight="Bold" Foreground="#CCFFFFFF"/>
                                <TextBlock Text="{Binding PartiallyPaidOrdersCount}" FontSize="22" FontWeight="Black" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#14B8A6" CornerRadius="6" Height="75" Padding="12,10">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="PENDING" FontSize="11" FontWeight="Bold" Foreground="#CCFFFFFF"/>
                                <TextBlock Text="{Binding PendingStageOrdersCount}" FontSize="22" FontWeight="Black" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <Border Background="#FFFBEB" 
                        BorderBrush="#FEF3C7" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="20,15" 
                        Effect="{DynamicResource MaterialDesignShadowDepth1}">

                        <UniformGrid Columns="5" VerticalAlignment="Center">

                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL:" 
                                    FontSize="16" FontWeight="SemiBold" 
                                    Foreground="#92400E" HorizontalAlignment="Left" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="(NEW + REPEAT):" 
                                    FontSize="14" FontWeight="SemiBold" 
                                    Foreground="#78350F" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Orders:" 
                                       FontSize="16" FontWeight="SemiBold" 
                                       Foreground="#92400E" HorizontalAlignment="Center" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalOrderCount}" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="#78350F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding NewOrdersCount, StringFormat=({0} New}" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#92400E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Foreground="#92400E" Height="12" Width="12"/>
                                    <TextBlock Text="{Binding RepeatOrdersCount, StringFormat={}{0} Repeat)}" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#78350F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Business:" 
                                       FontSize="16" FontWeight="SemiBold" 
                                       Foreground="#92400E" HorizontalAlignment="Center" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalOrderVolume, StringFormat=C2, ConverterCulture=en-IN}" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="#78350F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CustomerStats.TotalFirstOrders, StringFormat=({0:C2}, ConverterCulture=en-IN}" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#92400E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Foreground="#92400E" Height="12" Width="12"/>
                                    <TextBlock Text="{Binding CustomerStats.TotalOtherOrders, StringFormat={}{0:C2}), ConverterCulture=en-IN}" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#78350F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Paid:" 
                                       FontSize="16" FontWeight="SemiBold" 
                                       Foreground="#92400E" HorizontalAlignment="Center" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalPaymentsReceived, StringFormat=C2, ConverterCulture=en-IN}" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="#78350F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CustomerStats.TotalFirstOrderAmountPaid, StringFormat=({0:C2}, ConverterCulture=en-IN}" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#92400E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Foreground="#92400E" Height="12" Width="12"/>
                                    <TextBlock Text="{Binding CustomerStats.TotalOtherOrderAmountPaid, StringFormat={}{0:C2}), ConverterCulture=en-IN}" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#78350F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Balance:" 
                                       FontSize="16" FontWeight="SemiBold" 
                                       Foreground="#92400E" HorizontalAlignment="Center" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalOutstandingBalance, StringFormat=C2, ConverterCulture=en-IN}" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="#92400E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CustomerStats.TotalFirstOrderOutstanding, StringFormat=({0:C2}, ConverterCulture=en-IN}" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#92400E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Foreground="#92400E" Height="12" Width="12"/>
                                    <TextBlock Text="{Binding CustomerStats.TotalOtherOrderOutstanding, StringFormat={}{0:C2}), ConverterCulture=en-IN}" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#78350F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                        </UniformGrid>
                    </Border>
                </StackPanel>

                <DataGrid Grid.Row="2" 
                      ItemsSource="{Binding OrderCollection, IsAsync=True}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,8"/>
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#334155"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>

                        <!-- 1. ORDER ID & TYPE (COMBINED) -->
                        <DataGridTemplateColumn Header="Order ID" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedOrderId}" 
                                               Foreground="#2563EB" FontWeight="Bold" FontSize="12"
                                               HorizontalAlignment="Center" Cursor="Hand">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                              Command="{Binding DataContext.ShowOrderDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                              CommandParameter="{Binding}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>

                                        <!-- Compact Order Type Tag -->
                                        <Border x:Name="TypeBadge" CornerRadius="3" Padding="4,1" Margin="0,2,0,0" HorizontalAlignment="Center" Background="#16A34A">
                                            <TextBlock Text="{Binding OrderType}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding OrderType}" Value="Repeat">
                                            <Setter TargetName="TypeBadge" Property="Background" Value="#2563EB"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2. CUSTOMER & FIRM -->
                        <DataGridTemplateColumn Header="Customer / Firm" Width="2.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,2">
                                        <TextBlock Text="{Binding FirmName, StringFormat='({0})'}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CustomerName}" Foreground="#0F172A" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. TOTAL PRICE -->
                        <DataGridTextColumn Header="Total Price" Binding="{Binding TotalAmount, StringFormat=C0, ConverterCulture=en-IN}" Width="1.1*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 4. BALANCE -->
                        <DataGridTextColumn Header="Balance" Binding="{Binding OrderBalance, StringFormat=C0, ConverterCulture=en-IN}" Width="1.1*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 5. STATUS & PAYMENT STATUS (COMBINED) -->
                        <DataGridTemplateColumn Header="Status" Width="1.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Order Status Badge -->
                                        <Border x:Name="StatusBadge" CornerRadius="3" Padding="6,2" Margin="0,0,0,2" Background="#DC2626" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <!-- Payment Status Badge -->
                                        <Border x:Name="PaymentBadge" CornerRadius="3" Padding="6,2" Background="#DC2626" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding PaymentStatus}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <DataTemplate.Triggers>
                                        <!-- Order Status Triggers -->
                                        <DataTrigger Binding="{Binding Status}" Value="Dispatched">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#059669"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#D97706"/>
                                        </DataTrigger>

                                        <!-- Payment Status Triggers -->
                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Fully Paid">
                                            <Setter TargetName="PaymentBadge" Property="Background" Value="#16A34A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Partially Paid">
                                            <Setter TargetName="PaymentBadge" Property="Background" Value="#EA580C"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 6. ORDER INVOICE ACTION -->
                        <DataGridTemplateColumn Header="Invoice" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Background="Transparent"
                                             Foreground="Transparent"
                                             Padding="0"
                                             materialDesign:RippleAssist.Feedback="Transparent">
                                        <materialDesign:PopupBox.ToggleContent>
                                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="6,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="12" Height="12" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                    <TextBlock Text="Invoice" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                    <materialDesign:PackIcon Kind="ChevronDown" Width="10" Height="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </materialDesign:PopupBox.ToggleContent>                                        

                                        <StackPanel Width="140" Margin="2">
                                            <Button Command="{Binding DataContext.DownloadInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Height="32" Padding="6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Download" Width="14" Height="14" Foreground="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Download PDF" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding DataContext.EmailInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Height="32" Padding="6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="EmailOutline" Width="14" Height="14" Foreground="#EA580C" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Email Invoice" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding DataContext.WhatsAppInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Height="32" Padding="6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Whatsapp" Width="14" Height="14" Foreground="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="WhatsApp" Foreground="#1E293B" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </materialDesign:PopupBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 7. TEAM / ASSIGNED (COMBINED LEAD HOLDER & PROCESSED BY) -->
                        <DataGridTemplateColumn Header="Assigned / Taken" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LeadHolder, TargetNullValue='—'}" FontSize="11" Foreground="#475569" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ProcessedBy, StringFormat='By: {0}'}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 8. CREATED AT -->
                        <DataGridTextColumn Header="Created At" Binding="{Binding OrderDate, StringFormat='dd-MM-yyyy'}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 9. ACTION BUTTONS -->
                        <DataGridTemplateColumn Header="Action" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="22" Height="22" Padding="0"
                                            Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Pencil" Width="13" Height="13" Foreground="#D97706"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="22" Height="22" Margin="3,0,0,0" Padding="0"
                                            Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Delete" Width="13" Height="13" Foreground="#EF4444"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OrderDetailViewTemplate">
            <local:OrderDetailView DataContext="{Binding TabsDataContext}"/>
        </DataTemplate>
    </UserControl.Resources>
    

    <Grid>
        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource MainGridLeadLayoutTemplate}"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.WorkspaceViewIsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource OrderDetailViewTemplate}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</UserControl>
