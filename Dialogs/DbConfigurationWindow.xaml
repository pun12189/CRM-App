<Window x:Class="Tijori.Dialogs.DbConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tijori.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Icon="/Assets/opn.png" ShowInTaskbar="False"
        Title="TIJORI Database Routing Environment Platform Setup" 
        Height="540" Width="820" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F8FAFC">
    <Window.Resources>
        <materialDesign:BooleanToVisibilityConverter TrueValue="Collapsed" FalseValue="Visible" x:Key="InvertedBooleanConverter"/>
    </Window.Resources>
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.8*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="24" Background="White" BorderThickness="0,0,1,0" BorderBrush="#E2E8F0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Database Routing Configurations" FontSize="20" FontWeight="Bold" Foreground="#1794A1" HorizontalAlignment="Left"/>
                    <TextBlock Text="Map dynamic connection parameters for local or remote servers." FontSize="12" Foreground="#64748B" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel Margin="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Config.Server, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Server Host Address IP / Domain" materialDesign:HintAssist.IsFloating="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,4"/>
                            <TextBox Grid.Column="1" Text="{Binding Config.Port, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Port" materialDesign:HintAssist.IsFloating="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,4"/>
                        </Grid>

                        <TextBox Text="{Binding Config.Database, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Database Name Schema" materialDesign:HintAssist.IsFloating="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,4"/>
                        <TextBox Text="{Binding Config.UserId, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Username (Database User ID)" materialDesign:HintAssist.IsFloating="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,4"/>
                        <PasswordBox x:Name="TxtPassword" materialDesign:HintAssist.Hint="Database Security Access Password" materialDesign:HintAssist.IsFloating="True" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,4"/>

                        <CheckBox IsChecked="{Binding Config.UseSsl}" Margin="2,0,0,0">
                            <TextBlock Text="Enforce Cryptographic SSL Packet Encryption (Required for Online Cloud Hosting)"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="#475569"/>
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="10">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                    <Button x:Name="BtnTestConnection" Content="TEST AND SAVE CONNECTION SCHEMAS" Command="{Binding TestAndSaveConnectionCommand}" 
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertedBooleanConverter}}"
                            Height="44" FontSize="13" FontWeight="Bold" Background="#1794A1" BorderBrush="#1794A1" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="HelpCircleOutline" Foreground="#64748B" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Server Lookup Assistance" FontSize="14" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="How do I find the correct database endpoint address properties?" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" HorizontalAlignment="Left"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">

                    <materialDesign:Card Padding="12" Background="#F1F5F9" UniformCornerRadius="4">
                        <StackPanel Margin="4">
                            <TextBlock Text="1. Local Installation Setup" FontWeight="Bold" FontSize="12" Foreground="#1E293B" HorizontalAlignment="Left"/>
                            <TextBlock Text="If MySQL is installed on this computer, type 'localhost' or select a local IP signature alternative." FontSize="11" Foreground="#475569" TextWrapping="Wrap" HorizontalAlignment="Left"/>

                            <TextBlock Text="Auto-Detected Interfaces:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,6,0,2" HorizontalAlignment="Left"/>
                            <ItemsControl ItemsSource="{Binding DetectedLocalIps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#2563EB" FontSize="11" Height="22" Padding="4,0" Margin="2"
                                                Command="{Binding DataContext.SelectDiscoveredIpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="12" Background="#F1F5F9" UniformCornerRadius="4">
                        <StackPanel Margin="4">
                            <TextBlock Text="2. Network LAN Office Installations" FontWeight="Bold" FontSize="12" Foreground="#1E293B" HorizontalAlignment="Left"/>
                            <TextBlock Text="Go to the Master computer server system terminal. Open Command Prompt and type 'ipconfig'. Locate the IPv4 Address marker item (e.g. 192.168.1.45) and map it into the server input line here." FontSize="11" Foreground="#475569" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="12" Background="#F1F5F9" UniformCornerRadius="4">
                        <StackPanel Margin="4">
                            <TextBlock Text="3. Online Remote Clouds Hosting" FontWeight="Bold" FontSize="12" Foreground="#1E293B" HorizontalAlignment="Left"/>
                            <TextBlock Text="Enter the public domain hostname url address or designated numeric static IP routing coordinates supplied by your administrator desk. Ensure the checkbox for SSL enforcement is checked." FontSize="11" Foreground="#475569" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
