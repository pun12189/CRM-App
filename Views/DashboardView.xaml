<UserControl x:Class="CallMan.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CallMan.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="#F5F7F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="20,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Welcome to CallMan Dashboard" FontSize="11" Foreground="#888"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <materialDesign:Chip Content="{Binding LastUpdatedStatus}" 
                         Background="#E0E6ED" Margin="10,0"/>
                <Button Command="{Binding RefreshCommand}" 
                    Background="#FF8A3D" BorderBrush="#FF8A3D"
                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}">
                    <materialDesign:PackIcon Kind="Refresh" Foreground="White"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="1" Style="{StaticResource MaterialDesignLinearProgressBar}" 
             Value="0" IsIndeterminate="True" 
             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              VerticalAlignment="Top"/>
        
        <TabControl Grid.Row="2" Style="{StaticResource MaterialDesignTabControl}" Margin="10,0">
            <TabItem Header="Analytics">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                        <StackPanel>
                            <DockPanel Margin="0,10">
                                <TextBlock Text="{Binding DataUpdatedStatus}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Command="{Binding OpenFilterCommand}" 
                                Content="Filter" Background="#FF8A3D" BorderBrush="#FF8A3D"
                                HorizontalAlignment="Right" Height="25" FontSize="11">
                                        <materialDesign:ButtonAssist.CornerRadius>5</materialDesign:ButtonAssist.CornerRadius>
                                    </Button>
                                    <Button Command="{Binding ClearFilterCommand}" 
                                Content="Clear Filter" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#C62828"
                                HorizontalAlignment="Right" Height="25" FontSize="11" Margin="5,0,0,0" Visibility="{Binding IsFilterActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <materialDesign:ButtonAssist.CornerRadius>5</materialDesign:ButtonAssist.CornerRadius>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <materialDesign:Card Margin="5,15,5,5" Background="White" UniformCornerRadius="6">
                                <Expander Header="Product Counters" IsExpanded="True" Background="Transparent" Foreground="#2C3E50" FontWeight="Bold" FontSize="13">
                                    <UniformGrid Columns="5" Margin="5,10">
                                        <Border Background="#F4F6F7" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.TotalCategoriesUsed}" FontSize="24" FontWeight="Bold" Foreground="#34495E" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Total Categories" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F4F6F7" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.TotalProducts}" FontSize="24" FontWeight="Bold" Foreground="#2980B9" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Total Products" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F4F6F7" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.TotalNewProducts}" FontSize="24" FontWeight="Bold" Foreground="#16A085" HorizontalAlignment="Center"/>
                                                <TextBlock Text="New Products" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F4F6F7" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.FastMovingProducts}" FontSize="24" FontWeight="Bold" Foreground="#D35400" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Fast Moving" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F4F6F7" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.SlowMovingProducts}" FontSize="24" FontWeight="Bold" Foreground="#C0392B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Slow Moving" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#FEF2F2" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.NearSkuCount}" FontSize="22" FontWeight="Bold" Foreground="#991B1B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Near SKU" FontSize="10" FontWeight="Bold" Foreground="#991B1B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- NEW ADDITION SLOT 2: EXPIRY MONITORING RUNWAY TILE -->
                                        <Border Background="#FFF7ED" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.NearExpiryCount}" FontSize="22" FontWeight="Bold" Foreground="#C2410C" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Near Expiry" FontSize="10" FontWeight="Bold" Foreground="#C2410C" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- NEW ADDITION SLOT 3: SKIPPED PRODUCTS VELOCITY EXCLUSION TILE -->
                                        <Border Background="#F5F3FF" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.SkippedProductsCount}" FontSize="22" FontWeight="Bold" Foreground="#6D28D9" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Skipped Products" FontSize="10" Foreground="#6D28D9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Expander>
                            </materialDesign:Card>

                            <materialDesign:Card Margin="5,15,5,5" Background="White" UniformCornerRadius="6">
                                <Expander Header="All Time Data" IsExpanded="False" Background="Transparent" Foreground="#2C3E50" FontWeight="Bold" FontSize="13">
                                    <UniformGrid Columns="5" Margin="5,10">
                                        <Border Background="#1794A1" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.AllLeads}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="ALL LEADS" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#1794A1" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.NewLeads}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="OPEN" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Stats.NewLeadsPercentage, StringFormat={}({0}%)}" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#1794A1" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.FollowupLeads}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="FOLLOW UP" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Stats.FollowupLeadsPercentage, StringFormat={}({0}%)}" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#1794A1" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.NoFollowupLeads}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="NO FOLLOW UP" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="(Since 30 Days)" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                                <!--<TextBlock Text="{Binding Stats.NoFollowupLeadsPercentage, StringFormat={}({0}%)}" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>-->
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#1794A1" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.Dead}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="DEAD" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Stats.DeadPercentage, StringFormat={}({0}%)}" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#21B19C" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.Customers}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="CUSTOMERS" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Stats.CustomersPercentage, StringFormat={}({0}%)}" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#21B19C" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.NoUpdation7Days}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="NO UPDATION" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="(Since 7 Days)" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#21B19C" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.NoRepeatOrder}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="NO REPEAT ORDER" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#21B19C" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.NoOrder}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="NO ORDER" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="(Since 30 Days)" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#21B19C" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.BelowTarget}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="BELOW TARGET" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Text="(Last Month)" Foreground="White" FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Expander>
                            </materialDesign:Card>

                            <materialDesign:Card Margin="5,10,5,15" Background="White" UniformCornerRadius="6">
                                <Expander Header="Order Counters" IsExpanded="False" Background="Transparent" Foreground="#2C3E50" FontWeight="Bold" FontSize="13">
                                    <UniformGrid Columns="5" Margin="5,10">
                                        <Border Background="#F4F6F7" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.TotalOrders}" FontSize="24" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Total Orders" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F4F6F7" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.TotalNewOrders}" FontSize="24" FontWeight="Bold" Foreground="#2980B9" HorizontalAlignment="Center"/>
                                                <TextBlock Text="First Orders" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F4F6F7" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.TotalRepeatedOrders}" FontSize="24" FontWeight="Bold" Foreground="#8E44AD" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Repeated Orders" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F4F6F7" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.TotalUnpaidOrders}" FontSize="24" FontWeight="Bold" Foreground="#C0392B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Unpaid Orders" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F4F6F7" CornerRadius="6" Margin="4" Padding="10" Height="85">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stats.TotalPartialPaidOrders}" FontSize="24" FontWeight="Bold" Foreground="#F39C12" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Partially Paid" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Expander>
                            </materialDesign:Card>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                        <StackPanel Margin="20,0,0,0">
                            <materialDesign:Card Padding="15" Margin="0,0,0,15" Background="White">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total Business: " FontWeight="Bold" Foreground="#666" FontSize="16"/>
                                    <TextBlock Text="{Binding Stats.TotalBusiness, StringFormat='{}{0:N2}'}" 
                       Foreground="#1794A1" FontWeight="Bold" FontSize="16" Margin="5,0,0,0"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <Expander Header="Reminders" Background="White" BorderThickness="0,0,0,1" BorderBrush="#EEE">
                                <ItemsControl ItemsSource="{Binding ReminderCounters}" Margin="10,5">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#129A98" CornerRadius="4" Padding="8,4" Margin="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Key}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" - " Foreground="White" FontSize="12"/>
                                                    <TextBlock Text="{Binding Value}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Expander Header="Followup Stages" Background="White" BorderThickness="0,0,0,1" BorderBrush="#EEE">                                
                                    <ItemsControl ItemsSource="{Binding FollowupStagesCounters}" Margin="10,5">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="8,4" Margin="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F39C12"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Key}" Value="All FollowUps">
                                                                    <Setter Property="Background" Value="#129A98"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Key}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text=" - " Foreground="White" FontSize="12"/>
                                                        <TextBlock Text="{Binding Value}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </Expander>
                            <Expander Header="Mature Stages" Background="White" BorderThickness="0,0,0,1" BorderBrush="#EEE">                                
                                    <ItemsControl ItemsSource="{Binding MatureStagesCounters}" Margin="10,5">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="8,4" Margin="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#2ECC71"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Key}" Value="All Matured">
                                                                    <Setter Property="Background" Value="#129A98"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Key}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text=" - " Foreground="White" FontSize="12"/>
                                                        <TextBlock Text="{Binding Value}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </Expander>
                            <Expander Header="Lead Labels" Background="White" BorderThickness="0,0,0,1" BorderBrush="#EEE">                                
                                    <ItemsControl ItemsSource="{Binding LeadLabelsCounters}" Margin="10,5">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="8,4" Margin="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#2ECC71"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Key}" Value="All Labels">
                                                                    <Setter Property="Background" Value="#129A98"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Key}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text=" - " Foreground="White" FontSize="12"/>
                                                        <TextBlock Text="{Binding Value}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="MIS" />
        </TabControl>
    </Grid>
</UserControl>
