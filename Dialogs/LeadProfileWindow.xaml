<Window x:Class="CallMan.Dialogs.LeadProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        xmlns:conv="clr-namespace:CallMan.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding SelectedLead.CustomerName, StringFormat='Profile: {0}', FallbackValue='Loading Profile...', TargetNullValue='New Lead'}"
        Height="650" Width="850" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <materialDesign:BooleanToVisibilityConverter x:Key="InvertedVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
    </Window.Resources>

    <Grid Background="#F5F7F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Details Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Tabs & Data -->
        <materialDesign:Card Grid.Row="0" Padding="20" Background="#F5F5F5" Visibility="{Binding IsInfoTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Contact -->
                <StackPanel Grid.Column="0">
                    <TextBlock><Run Text="Firm name: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.CompanyName}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Email: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.Email}" Foreground="#2196F3"/></TextBlock>
                    <TextBlock><Run Text="Phone: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.Phone}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Location: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.State}"/></TextBlock>
                </StackPanel>

                <!-- Column 2: Status -->
                <StackPanel Grid.Column="1">
                    <TextBlock><Run Text="Customer Since: " FontWeight="Bold"/><Run Text="{Binding Metrics.CustomerSince}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Last 3 months billing: " FontWeight="Bold"/><Run Text="{Binding Metrics.Last3MonthsBilling}"/></TextBlock>
                    <TextBlock><Run Text="Last order date: " FontWeight="Bold"/><Run Text="{Binding Metrics.LastOrderDate}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Outstanding: " FontWeight="Bold"/><Run Text="{Binding Metrics.OutstandingAmount}" Foreground="Red"/></TextBlock>
                </StackPanel>

                <!-- Column 3: Business/Target -->
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Business Done/Target" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock><Run Text="Monthly: " Foreground="Red"/><Run Text="{Binding Metrics.MonthlyBusiness}"/></TextBlock>
                        <TextBlock><Run Text="Last 3 Months: " Foreground="Red"/><Run Text="{Binding Metrics.Last3MonthsBusiness}"/></TextBlock>
                        <TextBlock><Run Text="Overall: " Foreground="#2196F3"/><Run Text="{Binding Metrics.OverallBusiness}"/></TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </materialDesign:Card>
        <TabControl Grid.Row="1" Margin="10" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabWorkspaceIndex, UpdateSourceTrigger=PropertyChanged}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Margin="0,0,4,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="ArrowDown" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsInfoTabSelected, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="True">
                                            <Setter Property="Kind" Value="ArrowUp"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Text="Info"/>
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem Header="Profile"/>

            <TabItem Header="Update Here" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Border Background="White" Padding="20" CornerRadius="0,0,5,5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <RadioButton Content="Followup" IsChecked="{Binding IsFollowup}" Margin="0,0,20,0" Foreground="#00897B"/>
                                <RadioButton Content="Matured" IsChecked="{Binding IsMatured}" Margin="0,0,20,0"/>
                                <RadioButton Content="Dead" IsChecked="{Binding IsDead}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsMatured, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Order Value *" Foreground="Red" FontSize="12" Margin="0,5"/>
                                <TextBox Text="{Binding OrderValue, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Amount"/>

                                <TextBlock Text="Payment Received" Foreground="#555" Margin="0,10,0,5"/>
                                <TextBox Text="{Binding PaymentReceived, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Payment Amount"/>

                                <Border Background="#FFF4F4" Margin="0,10,0,15" Padding="10" CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Balance Due: " VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding BalancePayment, StringFormat='₹ {0:N2}'}" FontWeight="Bold" Foreground="Red" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <CheckBox Content="Re-order" IsChecked="{Binding IsReorder}" Margin="0,5"/>
                                <CheckBox Content="Payment Reminder" IsChecked="{Binding IsPaymentReminder}" Margin="0,5,0,15"/>
                                <Separator Margin="0,10" Background="#EEE"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsDead, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,0,0,5">
                <Run Text="Dead Reason" FontWeight="SemiBold" Foreground="#555"/>
                <Run Text=" *" Foreground="Red"/>
                                </TextBlock>
                                <ComboBox ItemsSource="{Binding DeadReasons}" 
                      SelectedItem="{Binding SelectedDeadReason}"
                                          DisplayMemberPath="Name"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:HintAssist.Hint="Select Reason"
                      Margin="0,0,0,15"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsDead, Converter={StaticResource InvertedVisibilityConverter}}">
                                <StackPanel Visibility="{Binding IsFollowup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Followup Stages *" Foreground="#555"/>
                                    <ComboBox ItemsSource="{Binding FollowupStages}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Name" Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="Select Reason" Margin="0,5,0,15"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Next Followup Date *"/>
                                        <DatePicker SelectedDate="{Binding NextFollowupDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayDateStart="{Binding MinDate}" Margin="0,5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

                                        <TextBlock Text="Next Followup Time" Foreground="#555" Margin="0,0,0,5"/>

                                        <materialDesign:TimePicker SelectedTime="{Binding SelectedTime}" Is24Hours="False" materialDesign:HintAssist.Hint="Pick Time" materialDesign:TextFieldAssist.HasClearButton="True" VerticalAlignment="Center" xml:lang="en-IN" />

                                        <TextBlock Text="Clock icon appears on hover/focus" FontSize="10" FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="Message *" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding Message}" Height="80" TextWrapping="Wrap" Margin="0,5,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <CheckBox Content="Priority" IsChecked="{Binding IsPriority}" Margin="0,0,20,0"/>
                                <CheckBox Content="Receive system notification"/>
                            </StackPanel>

                            <TextBlock Text="Select Action" FontWeight="SemiBold" Margin="0,15,0,5" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                                <RadioButton Content="Call" 
                 IsChecked="{Binding SelectedAction, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Call}" 
                 Margin="0,0,15,0"/>

                                <RadioButton Content="Meeting" 
                 IsChecked="{Binding SelectedAction, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Meeting}" 
                 Margin="0,0,15,0"/>

                                <RadioButton Content="Whatsapp" 
                 IsChecked="{Binding SelectedAction, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Whatsapp}" 
                 Margin="0,0,15,0"/>

                                <RadioButton Content="Update" 
                 IsChecked="{Binding SelectedAction, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Update}"/>
                            </StackPanel>

                            <Button Content="Update" Command="{Binding UpdateLeadStatusCommand}" 
                                Background="#FF8A65" Foreground="White" Width="120" Height="35" 
                                Margin="0,30,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
