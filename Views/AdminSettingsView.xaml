<UserControl x:Class="Tijori.Views.AdminSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:security="clr-namespace:Tijori.Core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <materialDesign:BooleanToVisibilityConverter x:Key="InverseBoolToVis" TrueValue="Collapsed" FalseValue="Visible" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="SidebarIconButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- Added explicit x:Name so properties can alter it directly without clipping borders -->
                        <Border x:Name="IconContainer" 
                        CornerRadius="8" 
                        Background="{TemplateBinding Background}" 
                        BorderThickness="0"
                                Margin="5,0"
                        SnapsToDevicePixels="True">

                            <!-- Forces the ContentPresenter template vector graphics to remain perfectly centered -->
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover Effect: Targets the container directly -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconContainer" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#1794A1"/>
                            </Trigger>
                            <!-- Active State: Targets the container directly -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconContainer" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#1794A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Web-Style Minimalist Grid Tile Layout Buttons -->
        <!-- Premium Web-Style Minimalist Grid Tile Layout Buttons -->
        <Style x:Key="ModernActionCardStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Give the Card an explicit x:Name so triggers can modify it -->
                        <materialDesign:Card x:Name="CardContainer" 
                                      UniformCornerRadius="8" 
                                      Background="{TemplateBinding Background}" 
                                      BorderBrush="{TemplateBinding BorderBrush}" 
                                      BorderThickness="{TemplateBinding BorderThickness}" 
                                      materialDesign:ElevationAssist.Elevation="Dp2"
                                      Padding="0">
                            <Grid>
                                <!-- Left Active Indicator Bar Line accent -->
                                <Border x:Name="AccentBar" Width="4" HorizontalAlignment="Left" Background="Transparent" CornerRadius="2,0,0,2"/>

                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </materialDesign:Card>

                        <!-- CLEAN FIX: Targeting properties by name cleanly inside the ControlTemplate Triggers -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardContainer" Property="Background" Value="#FAFBFC"/>
                                <Setter TargetName="CardContainer" Property="BorderBrush" Value="#1794A1"/>
                                <Setter TargetName="CardContainer" Property="materialDesign:ElevationAssist.Elevation" Value="Dp4"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="#1794A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Navigation Menu Side Rail Column Panel Layout -->
            <ColumnDefinition Width="Auto"/>

            <!-- Right Workspace Pane View Container -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================= -->
        <!-- INTERACTIVE ANIMATED SIDEBAR NAVIGATION RAIL                      -->
        <!-- ================================================================= -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="White" BorderThickness="0,0,1,0" BorderBrush="#E2E8F0" Width="50" HorizontalAlignment="Left">
            <Border.Triggers>
                <EventTrigger RoutedEvent="ToggleButton.Checked" SourceName="BtnMenuToggle">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SidebarBorder" 
                                     Storyboard.TargetProperty="Width" 
                                     To="240" 
                                     Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="ToggleButton.Unchecked" SourceName="BtnMenuToggle">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SidebarBorder" 
                                     Storyboard.TargetProperty="Width" 
                                     To="50" 
                                     Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Grid Margin="0,16">
                    <Grid.RowDefinitions>
                        <!-- Top Control Core Modules -->
                        <RowDefinition Height="Auto"/>
                        <!-- Delimiter Split Line -->
                        <RowDefinition Height="Auto"/>
                        <!-- Main Category Action Anchors -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Burger / Expander Toggle Button Container -->
                <ToggleButton x:Name="BtnMenuToggle" Grid.Row="0" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left" Width="50" Height="50" Margin="0,0,0,30" Background="Transparent" Foreground="#1794A1">
                    <materialDesign:PackIcon Kind="Menu" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
                    
                    <Border Grid.Row="1" Height="1" Background="#E2E8F0" HorizontalAlignment="Stretch" Margin="8,0,8,12"/>
                    <!-- Navigation List Item Buttons Array Block -->
                <StackPanel Grid.Row="2" VerticalAlignment="Top">
                    <RadioButton Style="{StaticResource SidebarIconButtonStyle}" IsChecked="True" x:Name="RbInternalSetup" Click="SidebarButton_Click" Tag="InternalSetup">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Build" Width="20" Height="20" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Internal Setup" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarIconButtonStyle}" x:Name="RbLeadSettings" Click="SidebarButton_Click" Tag="LeadSettings" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Settings" Width="20" Height="20" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lead Settings" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarIconButtonStyle}" x:Name="RbIntegrations" Click="SidebarButton_Click" Tag="Integrations">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SourceMerge" Width="20" Height="20" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Third Party Integrations" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarIconButtonStyle}" x:Name="RbAutomations" Click="SidebarButton_Click" Tag="Automations" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Automatic" Width="20" Height="20" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Automations" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarIconButtonStyle}" x:Name="RbManufacturing" Click="SidebarButton_Click" Tag="Manufacturing" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Manufacturing" Width="20" Height="20" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Manufacturing" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- MAIN MAIN WORKSPACE DISPLAY FRAMEWORK CONTAINER PANELS            -->
        <!-- ================================================================= -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Global Actions Section Area Banner Panel Line -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Admin Settings Workspace" FontSize="26" FontWeight="Bold" Foreground="#1794A1" HorizontalAlignment="Left"/>
                <Button Command="{Binding BackToGridCommand}" 
                        Visibility="{Binding IsMainGridVisible, Converter={StaticResource InverseBoolToVis}}"
                        Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Right" Content="{Binding BackButtonContent, FallbackValue='↑ Back to Settings Dashboard'}" FontSize="14" FontWeight="SemiBold"/>
            </DockPanel>

            <!-- DYNAMIC SCREEN ROUTER INTERFACE CONTAINER CONTROLS -->
            <Grid Grid.Row="1">
                <!-- Outer Switch Route Content Controls Layer Frame -->
                <ContentControl Content="{Binding CurrentSettingView}" Visibility="{Binding IsMainGridVisible, Converter={StaticResource InverseBoolToVis}}"/>

                <!-- Primary Unified Layout Control Panels Matrix Wrapper -->
                <ScrollViewer x:Name="MainWorkspaceScroller" Visibility="{Binding IsMainGridVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" ScrollChanged="MainWorkspaceScroller_OnScrollChanged">
                    <VirtualizingStackPanel Orientation="Vertical">

                        <!-- TOP BAR BOX BLOCK: DATABASE SERVICES AND CONNECTIVITY OPTION CARD -->
                        <materialDesign:Card Padding="24" Margin="4,0,4,24" Background="White" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Network Connectivity Mode"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToggleVisible}" Value="False">
                                                        <Setter Property="Text" Value="Cloud Environment Mode"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock FontSize="13" Foreground="#4B5563" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,6,0,0" LineHeight="18">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Allows cloud communications like external webhook automations, email server syncing, and background notifications."/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToggleVisible}" Value="False">
                                                        <Setter Property="Text" Value="TIJORI is running on an active cloud configuration environment. Core communications, webhooks, and live background synchronization pipelines are permanently operational."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="⚠️ Keeping the software offline is highly recommended for isolated local office speeds."/>
                                                <Setter Property="Foreground" Value="#EA580C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToggleVisible}" Value="False">
                                                        <Setter Property="Text" Value="✅ Cloud database synchronization pipelines are operating securely over a verified network connection."/>
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Command="{Binding ChangeDatabaseConfigCommand}" 
                                            Content="🔧 Change Database Server Configuration" 
                                            Style="{StaticResource MaterialDesignFlatButton}" 
                                            Foreground="#2563EB" FontSize="13" FontWeight="SemiBold" 
                                            HorizontalAlignment="Left" Margin="0,12,0,0" Padding="0" Height="24"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <TextBlock Width="65" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13" FontWeight="Black">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="OFFLINE"/>
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ToggleOnlineServices}" Value="True">
                                                        <Setter Property="Text" Value="ONLINE"/>
                                                        <Setter Property="Foreground" Value="#1794A1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToggleVisible}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ToggleButton Cursor="Hand" VerticalAlignment="Center"
                                                  IsChecked="{Binding ToggleOnlineServices, Mode=TwoWay}"
                                                  Command="{Binding UpdateOnlineServicesOptionCommand}"
                                                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                                  ToolTip="Switch software modes between connected networks and completely local network layers.">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToggleVisible}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <!-- SECURITY CONTROL CARD (MERGED SYSTEM SECURITY MANAGEMENT WIDGET PANEL) -->
                        <materialDesign:Card Padding="20" Margin="4,0,4,24" Background="White" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp4">
                            <StackPanel>
                                <TextBlock Text="Security &amp; Policy Settings" Style="{StaticResource MaterialDesignBodyLargeTextBlock}" Margin="0,0,0,4" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Manage global access restrictions and multi-factor authentication requirements requirements across standard installations." Style="{StaticResource MaterialDesignBody2TextBlock}" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Enforce Global Action-Level 2FA Protection Layer" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" FontSize="14" Foreground="#374151"/>
                                        <TextBlock Text="When activated, protected buttons (Downloads, Document Views, etc) demand an administrative token confirmation window challenge sequence." Style="{StaticResource MaterialDesignBody2TextBlock}" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" Cursor="Hand"
                                                      IsChecked="{Binding IsMaster2FAEnabled}" 
                                                      Command="{Binding ProcessPolicyToggleCommand}"
                                                      IsEnabled="{Binding IsRegistrationPending, Converter={StaticResource InverseBoolToVis}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- NESTED QR SYSTEM GRAPHIC ZONE (DISPLAY ONLY WHEN GENERATING TOKENS INTERNALLY) -->
                                <Border Margin="0,16,0,0" Padding="16" Background="#1E1E1E" CornerRadius="8" Visibility="{Binding IsRegistrationPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderThickness="1" BorderBrush="#444" Background="White" Padding="6" CornerRadius="4" Width="120" Height="120" VerticalAlignment="Center">
                                            <Image Source="{Binding AdminQrCodeSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="PAIR SYSTEM ADMINISTRATOR SMARTPHONE TOOL" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                            <TextBlock Text="Scan code via Google/Microsoft Authenticator app then verify the configuration token down below." Foreground="LightGray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding VerificationCodeInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" FontSize="16" TextAlignment="Center" FontWeight="Bold" Width="140" HorizontalAlignment="Left" Height="38" Padding="5,0" VerticalContentAlignment="Center" materialDesign:HintAssist.Hint="XXXXXX" materialDesign:HintAssist.Foreground="Black" Background="WhiteSmoke" Foreground="Black" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            <TextBlock Text="{Binding SecurityErrorMessage}" Foreground="OrangeRed" FontSize="11" Margin="4,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="VERIFY &amp; CONFIRM" Command="{Binding ConfirmAdminRegistrationCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#2193b0" Foreground="White" Margin="0,0,10,0" Height="34" FontSize="11"/>
                                                <Button Content="CANCEL" Command="{Binding CancelRegistrationChangeCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="DarkGray" Height="34" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- ================================================================= -->
                        <!-- CATEGORY WORKSPACE MATRIX VIEWS (LINKED DIRECTLY TO RAIL ACTIONS) -->
                        <!-- ================================================================= -->

                        <!-- WORKSPACE VIEW 1: INTERNAL SETUP MATRICES GRID -->
                        <StackPanel x:Name="SecInternalSetup" Margin="0,0,0,32">
                            <TextBlock Text="INTERNAL INFRASTRUCTURE SETTINGS" FontSize="12" FontWeight="Black" Foreground="#64748B" Margin="8,0,0,8"/>
                            <UniformGrid Columns="4">
                                <Button Style="{StaticResource ModernActionCardStyle}" security:SecurityGuard.Requires="Divisions:View" CommandParameter="CProfile" Command="{Binding NavigateToSettingCommand}" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ViewGrid" Foreground="#1794A1" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Divisions" FontSize="13" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernActionCardStyle}" security:SecurityGuard.Requires="User:View" CommandParameter="Staff" Command="{Binding NavigateToSettingCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AccountGroup" Foreground="#1794A1" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Staff Management" FontSize="13" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernActionCardStyle}" CommandParameter="Permissions" Command="{Binding NavigateToSettingCommand}" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ShieldKey" Foreground="#1794A1" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Permissions Profile" FontSize="13" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernActionCardStyle}" security:SecurityGuard.Requires="OrderStage:View" CommandParameter="OrderStages" Command="{Binding NavigateToSettingCommand}" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="StepForward" Foreground="#1794A1" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Order Stages" FontSize="13" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernActionCardStyle}" security:SecurityGuard.Requires="CustomFields:View" CommandParameter="CustomFields" Command="{Binding NavigateToSettingCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="TextBoxPlus" Foreground="#1794A1" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Custom Data Fields" FontSize="13" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernActionCardStyle}" security:SecurityGuard.Requires="Categories:View" CommandParameter="Category" Command="{Binding NavigateToSettingCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Layers" Foreground="#1794A1" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="All Categories" FontSize="13" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernActionCardStyle}" IsEnabled="False" CommandParameter="Fetch" Command="{Binding NavigateToSettingCommand}" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FileDocumentEdit" Foreground="#94A3B8" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Proforma Invoice" FontSize="13" FontWeight="Medium" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernActionCardStyle}" IsEnabled="False" CommandParameter="Notice" Command="{Binding NavigateToSettingCommand}" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Bullhorn" Foreground="#94A3B8" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Notice Board Info" FontSize="13" FontWeight="Medium" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernActionCardStyle}" CommandParameter="Schemes" Command="{Binding NavigateToSettingCommand}" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Finance" Foreground="#1794A1" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Schemes &amp; Incentives" FontSize="13" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernActionCardStyle}" security:SecurityGuard.Requires="LoginLogs:View" CommandParameter="Logs" Command="{Binding NavigateToSettingCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="History" Foreground="#1794A1" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="User Login Logs" FontSize="13" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernActionCardStyle}" IsEnabled="False" CommandParameter="HRMS" Command="{Binding NavigateToSettingCommand}" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Register" Foreground="#1794A1" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="HRMS" FontSize="13" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>

                        <!-- WORKSPACE VIEW 2: SALES LEAD MODULE TRACKING GRID -->
                        <StackPanel x:Name="SecLeadSettings" Margin="0,0,0,32" Visibility="Collapsed">
                            <TextBlock Text="SALES LEAD PIPELINE RULES" FontSize="12" FontWeight="Black" Foreground="#64748B" Margin="8,0,0,8"/>
                            <UniformGrid Columns="4">
                                <Button Style="{StaticResource ModernActionCardStyle}" IsEnabled="False" security:SecurityGuard.Requires="Location:View">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="MapMarkerPlus" Foreground="#94A3B8" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Add New Location" FontSize="13" FontWeight="Medium" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernActionCardStyle}" CommandParameter="Dead Reasons" Command="{Binding NavigateToSettingCommand}" security:SecurityGuard.Requires="DeadReason:View">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CloseCircle" Foreground="#1794A1" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Dead Reasons" FontSize="13" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernActionCardStyle}" CommandParameter="Followup Stages" Command="{Binding NavigateToSettingCommand}" security:SecurityGuard.Requires="FollowupStage:View">
                                    <StackPanel HorizontalAlignment="Center">
