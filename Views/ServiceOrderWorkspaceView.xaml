<UserControl x:Class="Tijori.Views.ServiceOrderWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Tijori.Converters"
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F8FAFC">
    <UserControl.Resources>
        <materialDesign:BooleanToVisibilityConverter x:Key="InvertedBoolToVisConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <materialDesign:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
        <conv:StringMatchToVisConverter x:Key="StringMatchToVisConverter" />
        <conv:InvertedStringMatchToVisConverter x:Key="InvertedStringMatchToVisConverter" />
    </UserControl.Resources>
    <Grid Margin="16">

        <!-- ========================================================================= -->
        <!-- VIEW 1: ORDERS DIRECTORY / REGISTRY (Shown when IsFormOpen = False)       -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource InvertedBoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. TOOLBAR -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12" Margin="0,0,0,14">
                <DockPanel LastChildFill="False">

                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClipboardTextMultipleOutline" Width="26" Height="26" Foreground="#1794A1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Service Line Orders" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <Border Background="#E0F2FE" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalOrdersCount, StringFormat='{}{0} Orders'}" FontSize="10.5" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Contract manufacturing orders with multi-brand line batch tracking" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Search Box -->
                        <Border Background="#F1F5F9" CornerRadius="6" Width="260" Height="38" Padding="8,0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Grid.Column="0" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="Search by Order #, Customer..."
                                         BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"/>
                            </Grid>
                        </Border>

                        <Button Command="{Binding OpenCreateOrderCommand}" 
                                Background="#1794A1" BorderBrush="#1794A1" Foreground="White" 
                                FontWeight="SemiBold" Height="38" Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="CREATE ORDER" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. DIRECTORY DATA TABLE -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <DataGrid ItemsSource="{Binding FilteredOrders}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True"
                          RowHeight="44" 
                          GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#F1F5F9" 
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Order #" Binding="{Binding OrderNumber}" FontWeight="Bold" Width="140"/>
                        <DataGridTextColumn Header="Customer / Client" Binding="{Binding CustomerName}" FontWeight="SemiBold" Width="2*"/>
                        <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="120"/>
                        <DataGridTextColumn Header="Due Date" Binding="{Binding DeliveryDueDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="120"/>

                        <!-- Batch Work Orders Count Badge -->
                        <DataGridTemplateColumn Header="Batches" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BatchOrdersCount, StringFormat='{}{0} Batches'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Grand Total" Binding="{Binding GrandTotalAmount, StringFormat='{}{0:C}'}" FontWeight="Bold" Width="130"/>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OrderStatus}" FontSize="9.5" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <!-- 🚀 Approve & Release to Production -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                            Command="{Binding DataContext.ApproveAndReleaseToProductionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" 
                                            ToolTip="Approve &amp; Release to Production"
                                            Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                                            Visibility="{Binding OrderStatus, Converter={StaticResource StringMatchToVisConverter}, ConverterParameter='Draft'}">
                                            <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" Foreground="#16A34A"/>
                                        </Button>

                                        <!-- ✏️ Edit Order -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                            Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" 
                                            ToolTip="Open / Edit Order"
                                            Width="28" Height="28" Padding="0" Margin="0,0,4,0">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" Foreground="#D97706"/>
                                        </Button>

                                        <!-- 🗑️ Delete Order -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                            Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" 
                                            ToolTip="Delete Order"
                                            Width="28" Height="28" Padding="0">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="#EF4444"/>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- VIEW 2: 2-STEP ORDER CREATION WIZARD (Shown when IsFormOpen = True)       -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- ============================================================= -->
            <!-- STEP 1: COMPACT PRODUCT & FORMULATION BUILDER                 -->
            <!-- ============================================================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 1. Order Header Ribbon -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2. Compact Product Specs -->
                    <RowDefinition Height="*"/>
                    <!-- 3. Maximized BOM DataGrid Table -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4. Action Footer -->
                </Grid.RowDefinitions>

                <!-- 1. ORDER HEADER RIBBON -->
                <Border Grid.Row="0" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Back & Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding CloseWizardCommand}" Width="26" Height="26" Padding="0" Margin="0,0,6,0">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Foreground="#475569"/>
                            </Button>
                            <TextBlock Text="New Service Order" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Order Reference # -->
                        <TextBox Grid.Column="1" Text="{Binding CurrentOrder.OrderNumber, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Order #" Padding="10,10,0,0"
                         materialDesign:HintAssist.IsFloating="True"
                         FontSize="11.5" Height="34" Margin="0,0,8,0"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <!-- Customer Selector -->
                        <ComboBox Grid.Column="2" ItemsSource="{Binding CustomersList}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="CustomerName"
                          IsEnabled="{Binding CanChangeCustomer}" Padding="10,0"
                          materialDesign:HintAssist.Hint="Select Customer / Client *" 
                          materialDesign:HintAssist.IsFloating="True"
                          FontSize="11.5" Height="34" Margin="0,0,8,0"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                        <!-- Order Date -->
                        <DatePicker Grid.Column="3" SelectedDate="{Binding CurrentOrder.OrderDate}" 
                            materialDesign:HintAssist.Hint="Order Date" Padding="10,10"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="11" Height="34" Margin="0,0,8,0"/>

                        <!-- Due Date -->
                        <DatePicker Grid.Column="4" SelectedDate="{Binding CurrentOrder.DeliveryDueDate}" 
                            materialDesign:HintAssist.Hint="Due Date" Padding="10,10"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="11" Height="34" Margin="0,0,10,0"/>

                        <!-- Cart Counter Pill -->
                        <Border Grid.Column="5" Background="#F0FDFA" BorderBrush="#1794A1" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CartOutline" Width="14" Height="14" Foreground="#1794A1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#1794A1">
                            <Run Text="{Binding ConfiguredProductsCount, Mode=OneWay}"/>
                            <Run Text=" Added"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. PRODUCT & PACKAGING SPECIFICATIONS -->
                <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" ItemsSource="{Binding CustomerBrandsList}" SelectedItem="{Binding SelectedBrand}" 
                              Text="{Binding CustomBrandText, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="BrandName" 
                              IsEditable="True" Padding="10,0"
                              materialDesign:HintAssist.Hint="Brand Name *" 
                              materialDesign:HintAssist.IsFloating="True"
                              FontSize="11.5" Height="34" Margin="0,0,6,0"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <ComboBox Grid.Column="1" ItemsSource="{Binding FinishedProductsList}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name" 
                              IsEditable="True" Padding="10,0"
                              materialDesign:HintAssist.Hint="Base Product / SKU (Optional)" 
                              materialDesign:HintAssist.IsFloating="True"
                              FontSize="11.5" Height="34" Margin="0,0,6,0"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <ComboBox Grid.Column="2" ItemsSource="{Binding MasterFormulationsList}" SelectedItem="{Binding SelectedFormulation}" DisplayMemberPath="FormulationName" 
                              materialDesign:TextFieldAssist.HasClearButton="True" Padding="10,0"
                              materialDesign:HintAssist.Hint="Master Formulation (Optional)" 
                              materialDesign:HintAssist.IsFloating="True"
                              FontSize="11.5" Height="34" Margin="0,0,6,0"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <TextBox Grid.Column="3" Text="{Binding ActiveItem.TargetQuantity, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Order Qty *" Padding="10,10,0,0"
                             materialDesign:HintAssist.IsFloating="True"
                             FontSize="11.5" Height="34" Margin="0,0,6,0"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <TextBox Grid.Column="4" Text="{Binding ActiveItem.UnitPrice, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Unit Rate (₹)" Padding="10,10,0,0"
                             materialDesign:HintAssist.IsFloating="True"
                             FontSize="11.5" Height="34"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" ItemsSource="{Binding PackagingTypes}" Text="{Binding ActiveItem.PackagingType}" IsEditable="True" 
                              materialDesign:HintAssist.Hint="Packaging Type" Padding="10,0"
                              materialDesign:HintAssist.IsFloating="True"
                              FontSize="11.5" Height="34" Margin="0,0,6,0"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <ComboBox Grid.Column="1" ItemsSource="{Binding CommonPackSizes}" Text="{Binding ActiveItem.PackSize}" IsEditable="True" 
                              materialDesign:HintAssist.Hint="Pack Size / Vol *" Padding="10,0"
                              materialDesign:HintAssist.IsFloating="True"
                              FontSize="11.5" Height="34" Margin="0,0,6,0"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <TextBox Grid.Column="2" Text="{Binding ActiveItem.ColorShade}" 
                             materialDesign:HintAssist.Hint="Color / Shade" Padding="10,10,0,0"
                             materialDesign:HintAssist.IsFloating="True"
                             FontSize="11.5" Height="34" Margin="0,0,6,0"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <ComboBox Grid.Column="3" ItemsSource="{Binding CommonFragrances}" Text="{Binding ActiveItem.FragranceFlavor}" IsEditable="True" 
                              materialDesign:HintAssist.Hint="Fragrance / Flavor" Padding="10,0"
                              materialDesign:HintAssist.IsFloating="True"
                              FontSize="11.5" Height="34"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. LIVE BOM DATA TABLE -->
                <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" Text="{Binding NewIngredientPhase}" IsEditable="True" Padding="10,0"
                              materialDesign:HintAssist.Hint="Phase" Height="32" FontSize="11" Margin="0,0,6,0"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                <ComboBoxItem Content="Phase A"/>
                                <ComboBoxItem Content="Phase B"/>
                                <ComboBoxItem Content="Phase C"/>
                                <ComboBoxItem Content="Phase D"/>
                            </ComboBox>

                            <ComboBox Grid.Column="1" ItemsSource="{Binding RawMaterialsList}" SelectedItem="{Binding SelectedRawMaterialToAdd}" DisplayMemberPath="Name" 
                              IsEditable="True" materialDesign:HintAssist.Hint="Search &amp; Add Raw Material / Chemical..." 
                              Height="32" FontSize="11" Margin="0,0,6,0" Padding="10,0"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <TextBox Grid.Column="2" Text="{Binding NewIngredientPercentage, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" 
                             materialDesign:HintAssist.Hint="Qty (%)" Height="32" FontSize="11" Margin="0,0,6,0" Padding="10,10,0,0"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <Button Grid.Column="3" Command="{Binding AddIngredientToActiveFormulaCommand}" Content="+ ADD RM" 
                            Background="#1794A1" BorderBrush="#1794A1" Foreground="White" FontWeight="Bold" FontSize="11" Height="32" Padding="10,0"/>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Active: " Foreground="#64748B" FontSize="11"/>
                                <TextBlock Text="{Binding ActiveBOMTotalPercentage, StringFormat='{}{0:N2}%'}" FontWeight="Bold" Foreground="#0F172A" FontSize="11.5" Margin="0,0,10,0"/>
                                <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="WaterPercent" Foreground="#0284C7" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="Water (QS): " Foreground="#0369A1" FontSize="10.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ActiveBOMWaterPercentage, StringFormat='{}{0:N2}%'}" FontWeight="Black" Foreground="#0369A1" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveBOMList}" 
                          AutoGenerateColumns="False" CanUserAddRows="False" 
                          RowHeight="30" FontSize="11.5"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          Style="{StaticResource MaterialDesignDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="80"/>
                                <DataGridTextColumn Header="Raw Material Name" Binding="{Binding RawMaterialName}" Width="2.5*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Percentage (%)" Binding="{Binding PercentageValue, StringFormat='{}{0:N2}%'}" FontWeight="Bold" Width="110"/>
                                <DataGridTextColumn Header="Batch Qty" Binding="{Binding CalculatedQuantity, StringFormat='{}{0:N3} Kg'}" FontWeight="Bold" Foreground="#0284C7" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Mixing Remarks" Binding="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTemplateColumn Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="20" Height="20" Padding="0" 
                                            Command="{Binding DataContext.RemoveIngredientFromActiveFormulaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13" Foreground="#EF4444"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 4. SLIM ACTION FOOTER -->
                <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="+ ADD PRODUCT TO ORDER" Command="{Binding AddItemToCartCommand}" 
                            Background="#0284C7" BorderBrush="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11.5" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                            <Button Content="PROCEED TO REVIEW ➔" Command="{Binding GoToStep2Command}" 
                            Background="#1794A1" BorderBrush="#1794A1" Foreground="White" FontWeight="Bold" FontSize="11.5" Height="32" Padding="16,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============================================================= -->
            <!-- STEP 2: REVIEW & FINAL SUBMISSION (CurrentStep == 2)          -->
            <!-- ============================================================= -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 1. Banner -->
                    <RowDefinition Height="*"/>
                    <!-- 2. Configured Products Review DataGrid -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3. Commercial Totals & Submit -->
                </Grid.RowDefinitions>

                <!-- 1. Banner with Order & Customer info -->
                <Border Grid.Row="0" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding GoToStep1Command}" Width="28" Height="28" Padding="0" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="#475569"/>
                            </Button>
                            <TextBlock Text="Step 2: Review Order &amp; Configured Product Recipes" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Customer: " Foreground="#64748B" FontSize="11.5"/>
                            <TextBlock Text="{Binding SelectedCustomer.CustomerName, FallbackValue='—'}" FontWeight="Bold" Foreground="#0F172A" FontSize="11.5" Margin="0,0,16,0"/>
                            <TextBlock Text="Order #: " Foreground="#64748B" FontSize="11.5"/>
                            <TextBlock Text="{Binding CurrentOrder.OrderNumber}" FontWeight="Bold" Foreground="#1794A1" FontSize="11.5"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 2. Configured Products Review Grid -->
                <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding CurrentOrder.Items}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40" Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Brand Name" Binding="{Binding BrandName}" FontWeight="Bold" Width="1.5*"/>
                            <DataGridTextColumn Header="Product / Recipe Name" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="Packaging Spec" Binding="{Binding PackagingType}" Width="120"/>
                            <DataGridTextColumn Header="Pack Size" Binding="{Binding PackSize}" FontWeight="SemiBold" Width="100"/>
                            <DataGridTextColumn Header="Order Qty" Binding="{Binding TargetQuantity, StringFormat='{}{0:N0}'}" FontWeight="Bold" Width="100"/>
                            <DataGridTextColumn Header="Unit Rate" Binding="{Binding UnitPrice, StringFormat='{}{0:C}'}" Width="100"/>
                            <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat='{}{0:C}'}" FontWeight="Bold" Foreground="#15803D" Width="120"/>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="24" Height="24" Padding="0" 
                                        Command="{Binding DataContext.RemoveLineItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#EF4444"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 3. Commercial Totals & Action Footer -->
                <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="← BACK TO EDIT" Command="{Binding GoToStep1Command}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Margin="0,0,8,0"/>
                            <Button Content="CANCEL" Command="{Binding CloseWizardCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Margin="0,0,8,0"/>
                            <Button Content="SUBMIT SERVICE ORDER" Command="{Binding SubmitOrderCommand}" Background="#1794A1" BorderBrush="#1794A1" Foreground="White" FontWeight="Bold" Height="34" Padding="18,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Sub Total:" FontSize="10" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CurrentOrder.SubTotalAmount, StringFormat='{}{0:C}'}" FontSize="12.5" FontWeight="Bold" Foreground="#334155"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Taxes (GST):" FontSize="10" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CurrentOrder.TaxAmount, StringFormat='{}{0:C}'}" FontSize="12.5" FontWeight="Bold" Foreground="#334155"/>
                            </StackPanel>

                            <Border Background="#DCFCE7" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Grand Total: " FontWeight="SemiBold" Foreground="#15803D" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentOrder.GrandTotalAmount, StringFormat='{}{0:C}'}" FontWeight="Black" Foreground="#15803D" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
