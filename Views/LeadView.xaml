<UserControl x:Class="Tijori.Views.LeadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:conv="clr-namespace:Tijori.Converters"
             xmlns:security="clr-namespace:Tijori.Core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:LeadStatusToColorConverter x:Key="StatusToColorConverter"/>
        <conv:IndexToNumberConverter x:Key="IndexToNumberConverter"/>
        <conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>

        <DataTemplate x:Key="MainGridLeadLayoutTemplate">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Row 0: Top Utilities Panel -->
                    <RowDefinition Height="*"/>
                    <!-- Row 1: Core Leads DataGrid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: New Pagination Panel Footer -->
                </Grid.RowDefinitions>

                <!-- ==================================================================== -->
                <!-- ROW 0: TOP UTILITIES AND BATCH ACTIONS OPERATION PANEL               -->
                <!-- ==================================================================== -->
                <Border Grid.Row="0" Margin="0,0,0,15" Padding="10" Background="White" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="All Leads" FontSize="16" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>

                        <Menu Grid.Column="2" Background="#FF8A3D" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Menu.Style>
                                <Style TargetType="Menu">
                                    <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4"/>
                                    <Setter Property="IsEnabled" Value="{Binding SelectedLeadsCount, Converter={StaticResource GreaterThanZeroConverter}}"/>
                                </Style>
                            </Menu.Style>

                            <MenuItem Header="Action" FontWeight="SemiBold" FontSize="13" Height="32" Padding="20,5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <MenuItem Height="32" Width="30" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <MenuItem.Header>
                                    <materialDesign:PackIcon Kind="MenuDown" Width="20" Height="20" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,2,0,0"/>
                                </MenuItem.Header>
                                <MenuItem.Items>
                                    <MenuItem Header="Batch delete" Command="{Binding BulkDeleteCommand}" Height="35" FontSize="12" FontWeight="SemiBold" Background="White" Foreground="#334155" security:SecurityGuard.Requires="Lead:Delete"/>
                                    <MenuItem Header="Change Leadholder" Command="{Binding OpenChangeLeadHolderDialogCommand}" Height="35" FontSize="12" FontWeight="SemiBold" Background="White" Foreground="#334155" security:SecurityGuard.Requires="Lead:Edit"/>
                                    <MenuItem Header="Move to dead" Command="{Binding MoveToDeadCommand}" Height="35" FontSize="12" FontWeight="SemiBold" Background="White" Foreground="#334155" security:SecurityGuard.Requires="Lead:Edit"/>
                                    <MenuItem Header="Assign Labels" Command="{Binding OpenAssignLabelsDialogCommand}" Height="35" FontSize="12" FontWeight="SemiBold" Background="White" Foreground="#334155" security:SecurityGuard.Requires="Lead:Edit"/>
                                    <MenuItem Header="Assign Category" Command="{Binding OpenAssignCategoryDialogCommand}" Height="35" FontSize="12" FontWeight="SemiBold" Background="White" Foreground="#334155" security:SecurityGuard.Requires="Lead:Edit"/>
                                </MenuItem.Items>
                            </MenuItem>
                        </Menu>

                        <Button Grid.Column="3" Content="Import Leads" Command="{Binding OpenImportLeadsDialogCommand}" Padding="20,5" Background="#1794A1" Foreground="White" FontWeight="Bold" Margin="5,0" security:SecurityGuard.Requires="Lead:View" />
                        <Button Grid.Column="4" Content="+ New Lead" Command="{Binding OpenAddLeadDialogCommand}" Padding="20,5" Background="#1794A1" Foreground="White" FontWeight="Bold" Margin="5,0" security:SecurityGuard.Requires="Lead:Create" />
                    </Grid>
                </Border>

                <!-- ==================================================================== -->
                <!-- ROW 1: PRIMARY HARDWARE VIRTUALIZED LEAD DATA GRID MATRIX            -->
                <!-- ==================================================================== -->
                <DataGrid Grid.Row="1" GridLinesVisibility="All" BorderBrush="Black" BorderThickness="2" HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black" ItemsSource="{Binding LeadsCollection, IsAsync=True}" AlternationCount="9999" SelectedItem="{Binding SelectedLead}"
              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionUnit="FullRow" VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLengthUnit="Item" VirtualizingPanel.CacheLength="10,20" ScrollViewer.CanContentScroll="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- CheckBox & Index Serial Numbers Columns -->
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.Header>
                                <CheckBox Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="TxtSerialNumber" 
                                   Text="{Binding SerialNumber}" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center" 
                                   Foreground="DarkSlateGray"/>

                                        <CheckBox Grid.Row="1" IsChecked="{Binding IsSelectedForAction, UpdateSourceTrigger=PropertyChanged}" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Click="CheckBox_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Name / Company Profile Data Cell Column -->
                        <DataGridTemplateColumn Header="Name" MinWidth="170" MaxWidth="200" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock HorizontalAlignment="Left" FontSize="14" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="{Binding CompanyName, StringFormat=({0})}"/>
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CompanyName}" Value="">
                                                            <Setter Property="Text" Value=""/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CompanyName}" Value="{x:Null}">
                                                            <Setter Property="Text" Value=""/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CustomerName}" 
                                               TextWrapping="Wrap" 
                                               Cursor="Hand" 
                                               Foreground="CadetBlue" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Left">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                  Command="{Binding DataContext.ShowLeadWorkspaceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                  CommandParameter="{Binding}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                        <StackPanel Margin="0,5" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Button security:SecurityGuard.Requires="Lead:Update" BorderThickness="0" Padding="8" Margin="2" ToolTip="Update Info" Command="{Binding DataContext.OpenLeadProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Green" Foreground="White" FontWeight="Bold">
                                                <icon:BootstrapIcons Kind="JournalText"/>
                                            </Button>
                                            <Button security:SecurityGuard.Requires="Lead:Edit" BorderThickness="0" Padding="8" Margin="2" ToolTip="Edit Info" Command="{Binding DataContext.EditLeadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="CadetBlue" Foreground="White" FontWeight="Bold">
                                                <icon:BootstrapIcons Kind="PencilFill"/>
                                            </Button>
                                            <Button security:SecurityGuard.Requires="Lead:Delete" BorderThickness="0" Padding="8" Margin="2" ToolTip="Delete" Command="{Binding DataContext.DeleteLeadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="MediumPurple" Foreground="White" FontWeight="Bold">
                                                <icon:BootstrapIcons Kind="Trash3Fill"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock VerticalAlignment="Bottom" Text="{Binding CreatedAt, StringFormat={}Added: {0:dd/MM/yyyy}}" FontSize="10" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Contact Communications Cell Column -->
                        <DataGridTemplateColumn Header="Contact" Width="Auto" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <materialDesign:PackIcon Kind="Phone" Grid.Row="0" Grid.Column="0" FontSize="12" FontWeight="Bold" Visibility="{Binding ElementName=WhatsApp, Path=Visibility}" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="Phone" Grid.Row="1" Grid.Column="0" FontSize="12" FontWeight="Bold" Visibility="{Binding ElementName=WhatsApp1, Path=Visibility}" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="Mailbox" Grid.Row="2" Grid.Column="0" FontSize="12" FontWeight="Bold" Visibility="{Binding ElementName=Email, Path=Visibility}" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="MapMarker" Grid.Row="3" Grid.Column="0" FontSize="12" FontWeight="Bold" Visibility="{Binding ElementName=Map, Path=Visibility}" VerticalAlignment="Top"/>

                                        <StackPanel x:Name="WhatsApp" Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Phone}" TextWrapping="Wrap" FontSize="12" Margin="0" VerticalAlignment="Center"/>
                                            <Button BorderThickness="0" Command="{Binding DataContext.WhatsappCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Transparent" Margin="5,0" Padding="5" Foreground="Green">
                                                <materialDesign:PackIcon Kind="Whatsapp"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel x:Name="WhatsApp1" Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding AltPhone}" TextWrapping="Wrap" FontSize="12" Margin="0" VerticalAlignment="Center"/>
                                            <Button BorderThickness="0" Command="{Binding DataContext.WhatsappCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Transparent" Margin="5,0" Padding="5" Foreground="Green">
                                                <materialDesign:PackIcon Kind="Whatsapp"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="Email" Text="{Binding Email}" Grid.Row="2" Grid.Column="2" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <StackPanel x:Name="Map" Orientation="Vertical" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding AddressLine}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding City, StringFormat='{}{0}\, '}" FontSize="12" Margin="0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding District, StringFormat='{}{0}\, '}" FontSize="12" Margin="0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding State, StringFormat='{}{0}\, '}" FontSize="12" Margin="0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Pincode, StringFormat='{}{0}\, '}" FontSize="12" Margin="0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Country}" FontSize="12" Margin="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Phone}" Value="{x:Null}">
                                            <Setter TargetName="WhatsApp" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Phone}" Value="">
                                            <Setter TargetName="WhatsApp" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AltPhone}" Value="{x:Null}">
                                            <Setter TargetName="WhatsApp1" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AltPhone}" Value="">
                                            <Setter TargetName="WhatsApp1" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Email}" Value="{x:Null}">
                                            <Setter TargetName="Email" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Email}" Value="">
                                            <Setter TargetName="Email" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Null}">
                                            <Setter TargetName="Map" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="">
                                            <Setter TargetName="Map" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Relational Meta Assignments Cell Columns -->
                        <DataGridTemplateColumn Header="Lead Info" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LeadSource, StringFormat='{}Source: {0}'}" TextWrapping="Wrap" Foreground="Black" FontSize="12" Margin="0,5" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LeadTag, StringFormat='{}Tag: {0}'}" TextWrapping="Wrap" Foreground="Black" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LeadHolder, StringFormat='{}LeadHolder: {0}'}" TextWrapping="Wrap" Foreground="Black" FontSize="12" Margin="0,5" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CategoryName, StringFormat='{}Category: {0}'}" TextWrapping="Wrap" Foreground="Black" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Categorization Badges ItemsControl Reference Column -->
                        <DataGridTemplateColumn Header="Label" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding LeadLabels}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#b6f9fa" Margin="2" CornerRadius="10" Padding="5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Operating Business Division Segments Reference Column -->
                        <DataGridTemplateColumn Header="Divisions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding AssignedDivisions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#E1F5FE" CornerRadius="10" Padding="8,2" Margin="2">
                                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#0288D1" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Operational Flow Process Stages Context Column -->
                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border Background="{Binding Status, Converter={StaticResource StatusToColorConverter}, ConverterParameter=dark}" CornerRadius="10" Padding="5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="Red" Visibility="{Binding LatestUpdate.IsPriority, Converter={StaticResource BoolToVis}}" CornerRadius="10" Margin="0,15,0,0" Padding="5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="High Priority" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding LatestUpdate.FollowupStage}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Historic Tracker Logs Metric Summary Column -->
                        <DataGridTemplateColumn Header="Followup" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LatestUpdate.NextFollowUpDate, StringFormat={}{0:dd-MM-yyyy hh:mm tt}}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Border Background="LightSkyBlue" CornerRadius="5" Margin="0,10,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding HistoryCount, StringFormat='{}{0} followup'}" FontSize="12" TextWrapping="Wrap" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Communications Message Context Body Action Column -->
                        <DataGridTemplateColumn Header="Last Message" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding LatestUpdate.Message}" TextWrapping="Wrap" Height="40" FontSize="13" Foreground="#2C3E50"/>
                                            <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding LatestUpdate.LogDate, StringFormat={}{0:dd-MM-yyyy}}" TextWrapping="Wrap" FontSize="11" Foreground="#7F8C8D" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding LatestUpdate.UpdatedBy}" TextWrapping="Wrap" FontSize="11" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <Button Content="Lead History" Margin="0,10,0,0" FontSize="10" Height="22" Background="#1794A1" Foreground="White" BorderThickness="0"
                                    Command="{Binding DataContext.ShowHistoryDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <TextBlock Text="No message yet" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LatestUpdate}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Other Info" Binding="{Binding CustomInfoSummary}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ==================================================================== -->
                <!-- ROW 2: INTEGRATED SYSTEM PAGINATION COMPONENT FOOTER (image_7bc407)  -->
                <!-- ==================================================================== -->
                <Grid Grid.Row="2" Background="#F8FAFC" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Summary meta data context row info string -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Combobox entry dropdown configuration selector -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Dynamic page elements control switch layout box -->
                    </Grid.ColumnDefinitions>

                    <!-- Left Component Block Summary Context -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Showing " Foreground="#64748B" FontSize="13"/>
                        <TextBlock Text="{Binding StartEntry}" FontWeight="Bold" Foreground="#334155" FontSize="13"/>
                        <TextBlock Text=" to " Foreground="#64748B" FontSize="13"/>
                        <TextBlock Text="{Binding EndEntry}" FontWeight="Bold" Foreground="#334155" FontSize="13"/>
                        <TextBlock Text=" of " Foreground="#64748B" FontSize="13"/>
                        <TextBlock Text="{Binding TotalEntries}" FontWeight="Bold" Foreground="#334155" FontSize="13"/>
                        <TextBlock Text=" entries" Foreground="#64748B" FontSize="13"/>
                    </StackPanel>

                    <!-- Center Component Block Items Density Dropdown Config -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0">
                        <TextBlock Text="Show " Foreground="#64748B" FontSize="13" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay}"
                      Width="65" Height="28" Padding="6,2" FontSize="13" FontWeight="Bold" Background="White" BorderBrush="#CBD5E1" 
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <TextBlock Text=" entries" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- Right Component Block Context Routing Index Trays Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Previous" Command="{Binding NavigatePreviousCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Height="32" Padding="12,0" BorderBrush="#E2E8F0" Foreground="#475569" Background="White" FontSize="13"/>

                        <ItemsControl ItemsSource="{Binding PageItemsCollection}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DisplayText}" Command="{Binding DataContext.NavigateToSelectedPageCommand, RelativeSource={RelativeSource AncestorType=Grid}}" CommandParameter="{Binding}"
                                Height="32" Width="36" Padding="0" FontSize="13" BorderThickness="1,1,0,1">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Setter Property="Foreground" Value="#1794A1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#1794A1"/>
                                                        <Setter Property="BorderBrush" Value="#1794A1"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="Black"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsClickable}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Next" Command="{Binding NavigateNextCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Height="32" Padding="12,0" BorderBrush="#E2E8F0" Foreground="#475569" Background="White" FontSize="13" Margin="-1,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ==================================================================== -->
                <!-- OVERLAPPING MODAL INTERFACES DIALOG HOSTS SYSTEM PANEL               -->
                <!-- ==================================================================== -->
                <Grid Grid.RowSpan="3">
                    <!-- Expanded Grid.RowSpan to '3' to stretch across the full view height smoothly -->
                    <materialDesign:DialogHost IsOpen="{Binding IsChangeLeadHolderOpen}" CloseOnClickAway="True">
                        <materialDesign:DialogHost.DialogContent>
                            <Border Width="420" Padding="24" Background="White" CornerRadius="8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,20">
                                        <TextBlock Text="Change Leadholder" FontSize="16" FontWeight="Bold" Foreground="#374151"/>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding CloseAllDialogsCommand}" HorizontalAlignment="Right" Padding="0" Width="30" Height="30">
                                            <materialDesign:PackIcon Kind="Close" Foreground="#9CA3AF" Width="20" Height="20"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Select User To Assign" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding SystemUsersList}" SelectedItem="{Binding TargetSelectedUser}" DisplayMemberPath="DisplayName" materialDesign:HintAssist.Hint="Select..." Margin="0,0,0,16" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                    <CheckBox Content="Transfer as New" IsChecked="{Binding TransferAsNew}" Margin="0,0,0,20" FontWeight="SemiBold" Foreground="#4B5563"/>
                                    <TextBlock Text="Select Date" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding TransferSelectedDate}" Margin="0,0,0,20"/>
                                    <CheckBox Content="Send Notification to User" IsChecked="{Binding SendNotificationToUser}" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="#4B5563"/>
                                    <Button Content="Submit" Command="{Binding SubmitChangeLeadHolderCommand}" Height="42" Background="#FF8A3D" BorderBrush="#FF8A3D" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </materialDesign:DialogHost.DialogContent>
                    </materialDesign:DialogHost>

                    <materialDesign:DialogHost IsOpen="{Binding IsAssignLabelsOpen}" CloseOnClickAway="True">
                        <materialDesign:DialogHost.DialogContent>
                            <Border Width="400" Padding="24" Background="White" CornerRadius="8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,24">
                                        <TextBlock Text="Assign Labels" FontSize="16" FontWeight="Bold" Foreground="#374151"/>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding CloseAllDialogsCommand}" HorizontalAlignment="Right" Padding="0" Width="30" Height="30">
                                            <materialDesign:PackIcon Kind="Close" Foreground="#9CA3AF" Width="20" Height="20"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Lead Label" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" Margin="2,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding AvailableLabelsList}" SelectedItem="{Binding TargetSelectedLabel}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Select..." Margin="0,0,0,28" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                    <ItemsControl ItemsSource="{Binding SelectedLabelsList}" Margin="0,0,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <materialDesign:Chip Content="{Binding Name}" Margin="2" IsDeletable="True" DeleteCommand="{Binding DataContext.RemoveLabelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" DeleteCommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Submit" Command="{Binding SubmitAssignLabelsCommand}" Height="42" Background="#FF8A3D" BorderBrush="#FF8A3D" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </materialDesign:DialogHost.DialogContent>
                    </materialDesign:DialogHost>

                    <materialDesign:DialogHost IsOpen="{Binding IsAssignCategoryOpen}" Identifier="CategoryAssignmentDialogHost" CloseOnClickAway="True">

                        <materialDesign:DialogHost.DialogContent>
                            <Grid Width="380" Margin="20" Background="White">
                                <StackPanel>
                                    <TextBlock Text="Assign Category" FontSize="15" FontWeight="Bold" Margin="0,0,0,15" Foreground="#1E293B"/>

                                    <TextBlock Text="Select Category:" Margin="0,0,0,6" Foreground="#475569" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding CategoriesList}" 
                          SelectedItem="{Binding AssignedCategory}" 
                          DisplayMemberPath="CategoryName" 
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                          Margin="0,0,0,20"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancel" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                                        <Button Content="Submit" Command="{Binding SubmitCategoryAssignmentChangeCommand}" Background="#4F46E5" BorderBrush="Transparent"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </materialDesign:DialogHost.DialogContent>                        
                    </materialDesign:DialogHost>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProfileDetailWorkspaceTemplate">
            <local:LeadCustomerProfileView TabsDataContext="{Binding TabsDataContext}"/>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource MainGridLeadLayoutTemplate}"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.WorkspaceViewIsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource ProfileDetailWorkspaceTemplate}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>    
</UserControl>
