<Window x:Class="Tijori.Dialogs.PermissionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tijori.Dialogs"
        mc:Ignorable="d"
        Icon="/Assets/opn.png"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}" Height="700" Width="740" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Margin="0,0,0,12" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource MaterialDesignOutlinedTextBox}"
         materialDesign:HintAssist.Hint="Search module permissions..." 
         materialDesign:TextFieldAssist.HasClearButton="True"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredRowsView}" 
                  AutoGenerateColumns="False" CanUserAddRows="False" 
                  GridLinesVisibility="Horizontal" Background="White" RowHeight="40">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Module Name" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" FontWeight="SemiBold"/>

                <DataGridTemplateColumn Header="View" Width=".3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding CanView, UpdateSourceTrigger=PropertyChanged}" 
                                      Visibility="{Binding AllowView, Converter={StaticResource BoolToVis}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Create" Width=".3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding CanCreate, UpdateSourceTrigger=PropertyChanged}" 
                                      Visibility="{Binding AllowCreate, Converter={StaticResource BoolToVis}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Edit" Width=".3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding CanEdit, UpdateSourceTrigger=PropertyChanged}" 
                                      Visibility="{Binding AllowEdit, Converter={StaticResource BoolToVis}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Update" Width=".3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding CanUpdate, UpdateSourceTrigger=PropertyChanged}" 
                                      Visibility="{Binding AllowUpdate, Converter={StaticResource BoolToVis}}" Foreground="#1794A1"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Delete" Width=".3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding CanDelete, UpdateSourceTrigger=PropertyChanged}" 
                                      Visibility="{Binding AllowDelete, Converter={StaticResource BoolToVis}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#64748B" Command="{Binding CloseWindowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,0"/>
            <Button Content="Submit" Background="#1794A1" BorderBrush="#1794A1" Foreground="White" FontWeight="Bold" Command="{Binding SavePermissionsCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>
