<UserControl x:Class="Tijori.Views.VendorDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:model="clr-namespace:Tijori.Models"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <materialDesign:BooleanToVisibilityConverter TrueValue="Collapsed" FalseValue="Visible" x:Key="InverseBooleanToVisibilityConverter"/>
        <model:BindingProxy x:Key="DataContextProxy" Data="{Binding}" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header Profile Banner -->
            <RowDefinition Height="*"/>
            <!-- Tabbed Details Workspace -->
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- 1. TOP PROFILE HEADER BANNER                                      -->
        <!-- ================================================================= -->
        <Border Background="White" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Back Button -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Vendor Avatar Initials -->
                    <ColumnDefinition Width="*"/>
                    <!-- Vendor Core Details -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Rating & Actions -->
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0" Command="{Binding NavigateBackCommand}" Style="{StaticResource MaterialDesignIconButton}" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="22" Height="22" Foreground="#475569"/>
                </Button>

                <!-- Avatar Circle -->
                <Border Grid.Column="1" Width="52" Height="52" CornerRadius="26" Background="#E0F2FE" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Vendor.CompanyName[0]}" FontSize="22" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Name & Contact Badges -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Vendor.CompanyName}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,12,0"/>
                        <Border Background="#F1F5F9" CornerRadius="12" Padding="10,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Vendor.Status}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Vendor.ContactPerson, StringFormat='Contact: {0}'}" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Rating Badge & Quick Contact Icons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Dynamic Delay Rating Box -->
                    <Border Background="#FEF3C7" CornerRadius="8" Padding="12,6" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Star" Foreground="#D97706" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding DelayRating, StringFormat='{}{0:F1} / 5.0'}" FontWeight="Bold" FontSize="14" Foreground="#92400E" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Direct Action Quick Icons -->
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="36" Height="36" Margin="0,0,4,0" ToolTip="Send WhatsApp">
                        <materialDesign:PackIcon Kind="Whatsapp" Foreground="#16A34A" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="36" Height="36" ToolTip="Send Email">
                        <materialDesign:PackIcon Kind="EmailOutline" Foreground="#0284C7" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 2. TAB CONTROL WORKSPACE                                          -->
        <!-- ================================================================= -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">

            <!-- TAB 1: INFO / PROFILE -->
            <TabItem Header="Info / Profile" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                    <StackPanel>
                        <!-- Top Summary Cards -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Contact Details -->
                            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Primary Contact Details" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding Vendor.CompanyName, StringFormat='Firm: {0}'}" FontSize="13" Margin="0,0,0,6" Foreground="#475569"/>
                                    <TextBlock Text="{Binding Vendor.Phone, StringFormat='Phone: {0}'}" FontSize="13" Margin="0,0,0,6" Foreground="#475569"/>
                                    <TextBlock Text="{Binding Vendor.Email, StringFormat='Email: {0}'}" FontSize="13" Margin="0,0,0,6" Foreground="#475569"/>
                                    <TextBlock Text="{Binding Vendor.GstNumber, StringFormat='GSTIN: {0}'}" FontSize="13" Margin="0,0,0,6" Foreground="#475569"/>
                                    <TextBlock Text="{Binding Vendor.Address, StringFormat='Address: {0}'}" FontSize="13" Foreground="#475569" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Account & Financial History -->
                            <Border Grid.Column="1" Background="#F0FDF4" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Account History &amp; Balances" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Total Orders:" Foreground="#15803D"/>
                                        <TextBlock Text="{Binding TotalOrdersProcessed}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#15803D"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Total Purchases (YTD):" Foreground="#15803D"/>
                                        <TextBlock Text="{Binding TotalPurchasesYtd, StringFormat='₹{0:N2}'}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#15803D"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Last Purchase Date:" Foreground="#15803D"/>
                                        <TextBlock Text="{Binding LastPurchaseDate, StringFormat='{}{0:dd-MMM-yyyy}'}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#15803D"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Outstanding Balance:" Foreground="#B91C1C"/>
                                        <TextBlock Text="{Binding OutstandingPayable, StringFormat='₹{0:N2}'}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#B91C1C"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Delay Rating & Performance -->
                            <Border Grid.Column="2" Background="#FFFBEB" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Delivery Performance Metrics" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="On-Time Fulfillment Rate:" Foreground="#B45309"/>
                                        <TextBlock Text="{Binding OnTimeDeliveryRate, StringFormat='{}{0}%'}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#B45309"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Average Turnaround Delay:" Foreground="#B45309"/>
                                        <TextBlock Text="{Binding AvgDelayDays, StringFormat='{}{0} Days'}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#B45309"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Delayed POs Count:" Foreground="#B45309"/>
                                        <TextBlock Text="{Binding DelayedOrdersCount}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#B45309"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Bottom Activity Bar -->
                        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                            <StackPanel>
                                <!-- Header -->
                                <TextBlock Text="Latest System Activity" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <!-- Fallback Message (Shown when collection is empty) -->
                                <TextBlock Text="No recent activity logged for this vendor." 
                   Foreground="#94A3B8" 
                   FontSize="12"
                   Visibility="{Binding HasActivities, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                <!-- Dynamic Activity List -->
                                <ItemsControl ItemsSource="{Binding VendorActivities}" 
                      Visibility="{Binding HasActivities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!-- Icon -->
                                                        <ColumnDefinition Width="*"/>
                                                        <!-- Activity Description -->
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!-- Timestamp & User -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Activity Type Icon -->
                                                    <materialDesign:PackIcon Kind="{Binding IconKind}" 
                                                     Foreground="{Binding IconColor}" 
                                                     Width="20" Height="20" 
                                                     VerticalAlignment="Center" 
                                                     Margin="0,0,12,0"/>

                                                    <!-- Activity Text -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#334155" FontSize="13"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="#64748B" FontSize="12"/>
                                                    </StackPanel>

                                                    <!-- Metadata Badges (Timestamp & CreatedBy) -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="CalendarClock" Width="14" Height="14" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd-MMM-yyyy hh:mm tt}'}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Background="#EFF6FF" CornerRadius="6" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Account" Width="14" Height="14" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding CreatedBy, StringFormat='By: {0}'}" FontSize="11" Foreground="#2563EB" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: DOCUMENTS -->
            <TabItem Header="Documents" FontSize="14" FontWeight="SemiBold">
                <materialDesign:DialogHost Identifier="DocumentTabDialogHost" DialogTheme="Inherit">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Top Inline Mini-Upload Dialog Block -->
                            <RowDefinition Height="*"/>
                            <!-- Single Central DataGrid Workspace -->
                        </Grid.RowDefinitions>

                        <!-- TOP BAR: STREAMLINED MINI-UPLOAD BAR PANEL -->
                        <materialDesign:Card Grid.Row="0" UniformCornerRadius="6" Padding="14,10" Margin="0,0,0,15" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <DockPanel LastChildFill="True">

                                <!-- RIGHT ACTION BUTTONS: Filter, Import, Export -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">

                                    <Button Command="{Binding ClearFiltersCommand}"
                         Visibility="{Binding IsFilterActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Style="{StaticResource MaterialDesignFlatButton}" 
                         Foreground="#DC2626"
                         Height="36" Padding="10,0" Margin="0,0,8,0"
                         ToolTip="Reset all active filters">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilterOff" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Clear Filter" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 1. FILTER BUTTON -->
                                    <Button Command="{Binding OpenFilterDialogCommand}"
         Style="{StaticResource MaterialDesignOutlinedButton}" 
         BorderBrush="#64748B" Foreground="#334155"
         Height="36" Padding="12,0" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilterVariant" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Filter" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. IMPORT BUTTON -->
                                    <Button Command="{Binding OpenImportDialogCommand}"
         Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#059669" BorderBrush="Transparent"
         Height="36" Padding="12,0" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Upload" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Import" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 3. EXPORT BUTTON WITH DROPDOWN MENU -->
                                    <!-- EXPORT BUTTON WITH DROPDOWN MENU -->
                                    <materialDesign:PopupBox
          PlacementMode="BottomAndAlignRightEdges"
          ToolTip="Export Documents"
          Height="36" Padding="0">
                                        <materialDesign:PopupBox.ToggleContent>
                                            <Border Background="#2563EB" CornerRadius="4" Padding="12,0" Height="36">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Download" Foreground="White" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Export" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    <materialDesign:PackIcon Kind="ChevronDown" Foreground="White" Width="16" Height="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </materialDesign:PopupBox.ToggleContent>

                                        <!-- FIXED WIDER CONTAINER (Width="190") TO PREVENT TEXT TRUNCATION -->
                                        <StackPanel Background="White" Margin="4">

                                            <!-- 1. ALL -->
                                            <MenuItem Command="{Binding ExportZipCommand}" 
   CommandParameter="All"
   Padding="8,6" Margin="0">
                                                <MenuItem.Header>
                                                    <TextBlock Text="ALL" FontWeight="SemiBold" Foreground="#1E293B" Margin="-10,0,0,0"/>
                                                </MenuItem.Header>
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FolderZip" Foreground="#2563EB" Width="18" Height="18"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <!-- 2. FILTERED -->
                                            <MenuItem Command="{Binding ExportZipCommand}" 
   CommandParameter="Filtered"
   IsEnabled="{Binding IsFilteredEnabled}"
   Padding="8,6" Margin="0">
                                                <MenuItem.Header>
                                                    <TextBlock Text="Filtered" FontWeight="SemiBold" Margin="-10,0,0,0"/>
                                                </MenuItem.Header>
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Filter" Foreground="#D97706" Width="18" Height="18"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <!-- 3. SELECTED -->
                                            <MenuItem Command="{Binding ExportZipCommand}" 
   CommandParameter="Selected"
   IsEnabled="{Binding IsSelectedEnabled}"
   Padding="8,6" Margin="0">
                                                <MenuItem.Header>
                                                    <TextBlock Text="Selected" FontWeight="SemiBold" Margin="-10,0,0,0"/>
                                                </MenuItem.Header>
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="CheckboxMarked" Foreground="#059669" Width="18" Height="18"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                        </StackPanel>
                                    </materialDesign:PopupBox>
                                </StackPanel>

                                <!-- LEFT SUMMARY TEXT -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FolderFile" Foreground="#2563EB" Width="22" Height="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DocumentCountSummaryText}" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </materialDesign:Card>

                        <!-- BOTTOM PORTION: CENTRAL COMPLIANCE DATA TABLE GRID -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DisplayedDocuments, IsAsync=True}" AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox Command="{Binding Data.ToggleSelectAllCommand, Source={StaticResource DataContextProxy}}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Color-Coded Category Label Column -->
                                <DataGridTemplateColumn Header="Category Classification" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" Foreground="#334155"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Dynamic filename metadata column rows values mapping -->
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="3.5*" IsReadOnly="True" FontWeight="Medium"/>
                                <DataGridTextColumn Header="Uploaded By User" Binding="{Binding UploadedBy}" Width="1.5*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Date Logged" Binding="{Binding UploadedAt, StringFormat={}{0:dd-MM-yyyy hh:mm tt}}" Width="2*" IsReadOnly="True"/>

                                <!-- CONTEXT COMPONENT ACTIONS PANEL ROUTE -->
                                <DataGridTemplateColumn Header="Actions" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                                                <Button Command="{Binding DataContext.ReplaceDocumentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                 CommandParameter="{Binding}"
                                 Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#F59E0B" BorderBrush="Transparent" 
                                 Padding="0" Width="28" Height="28" Margin="0,0,6,0" ToolTip="Replace / Overwrite File">
                                                    <materialDesign:PackIcon Kind="FileReplace" Foreground="White" Width="14" Height="14"/>
                                                </Button>

                                                <Button Command="{Binding DataContext.DownloadDocumentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                 CommandParameter="{Binding}"
                                 Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#0284C7" BorderBrush="Transparent" 
                                 Padding="0" Width="28" Height="28" Margin="0,0,6,0" ToolTip="Download File to System">
                                                    <materialDesign:PackIcon Kind="Download" Foreground="White" Width="14" Height="14"/>
                                                </Button>

                                                <Button Command="{Binding DataContext.DeleteDocumentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                 CommandParameter="{Binding}"
                                 Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#DC2626" BorderBrush="Transparent" 
                                 Padding="0" Width="28" Height="28" ToolTip="Delete Document Permanently">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="White" Width="14" Height="14"/>
                                                </Button>

                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:DialogHost>
            </TabItem>

            <!-- TAB 3: PRODUCTS -->
            <TabItem Header="Products" FontSize="14" FontWeight="SemiBold">
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search & Actions Bar -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Catalog Items Supplied by Vendor" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>

                            <Button Command="{Binding LinkNewProductCommand}" HorizontalAlignment="Right" Background="#0284C7" Foreground="White" BorderThickness="0" Height="36" Padding="12,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Link Product" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Product DataGrid -->
                        <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding VendorProducts}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True" 
                      GridLinesVisibility="Horizontal" 
                      HeadersVisibility="Column" 
                      Background="White" 
                      RowHeight="48">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2.5*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="1.5*"/>
                                <DataGridTextColumn Header="Supplier SKU" Binding="{Binding SupplierSku}" Width="1.5*"/>
                                <DataGridTextColumn Header="Agreed Cost Price" Binding="{Binding PurchasePrice, StringFormat='₹{0:N2}'}" Width="1.5*"/>
                                <DataGridTextColumn Header="Stock In-Hand" Binding="{Binding CurrentStock}" Width="1.2*"/>

                                <!-- Actions Column -->
                                <DataGridTemplateColumn Header="Actions" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" 
                                        Command="{Binding DataContext.EditProductLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="30" Height="30" ToolTip="Edit Pricing / SKU">
                                                <materialDesign:PackIcon Kind="PencilOutline" Foreground="#0284C7" Width="18" Height="18"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 4: PURCHASE ORDERS -->
            <TabItem Header="P.O. (Purchase Orders)" FontSize="14" FontWeight="SemiBold">
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                    <DataGrid ItemsSource="{Binding VendorOrders}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="48">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PO Number" Binding="{Binding PoNumber}" Width="1.5*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="1.2*"/>
                            <DataGridTextColumn Header="Expected Date" Binding="{Binding ExpectedDeliveryDate, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="1.2*"/>
                            <DataGridTextColumn Header="Actual Date" Binding="{Binding ActualDeliveryDate, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="1.2*"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat='₹{0:N2}'}" Width="1.2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding OrderStatus}" Width="*"/>

                            <!-- Delay Indicator Badge -->
                            <DataGridTemplateColumn Header="Fulfillment Delay" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDelayed}" Value="True">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="On Time"/>
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDelayed}" Value="True">
                                                                <Setter Property="Text" Value="{Binding DelayInDays, StringFormat='{}{0} Days Late'}"/>
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
