<Window x:Class="CallMan.Dialogs.LeadTimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        mc:Ignorable="d"
        Title="Lead Timeline &amp; Audits" 
        Height="500" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Complete Audit Trail" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding HistoryItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Rectangle Grid.Column="0" Fill="#D0D0D0" Width="2" HorizontalAlignment="Center" Margin="5,15,5,-10"/>
                            <Ellipse Grid.Column="0" Fill="#1794A1" Width="10" Height="10" VerticalAlignment="Top" Margin="1,5,1,0"/>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding UpdatedBy}" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                <TextBlock Text="{Binding LogDate, StringFormat='\{0:dd MMM yyyy, h:mm tt\}'}" FontSize="11" Foreground="Gray"/>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,5"/>
                                <Separator Background="#EEE"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
