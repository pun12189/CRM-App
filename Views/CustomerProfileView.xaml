<UserControl x:Class="Tijori.Views.CustomerProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:conv="clr-namespace:Tijori.Converters"
             xmlns:model="clr-namespace:Tijori.Models"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <materialDesign:BooleanToVisibilityConverter x:Key="InvertedVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <conv:StringContainsConverter x:Key="StringContainsConverter"/>
        <materialDesign:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter"/>
        <materialDesign:NullableToVisibilityConverter x:Key="InverseNullToVisibilityConverter" NullValue="Visible" NotNullValue="Collapsed"/>
        <model:BindingProxy x:Key="DataContextProxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Details Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Tabs & Data -->
        <materialDesign:Card Grid.Row="0" Padding="20" Background="#F5F5F5" Visibility="{Binding IsInfoTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Contact -->
                <StackPanel Grid.Column="0">
                    <TextBlock><Run Text="Firm name: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.CompanyName}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Email: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.Email}" Foreground="#2196F3"/></TextBlock>
                    <TextBlock><Run Text="Phone: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.Phone}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Location: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.State}"/></TextBlock>
                </StackPanel>

                <!-- Column 2: Status -->
                <StackPanel Grid.Column="1">
                    <TextBlock><Run Text="Customer Since: " FontWeight="Bold"/><Run Text="{Binding Metrics.CustomerSince}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Last 3 months billing: " FontWeight="Bold"/><Run Text="{Binding Metrics.Last3MonthsBilling}"/></TextBlock>
                    <TextBlock><Run Text="Last order date: " FontWeight="Bold"/><Run Text="{Binding Metrics.LastOrderDate}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Outstanding: " FontWeight="Bold"/><Run Text="{Binding Metrics.OutstandingAmount}" Foreground="Red"/></TextBlock>
                </StackPanel>

                <!-- Column 3: Business/Target -->
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Business Done/Target" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock><Run Text="Monthly: " Foreground="Red"/><Run Text="{Binding Metrics.MonthlyBusiness}"/></TextBlock>
                        <TextBlock><Run Text="Last 3 Months: " Foreground="Red"/><Run Text="{Binding Metrics.Last3MonthsBusiness}"/></TextBlock>
                        <TextBlock><Run Text="Overall: " Foreground="#2196F3"/><Run Text="{Binding Metrics.OverallBusiness}"/></TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </materialDesign:Card>

        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}" Margin="10" SelectedIndex="{Binding SelectedTabWorkspaceIndex, UpdateSourceTrigger=PropertyChanged}">
            <TabItem Visibility="{Binding IsInEditMode, Converter={StaticResource InvertedVisibilityConverter}}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Margin="0,0,4,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="ArrowDown" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsInfoTabSelected, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="True">
                                            <Setter Property="Kind" Value="ArrowUp"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Text="Info"/>
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem x:Name="InfoTab" Header="Info" FontSize="13" FontWeight="SemiBold" Visibility="{Binding IsInEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                    <StackPanel Margin="20">

                        <UniformGrid Rows="1">
                            <UniformGrid.Style>
                                <Style TargetType="UniformGrid">
                                    <Setter Property="Columns" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLead.Status}" Value="Matured">
                                            <Setter Property="Columns" Value="3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </UniformGrid.Style>

                            <materialDesign:Card Background="#F8FAFC" UniformCornerRadius="6" Padding="16" Margin="0,0,10,0">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Primary Contact Details" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <Separator Background="#DCFCE7" Margin="0,0,0,4"/>
                                    <DockPanel>
                                        <materialDesign:PackIcon Kind="Domain" Foreground="#94A3B8" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedLead.CompanyName, StringFormat='Firm: {0}', TargetNullValue='Firm: --'}" FontSize="13" Foreground="#1E293B" Margin="10,0,0,0" FontWeight="Medium"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <materialDesign:PackIcon Kind="EmailOutline" Foreground="#94A3B8" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedLead.Email}" FontSize="13" Foreground="#2563EB" Margin="10,0,0,0"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <materialDesign:PackIcon Kind="PhoneOutline" Foreground="#94A3B8" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedLead.Phone, TargetNullValue='--'}" FontSize="13" Foreground="#1E293B" Margin="10,0,0,0"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <materialDesign:PackIcon Kind="PhoneInTalkOutline" Foreground="#94A3B8" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedLead.AltPhone, StringFormat='Alt Phone: {0}', TargetNullValue='Alt Phone: --'}" FontSize="13" Foreground="#1E293B" Margin="10,0,0,0"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <materialDesign:PackIcon Kind="MapMarkerOutline" Foreground="#94A3B8" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedLead.State, StringFormat='Location: {0}', TargetNullValue='Location: --'}" FontSize="13" Foreground="#1E293B" Margin="10,0,0,0"/>
                                    </DockPanel>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Background="#F0FDF4" BorderBrush="#DCFCE7" UniformCornerRadius="6" Padding="16" Margin="10,0,10,0">
                                <materialDesign:Card.Style>
                                    <Style TargetType="materialDesign:Card">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLead.Status}" Value="Matured">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:Card.Style>
                                <StackPanel Margin="10">
                                    <TextBlock Text="Account History &amp; Status" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <Separator Background="#DCFCE7" Margin="0,0,0,4"/>
                                    <DockPanel>
                                        <TextBlock Text="Customer Since:" FontSize="13" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Metrics.CustomerSince, TargetNullValue='No Orders Yet'}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Last 3 Months Billing:" FontSize="13" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Metrics.Last3MonthsBilling, StringFormat='₹ {0:N2}', TargetNullValue='0.00'}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Last Order Date:" FontSize="13" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Metrics.LastOrderDate, TargetNullValue='--'}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Outstanding Balance:" FontSize="13" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Metrics.OutstandingAmount, StringFormat='₹ {0:N2}', TargetNullValue='0.00'}" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
                                    </DockPanel>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" UniformCornerRadius="6" Padding="16" Margin="10,0,0,0">
                                <materialDesign:Card.Style>
                                    <Style TargetType="materialDesign:Card">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLead.Status}" Value="Matured">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:Card.Style>
                                <StackPanel Margin="10">
                                    <TextBlock Text="Business Realization Performance" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <Separator Background="#DCFCE7" Margin="0,0,0,4"/>
                                    <DockPanel>
                                        <TextBlock Text="This Month:" FontSize="13" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Metrics.MonthlyBusiness, StringFormat='₹ {0:N2}', TargetNullValue='0.00'}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Avg Monthly Billing:" FontSize="13" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Metrics.MonthlyBusiness, StringFormat='₹ {0:N2}', TargetNullValue='0.00'}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Last Quarter Billing:" FontSize="13" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Metrics.Last3MonthsBusiness, StringFormat='₹ {0:N2}', TargetNullValue='0.00'}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Overall Business:" FontSize="13" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Metrics.OverallBusiness, StringFormat='₹ {0:N2}', TargetNullValue='0.00'}" HorizontalAlignment="Right" FontSize="14" FontWeight="Black" Foreground="#2563EB"/>
                                    </DockPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </UniformGrid>

                        <!-- ROW B: CLASSIFICATIONS TAGS & SEGMENT LABELS WITH DISTINCT HEADINGS (UPDATED) -->
                        <materialDesign:Card UniformCornerRadius="6" Padding="16" Background="#FAFBFB" Margin="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- SECTION 1: LABELS (Soft Teal / Mint Accent) -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Labels" FontSize="11" FontWeight="Bold" Foreground="#0F766E"/>
                                    <ItemsControl ItemsSource="{Binding SelectedLead.LeadLabels}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <materialDesign:Chip Content="{Binding}" Margin="0,2,4,2" Height="24" Background="#CCFBF1" Foreground="#115E59" FontWeight="Medium" IsDeletable="False"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- SECTION 2: TAGS (Soft Green Accent) -->
                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                    <TextBlock Text="Category Tags" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Visibility="{Binding SelectedLead.LeadTag, Converter={StaticResource NullableToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SelectedLead.LeadTag}" FontSize="12" Foreground="#15803D" FontWeight="SemiBold"/>
                                    </Border>
                                    <!-- Fallback if tag is null -->
                                    <TextBlock Text="--" FontSize="12" Foreground="#94A3B8" Visibility="{Binding SelectedLead.LeadTag, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- SECTION 3: LEAD SOURCE (Soft Indigo / Purple Accent) -->
                                <StackPanel Grid.Column="2" Margin="10,0,10,0">
                                    <TextBlock Text="Lead Source" FontSize="11" FontWeight="Bold" Foreground="#4338CA"/>
                                    <Border Background="#E0E7FF" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Visibility="{Binding SelectedLead.LeadSource, Converter={StaticResource NullableToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SelectedLead.LeadSource}" FontSize="12" Foreground="#4F46E5" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="--" FontSize="12" Foreground="#94A3B8" Visibility="{Binding SelectedLead.LeadSource, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- SECTION 4: DIVISIONS (Soft Amber / Blue Accent) -->
                                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                    <TextBlock Text="Assigned Divisions" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                    <ItemsControl ItemsSource="{Binding SelectedLead.AssignedDivisions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#DBEAFE" CornerRadius="4" Padding="8,4" Margin="0,2,4,2">
                                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#1E40AF" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card UniformCornerRadius="6" Padding="16" Background="#FAFBFB">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <!-- Left: Message narrative body text -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Right: Activity Metadata Info Badges -->
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="6" VerticalAlignment="Center">
                                    <TextBlock Text="Latest Activity" FontSize="11" FontWeight="Bold" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedLead.LatestUpdate.Message, TargetNullValue='No transaction comments or historical account descriptions are currently appended to this profile log.'}" 
                           TextWrapping="Wrap" FontSize="13" Foreground="#334155" LineHeight="20" Margin="2,0,15,0"/>
                                </StackPanel>

                                <!-- Dynamic Activity Metadata Tracking Side Block -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <!-- Automatically hides the tracking badges if no activity logs exist yet -->
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLead.LatestUpdate}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Activity Logging Timestamp Stamp -->
                                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CalendarClock" Foreground="#64748B" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding SelectedLead.LatestUpdate.LogDate, StringFormat={}{0:dd-MM-yyyy hh:mm tt}}" FontSize="11" Foreground="#475569" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Operator Identity Tracking Stamp -->
                                    <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountEditOutline" Foreground="#2563EB" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding SelectedLead.LatestUpdate.UpdatedBy, StringFormat='By: {0}'}" FontSize="11" Foreground="#1E40AF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Profile"/>
            <TabItem Header="Update Here" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- 1. ACTION SELECTION (image_0d55ea.png radio buttons) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <RadioButton Content="Matured Followup" IsChecked="{Binding IsMaturedFollowup}" Margin="0,0,15,0"/>
                            <RadioButton Content="Matured Dead" IsChecked="{Binding IsMaturedDead}" Margin="0,0,15,0"/>
                            <RadioButton Content="Create Proforma" IsChecked="{Binding IsCreatingProforma}" Margin="0,0,15,0" Visibility="Visible"/>
                            <RadioButton Content="Create Order" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- 2. ORDER AMOUNTS (Specialized analytics) -->
                        <Grid Grid.Row="1"  Margin="0,0,0,15" Visibility="{Binding IsMaturedFollowup, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding Data.FirstOrderAmount, StringFormat={}{0:C2}, ConverterCulture=en-IN, Mode=OneWay}"
                             materialDesign:HintAssist.Hint="First Order Amount" IsReadOnly="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <TextBox Grid.Column="2" Text="{Binding Data.LastOrderAmount, StringFormat={}{0:C2}, ConverterCulture=en-IN, Mode=OneWay}"
                             materialDesign:HintAssist.Hint="Last Order Amount" IsReadOnly="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            <!-- Subtext for last order date/time would go here -->
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,0,0,15" Visibility="{Binding IsMaturedDead, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Dead Reason *" Foreground="#555"/>
                            <ComboBox ItemsSource="{Binding DeadStages}" Margin="0,5,0,0" SelectedItem="{Binding SelectedDeadStage}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Dead Reasons *" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,0,0,15" Visibility="{Binding IsMaturedFollowup, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Visibility="{Binding IsOrderReceived, Converter={StaticResource InvertedVisibilityConverter}}">
                                <TextBlock Text="Mature Stages *" Foreground="#555"/>
                                <ComboBox ItemsSource="{Binding MatureStages}" SelectedItem="{Binding SelectedMatureStage}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Mature Stages *" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,5,0,15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <CheckBox Content="I have received an order" IsChecked="{Binding IsOrderReceived}" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsOrderReceived, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!-- Order Amount (Only show if checked) -->
                                    <TextBox Text="{Binding OrderValue}" materialDesign:HintAssist.Hint="Order Amount" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="10,0,0,10"/>

                                    <TextBox Text="{Binding PaymentReceived}" materialDesign:HintAssist.Hint="Payment Received" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="10,0,0,10"/>
                                </StackPanel>
                                <Border Background="#FFF4F4" Padding="10" CornerRadius="4" Visibility="{Binding IsOrderReceived, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Balance Due: " VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding BalancePayment, StringFormat='₹ {0:N2}'}" FontWeight="Bold" Foreground="Red" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding FollowupDateLabel}"/>
                                    <DatePicker SelectedDate="{Binding NextFollowupDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayDateStart="{Binding MinDate}" Margin="0,5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

                                    <TextBlock Text="{Binding FollowupTimeLabel}" Foreground="#555" Margin="0,0,0,5"/>

                                    <materialDesign:TimePicker SelectedTime="{Binding SelectedTime}" Is24Hours="False" materialDesign:HintAssist.Hint="Pick Time" materialDesign:TextFieldAssist.HasClearButton="True" VerticalAlignment="Center" xml:lang="en-IN" />

                                    <TextBlock Text="Clock icon appears on hover/focus" FontSize="10" FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- 6. MESSAGE/HISTORY -->
                        <TextBox Grid.Row="4" Text="{Binding Message}" Visibility="{Binding IsCreatingProforma, Converter={StaticResource InvertedVisibilityConverter}}" materialDesign:HintAssist.Hint="Message *"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="100" TextWrapping="Wrap"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                        <!-- 7. SAVE BUTTON -->
                        <Button Grid.Row="5" Command="{Binding UpdateCustomerCommand}" Visibility="{Binding IsCreatingProforma, Converter={StaticResource InvertedVisibilityConverter}}" Content="Update" HorizontalAlignment="Right" 
                        Background="#FF8A3D" BorderBrush="#FF8A3D" Width="120" Height="40"/>

                        <StackPanel Grid.Row="6" Visibility="{Binding IsCreatingProforma, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <materialDesign:Card Padding="14" Margin="0,0,0,12" Background="#FAFAFA" UniformCornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="CartArrowDown" Foreground="#1794A1" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Step 1: Items &amp; Inventory" FontWeight="Bold" FontSize="14" Foreground="#374151" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.5*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.6*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableProducts, IsAsync=True}" SelectedItem="{Binding SelectedProduct}" Text="{Binding CustomProductNameText, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Search Catalog or Type Custom Item..." IsEditable="True" Margin="4" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                        <TextBox Grid.Column="1" Text="{Binding InputBatchNo, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Batch No" Margin="4" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        <TextBox Grid.Column="2" Text="{Binding InputQuantity, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Qty" Margin="4" HorizontalContentAlignment="Center" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        <TextBox Grid.Column="3" Text="{Binding InputRate, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Rate (₹)" Margin="4" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        <TextBox Grid.Column="4" Text="{Binding InputGstPercent, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="GST %" Margin="4" HorizontalContentAlignment="Center" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                        <Button Grid.Column="5" Command="{Binding UploadItemImageCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Width="40" Height="40" Margin="4,0" ToolTip="Attach Image Specification">
                                            <Grid>
                                                <materialDesign:PackIcon Kind="CameraPlus" Width="22" Height="22" Foreground="#7F8C8D" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedImagePreview, Converter={StaticResource InvertedVisibilityConverter}}"/>
                                                <Image Source="{Binding SelectedImagePreview}" Width="38" Height="38" Stretch="UniformToFill" Margin="1" Visibility="{Binding SelectedImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Button>

                                        <Button Grid.Column="6" Command="{Binding AddLineItemCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Width="36" Height="36" Background="#1794A1" BorderBrush="#1794A1">
                                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <DataGrid MinHeight="140" MaxHeight="240" GridLinesVisibility="All" ItemsSource="{Binding ActiveProforma.Items}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowBackground="White" HorizontalContentAlignment="Stretch" Margin="0,0,0,16">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Preview" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" BorderThickness="1" BorderBrush="#E5E7EB" Width="38" Height="38" Margin="2" Background="#F9FAFB" ClipToBounds="True">
                                                    <Grid>
                                                        <materialDesign:PackIcon Kind="ImageOff" Foreground="#BDC3C7" HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" Visibility="{Binding LineItemImageSource, Converter={StaticResource InvertedVisibilityConverter}}"/>
                                                        <Image Source="{Binding LineItemImageSource}" Stretch="UniformToFill"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="1*"/>
                                    <DataGridTextColumn Header="Batch / Lot No" Binding="{Binding BatchNo}" Width="Auto"/>
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                                    <DataGridTextColumn Header="Rate" Binding="{Binding UnitPrice, StringFormat='₹{0:N2}'}" Width="100"/>
                                    <DataGridTextColumn Header="GST %" Binding="{Binding GstPercent}" Width="75"/>
                                    <DataGridTextColumn Header="Subtotal" Binding="{Binding SubTotal, StringFormat='₹{0:N2}'}" Width="120"/>
                                    <DataGridTemplateColumn Header="Action" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.RemoveCartRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="Red" Width="18" Height="18"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width=".6*"/>
                                    <ColumnDefinition Width=".4*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:Card Padding="14" Margin="0,0,0,16" Background="#FAFAFA" UniformCornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Other Charges / Discounts" FontWeight="Bold" FontSize="13" Margin="2,0,0,10" Foreground="#475569"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <!-- Name Input -->
                                                <ColumnDefinition Width="1.2*"/>
                                                <!-- Action Dropdown Selector -->
                                                <ColumnDefinition Width="1.2*"/>
                                                <!-- Base Value Input -->
                                                <ColumnDefinition Width="1*"/>
                                                <!-- GST % Dropdown Selector -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Action Trigger Add Button -->
                                            </Grid.ColumnDefinitions>

                                            <!-- 1. Charge Name Input Field -->
                                            <TextBox Grid.Column="0" Text="{Binding InputChargeDescription, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Enter name" Margin="4" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                            <!-- 2. Action Dropdown Selector -->
                                            <ComboBox Grid.Column="1" SelectedValue="{Binding InputChargeAction}" SelectedValuePath="Content" materialDesign:HintAssist.Hint="Action" Margin="4" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                <ComboBoxItem Content="Add (+)"/>
                                                <ComboBoxItem Content="Subtract (-)"/>
                                                <ComboBoxItem Content="Percentage (+)"/>
                                                <ComboBoxItem Content="Percentage (-)"/>
                                            </ComboBox>

                                            <!-- 3. Base Amount/Percentage Value Input Field -->
                                            <TextBox Grid.Column="2" Text="{Binding InputChargeAmount, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Enter value" Margin="4" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                            <!-- 4. GST Percentage Dropdown Menu Selector -->
                                            <ComboBox Grid.Column="3" SelectedValue="{Binding InputChargeGst}" SelectedValuePath="Content" materialDesign:HintAssist.Hint="GST" Margin="4" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                <ComboBoxItem Content="0%"/>
                                                <ComboBoxItem Content="5%"/>
                                                <ComboBoxItem Content="12%"/>
                                                <ComboBoxItem Content="18%"/>
                                                <ComboBoxItem Content="28%"/>
                                            </ComboBox>

                                            <!-- 5. Add Button -->
                                            <Button Grid.Column="4" Command="{Binding AddExtraChargeCommand}" Content="ADD" Height="40" Background="#7F8C8D" BorderBrush="#7F8C8D" Width="75" Margin="4,0,2,0"/>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Grid.Column="1" Padding="12" Margin="8,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" UniformCornerRadius="6">
                                    <ListBox ItemsSource="{Binding ActiveProforma.ExtraCharges, IsAsync=True}" 
                                     MaxHeight="95" 
                                     ScrollViewer.CanContentScroll="True"
                                     HorizontalContentAlignment="Stretch"
                                     Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="340" Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width=".5*"/>
                                                        <ColumnDefinition Width=".3*"/>
                                                        <ColumnDefinition Width=".2*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ChargeDescription}" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Opacity="0.7">
                                                            <TextBlock Text="{Binding ChargeAction}" FontSize="10" Foreground="#64748B"/>
                                                            <TextBlock Text=" | Base: " FontSize="10" Foreground="#64748B" Margin="4,0,0,0"/>
                                                            <TextBlock Text="{Binding BaseValue}" FontSize="10" Foreground="#64748B"/>
                                                            <TextBlock Text=" (GST " FontSize="10" Foreground="#64748B" Margin="4,0,0,0"/>
                                                            <TextBlock Text="{Binding GstPercent, StringFormat='{}{0:N0}%'}" FontSize="10" Foreground="#64748B"/>
                                                            <TextBlock Text=")" FontSize="10" Foreground="#64748B"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" 
                                                       Text="{Binding ChargeAmount, StringFormat='₹{0:N2}'}" 
                                                       FontWeight="Bold" 
                                                       FontSize="12" 
                                                       Margin="8,0" 
                                                           HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ChargeAction, Converter={StaticResource StringContainsConverter}, ConverterParameter='Subtract'}" Value="True">
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ChargeAction, Converter={StaticResource StringContainsConverter}, ConverterParameter='Minus'}" Value="True">
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ChargeAction, Converter={StaticResource StringContainsConverter}, ConverterParameter='(-)'}" Value="True">
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Button Grid.Column="2" 
                                                    Style="{StaticResource MaterialDesignIconButton}" 
                                                    Width="24" 
                                                    Height="24" 
                                                    Padding="0" 
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveExtraChargeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                    CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="CloseCircle" Foreground="#EF4444" Width="16" Height="16"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </materialDesign:Card>
                            </Grid>

                            <materialDesign:Card Padding="16" Margin="0,0,0,16" Background="White" UniformCornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Step 2: Shipping, Invoicing, Terms &amp; Conditions" FontWeight="Bold" FontSize="14" Foreground="#374151" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ActiveProforma.BillTo, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Bill To" AcceptsReturn="True" Height="55" TextWrapping="Wrap" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        <TextBox Grid.Column="2" Text="{Binding ActiveProforma.DeliverTo, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Deliver To" AcceptsReturn="True" Height="55" TextWrapping="Wrap" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ActiveProforma.TermsAndConditions, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Terms &amp; Conditions" AcceptsReturn="True" Height="55" TextWrapping="Wrap" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        <TextBox Grid.Column="2" Text="{Binding ActiveProforma.PreferedTransport, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Preferred Transport (e.g., Porter, VRL)" Height="55" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ActiveProforma.InternalRemarks, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Internal Remarks (Office Notes...)" Style="{StaticResource MaterialDesignOutlinedTextBox}" VerticalContentAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                            <TextBlock Text="Next Followup DateTime *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="2,0,0,6"/>

                                            <!-- Splits Date and Time picking across a clean layout row grid -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <!-- Date Picker Card Box -->
                                                    <ColumnDefinition Width="1*"/>
                                                    <!-- Time Picker Card Box -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Date Component Input -->
                                                <DatePicker Grid.Column="0" SelectedDate="{Binding NextFollowupDate, Mode=TwoWay}" DisplayDateStart="{Binding MinDate}" Margin="0,0,6,0"/>

                                                <!-- Time Component Input -->
                                                <materialDesign:TimePicker Grid.Column="1" SelectedTime="{Binding SelectedTime, Mode=TwoWay}" Is24Hours="False" materialDesign:HintAssist.Hint="Pick Time" materialDesign:TextFieldAssist.HasClearButton="True" xml:lang="en-IN"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Padding="16" Background="#F8FAFC" UniformCornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width=".3*"/>
                                        <ColumnDefinition Width=".3*"/>
                                        <ColumnDefinition Width=".4*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Right Numeric Totals Summary Block Container -->

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                                        <TextBlock Text="Item SubTotal" Opacity="0.6" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding ActiveProforma.ItemSubTotal, StringFormat='₹{0:N2}'}" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#334155"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,24,0">
                                        <TextBlock Text="Extra Surcharges" Opacity="0.6" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding ActiveProforma.ExtraChargesTotal, StringFormat='+ ₹{0:N2}'}" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#B45309"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,28,0">
                                        <TextBlock Text="Grand Value Total" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignBody2TextBlock}" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding ActiveProforma.GrandTotal, StringFormat='₹{0:N2}'}" FontSize="24" FontWeight="Black" Foreground="#1794A1"/>
                                    </StackPanel>

                                    <Button Grid.Column="3" Content="SAVE &amp; GENERATE PROFORMA" Command="{Binding SaveProformaCommand}" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignRaisedButton}" Background="#673AB7" BorderBrush="#673AB7" Height="40" Width="220" FontSize="12" FontWeight="Bold" materialDesign:ButtonAssist.CornerRadius="4"/>

                                </Grid>
                            </materialDesign:Card>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Lead History">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Lead History" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl ItemsSource="{Binding HistoryItems, IsAsync=True}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Rectangle Grid.Column="0" 
           Fill="#D1D5DB" 
           Width="2" 
           HorizontalAlignment="Center" 
           Margin="0,20,0,-20"/>

                                        <Border Grid.Column="0" 
        Background="#A12E2E" 
        Width="24" Height="24" 
        CornerRadius="12" 
        HorizontalAlignment="Center" 
        VerticalAlignment="Top" 
        Margin="0,14,0,0"
        Effect="{DynamicResource MaterialDesignShadowDepth1}">
                                            <materialDesign:PackIcon Kind="Plus" 
                             Width="14" Height="14" 
                             Foreground="White" 
                             HorizontalAlignment="Center" 
                             VerticalAlignment="Center"/>
                                        </Border>

                                        <Border Grid.Column="1" 
        Background="#F3F4F6" 
        BorderBrush="#E5E7EB" 
        BorderThickness="1" 
        CornerRadius="4" 
        Padding="16,12" 
        Margin="5,0,0,16"
        Effect="{DynamicResource MaterialDesignShadowDepth1}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="Message: " FontWeight="Bold" FontSize="14" Foreground="#4B5563"/>
                                                        <TextBlock Text="{Binding Message}" FontWeight="Bold" FontSize="14" Foreground="#4B5563"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="CalendarMonth" Width="14" Height="14" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding LogDate, StringFormat='\{0:dd-MM-yyyy hh:mm tt\}'}" 
                           FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" 
                           Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding Content}" 
                       FontSize="13" 
                       LineHeight="22"
                       Foreground="#1F2937" 
                       TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <Border Grid.Row="1" VerticalAlignment="Bottom" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,0,0,8"/>

                                                <StackPanel Grid.Row="2" Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <TextBlock Text="{Binding UpdatedBy}" FontWeight="SemiBold" Foreground="#2563EB" FontSize="13"/>
                                                        <TextBlock Text="{Binding UpdatedByContent}" Foreground="#991B1B" FontSize="13" Margin="4,0,0,0"/>
                                                        <!--<TextBlock Text="{Binding FollowupStage, StringFormat=({0})}" Foreground="#991B1B" FontSize="13" Margin="4,0,0,0"/>-->
                                                        <!--<TextBlock Text="{Binding NextFollowUpDisplay}" Foreground="#991B1B" FontSize="13" Margin="4,0,0,0"/>-->
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="Notification sent to: " FontWeight="SemiBold" Foreground="#4B5563" FontSize="13"/>
                                                        <!--<TextBlock Text="Customer" Foreground="#4B5563" FontSize="13"/>-->
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Products"/>
            <TabItem Header="Proforma">
                <Grid Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="10,10,0,12">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Product Proformas" FontSize="18" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Text="Manage and monitor custom quotations issued to this account location terminal." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                Command="{Binding LaunchProformaCreationWizardCommand}"
                Background="#E67E22" BorderBrush="#E67E22" 
                Height="38" Padding="16,0"
                Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePlus" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Create Proforma" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
          ItemsSource="{Binding AssociatedProformas, IsAsync=True}"
          SelectedItem="{Binding SelectedHistoricalProforma}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          Background="White"
          RowBackground="White"
          GridLinesVisibility="Horizontal"
          BorderThickness="0"
          HorizontalContentAlignment="Stretch"
          VerticalAlignment="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding ProformaId}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Proforma ID" Binding="{Binding ProformaNumber}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#1794A1"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Payment Type" Binding="{Binding PaymentType}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Date" Binding="{Binding FormattedDate}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₹{0:N2}'}" Width=".5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}" Padding="8,4" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Payment Status" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding PaymentStatusColor}" Padding="8,4" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PaymentStatus}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Invoice" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Padding="0" Margin="2,0"
                                Command="{Binding DataContext.DownloadInvoicePdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Download" Foreground="#1D4ED8" Width="16" Height="16"/>
                                            </Button>

                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Padding="0" Margin="2,0">
                                                <materialDesign:PackIcon Kind="EmailOutline" Foreground="#0284C7" Width="16" Height="16"/>
                                            </Button>

                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Padding="0" Margin="2,0" 
                                                Command="{Binding DataContext.WhatsappCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Whatsapp" Foreground="#16A34A" Width="16" Height="16"/>
                                            </Button>

                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Padding="0" Margin="6,0,2,0"
                                Command="{Binding DataContext.DeleteProformaRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="DeleteForever" Foreground="#DC2626" Width="16" Height="16"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Documents" FontSize="13" FontWeight="SemiBold">
                <materialDesign:DialogHost Identifier="DocumentTabDialogHost" DialogTheme="Inherit">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Top Inline Mini-Upload Dialog Block -->
                            <RowDefinition Height="*"/>
                            <!-- Single Central DataGrid Workspace -->
                        </Grid.RowDefinitions>

                        <!-- TOP BAR: STREAMLINED MINI-UPLOAD BAR PANEL -->
                        <materialDesign:Card Grid.Row="0" UniformCornerRadius="6" Padding="14,10" Margin="0,0,0,15" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <DockPanel LastChildFill="True">

                                <!-- RIGHT ACTION BUTTONS: Filter, Import, Export -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">

                                    <Button Command="{Binding ClearFiltersCommand}"
                      Visibility="{Binding IsFilterActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Style="{StaticResource MaterialDesignFlatButton}" 
                      Foreground="#DC2626"
                      Height="36" Padding="10,0" Margin="0,0,8,0"
                      ToolTip="Reset all active filters">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilterOff" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Clear Filter" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 1. FILTER BUTTON -->
                                    <Button Command="{Binding OpenFilterDialogCommand}"
      Style="{StaticResource MaterialDesignOutlinedButton}" 
      BorderBrush="#64748B" Foreground="#334155"
      Height="36" Padding="12,0" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilterVariant" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Filter" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. IMPORT BUTTON -->
                                    <Button Command="{Binding OpenImportDialogCommand}"
      Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#059669" BorderBrush="Transparent"
      Height="36" Padding="12,0" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Upload" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Import" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 3. EXPORT BUTTON WITH DROPDOWN MENU -->
                                    <!-- EXPORT BUTTON WITH DROPDOWN MENU -->
                                    <materialDesign:PopupBox
       PlacementMode="BottomAndAlignRightEdges"
       ToolTip="Export Documents"
       Height="36" Padding="0">
                                        <materialDesign:PopupBox.ToggleContent>
                                            <Border Background="#2563EB" CornerRadius="4" Padding="12,0" Height="36">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Download" Foreground="White" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Export" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    <materialDesign:PackIcon Kind="ChevronDown" Foreground="White" Width="16" Height="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </materialDesign:PopupBox.ToggleContent>

                                        <!-- FIXED WIDER CONTAINER (Width="190") TO PREVENT TEXT TRUNCATION -->
                                        <StackPanel Background="White" Margin="4">

                                            <!-- 1. ALL -->
                                            <MenuItem Command="{Binding ExportZipCommand}" 
CommandParameter="All"
Padding="8,6" Margin="0">
                                                <MenuItem.Header>
                                                    <TextBlock Text="ALL" FontWeight="SemiBold" Foreground="#1E293B" Margin="-10,0,0,0"/>
                                                </MenuItem.Header>
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FolderZip" Foreground="#2563EB" Width="18" Height="18"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <!-- 2. FILTERED -->
                                            <MenuItem Command="{Binding ExportZipCommand}" 
CommandParameter="Filtered"
IsEnabled="{Binding IsFilteredEnabled}"
Padding="8,6" Margin="0">
                                                <MenuItem.Header>
                                                    <TextBlock Text="Filtered" FontWeight="SemiBold" Margin="-10,0,0,0"/>
                                                </MenuItem.Header>
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Filter" Foreground="#D97706" Width="18" Height="18"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <!-- 3. SELECTED -->
                                            <MenuItem Command="{Binding ExportZipCommand}" 
CommandParameter="Selected"
IsEnabled="{Binding IsSelectedEnabled}"
Padding="8,6" Margin="0">
                                                <MenuItem.Header>
                                                    <TextBlock Text="Selected" FontWeight="SemiBold" Margin="-10,0,0,0"/>
                                                </MenuItem.Header>
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="CheckboxMarked" Foreground="#059669" Width="18" Height="18"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                        </StackPanel>
                                    </materialDesign:PopupBox>
                                </StackPanel>

                                <!-- LEFT SUMMARY TEXT -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FolderFile" Foreground="#2563EB" Width="22" Height="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DocumentCountSummaryText}" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </materialDesign:Card>

                        <!-- BOTTOM PORTION: CENTRAL COMPLIANCE DATA TABLE GRID -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DisplayedDocuments}" AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox Command="{Binding Data.ToggleSelectAllCommand, Source={StaticResource DataContextProxy}}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Color-Coded Category Label Column -->
                                <DataGridTemplateColumn Header="Category Classification" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" Foreground="#334155"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Dynamic filename metadata column rows values mapping -->
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="3.5*" IsReadOnly="True" FontWeight="Medium"/>
                                <DataGridTextColumn Header="Uploaded By User" Binding="{Binding UploadedBy}" Width="1.5*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Date Logged" Binding="{Binding UploadedAt, StringFormat={}{0:dd-MM-yyyy hh:mm tt}}" Width="2*" IsReadOnly="True"/>

                                <!-- CONTEXT COMPONENT ACTIONS PANEL ROUTE -->
                                <DataGridTemplateColumn Header="Actions" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                                                <Button Command="{Binding DataContext.ReplaceDocumentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#F59E0B" BorderBrush="Transparent" 
                                    Padding="0" Width="28" Height="28" Margin="0,0,6,0" ToolTip="Replace / Overwrite File">
                                                    <materialDesign:PackIcon Kind="FileReplace" Foreground="White" Width="14" Height="14"/>
                                                </Button>

                                                <Button Command="{Binding DataContext.DownloadDocumentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#0284C7" BorderBrush="Transparent" 
                                    Padding="0" Width="28" Height="28" Margin="0,0,6,0" ToolTip="Download File to System">
                                                    <materialDesign:PackIcon Kind="Download" Foreground="White" Width="14" Height="14"/>
                                                </Button>

                                                <Button Command="{Binding DataContext.DeleteDocumentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#DC2626" BorderBrush="Transparent" 
                                    Padding="0" Width="28" Height="28" ToolTip="Delete Document Permanently">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="White" Width="14" Height="14"/>
                                                </Button>

                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:DialogHost>
            </TabItem>

            <!-- Other Tabs (Products, Lead History) here -->
        </TabControl>
    </Grid>
</UserControl>
