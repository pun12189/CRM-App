<UserControl x:Class="Tijori.Views.PurchaseDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F8FAFC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Summary Header Banner -->
            <RowDefinition Height="*"/>
            <!-- Tabbed Workspaces -->
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- 1. TOP PO HEADER BANNER PANEL                                     -->
        <!-- ================================================================= -->
        <Border Background="White" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Back Navigation -->
                    <ColumnDefinition Width="*"/>
                    <!-- PO & Vendor Info -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Grand Total Badge -->
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding NavigateBackCommand}" Style="{StaticResource MaterialDesignIconButton}" Margin="0,0,16,0" ToolTip="Back to Purchase Directory">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="22" Height="22" Foreground="#475569"/>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPurchaseOrder.PoNumber, StringFormat='PO #{0}'}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,12,0"/>
                        <Border Background="#EEF2FF" CornerRadius="12" Padding="10,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPurchaseOrder.OrderStatus}" FontSize="12" FontWeight="SemiBold" Foreground="#4F46E5"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentVendor.CompanyName, StringFormat='Vendor: {0}'}" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F0FDF4" CornerRadius="8" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CurrencyInr" Foreground="#16A34A" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentPurchaseOrder.TotalAmount, StringFormat='Grand Total: ₹{0:N2}'}" FontWeight="Bold" FontSize="15" Foreground="#15803D" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 2. TABBED WORKSPACE CONTAINER                                    -->
        <!-- ================================================================= -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">

            <!-- TAB 1: INFO / DETAILS -->
            <TabItem Header="Info / Details" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                    <StackPanel>
                        <!-- Grid Cards Matrix -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vendor Summary Card -->
                            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Vendor Details" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding CurrentVendor.CompanyName}" FontSize="14" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding CurrentVendor.ContactPerson, StringFormat='Contact: {0}', TargetNullValue='Contact: —'}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CurrentVendor.Phone, StringFormat='Phone: {0}'}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CurrentVendor.Email, StringFormat='Email: {0}', TargetNullValue='Email: —'}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CurrentVendor.GstNumber, StringFormat='GSTIN: {0}', TargetNullValue='GSTIN: —'}" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>

                            <!-- Delivery Tracking Card -->
                            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Delivery &amp; Dates" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding CurrentPurchaseOrder.OrderDate, StringFormat='Order Date: {0:dd-MMM-yyyy}'}" FontSize="12" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding CurrentPurchaseOrder.ExpectedDeliveryDate, StringFormat='Expected Delivery: {0:dd-MMM-yyyy}', TargetNullValue='Expected Delivery: —'}" FontSize="12" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding CurrentPurchaseOrder.ActualDeliveryDate, StringFormat='Actual Delivery: {0:dd-MMM-yyyy}', TargetNullValue='Actual Delivery: —'}" FontSize="12" Foreground="#475569"/>
                                </StackPanel>
                            </Border>

                            <!-- Order Audit Card -->
                            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Order Overview" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding CurrentPurchaseOrder.CreatedBy, StringFormat='Created By: {0}'}" FontSize="12" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding TotalQuantityOrdered, StringFormat='Total Units Ordered: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#0284C7"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Purchase Line Items DataGrid -->
                        <Border Background="White" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Purchased Order Items" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <DataGrid ItemsSource="{Binding OrderItems}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="40">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Code" Binding="{Binding SupplierSku, TargetNullValue='—'}" Width="*"/>
                                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="*"/>
                                        <DataGridTextColumn Header="Unit Price (₹)" Binding="{Binding UnitPrice, StringFormat='{}{0:N2}'}" Width="*"/>
                                        <DataGridTextColumn Header="Total Cost (₹)" Binding="{Binding TotalCost, StringFormat='{}{0:N2}'}" Width="*" FontWeight="Bold"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: DOCUMENTS -->
            <TabItem Header="Documents" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Top Inline Mini-Upload Dialog Block -->
                        <RowDefinition Height="*"/>
                        <!-- Single Central DataGrid Workspace -->
                    </Grid.RowDefinitions>

                    <!-- TOP BAR: STREAMLINED MINI-UPLOAD BAR PANEL -->
                    <materialDesign:Card Grid.Row="0" UniformCornerRadius="6" Padding="14,10" Margin="0,0,0,15" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DockPanel LastChildFill="True">

                            <!-- Right Side Interactive Core Actions -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock Text="Target Category Slot:" Foreground="#475569" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <!-- Dynamic Category Selection Dropdown Dropdown -->
                                <ComboBox ItemsSource="{Binding AvailableDocumentCategories, IsAsync=True}"
                  DisplayMemberPath="CategoryName"
                  SelectedValue="{Binding SelectedUploadCategory}"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                  Width="220" Height="36" Padding="10,4" Margin="0,0,10,0"/>

                                <!-- Bulk/Single File Upload Trigger Command Switch Button -->
                                <Button Command="{Binding UploadDocumentCommand}"
                    Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#059669" BorderBrush="Transparent"
                    Padding="12,0" Height="36" Content="Upload Document File"/>
                            </StackPanel>

                            <!-- Left Title Component Parameter Info Labels -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FolderFile" Foreground="#2563EB" Width="22" Height="22" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DocumentCountSummaryText}" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- BOTTOM PORTION: CENTRAL COMPLIANCE DATA TABLE GRID -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding UnifiedDocumentsCollection, IsAsync=True}" AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <!-- Color-Coded Category Label Column -->
                            <DataGridTemplateColumn Header="Category Classification" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" Foreground="#334155"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Dynamic filename metadata column rows values mapping -->
                            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="3.5*" IsReadOnly="True" FontWeight="Medium"/>
                            <DataGridTextColumn Header="Uploaded By User" Binding="{Binding UploadedBy}" Width="1.5*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Date Logged" Binding="{Binding UploadedAt, StringFormat={}{0:dd-MM-yyyy hh:mm tt}}" Width="2*" IsReadOnly="True"/>

                            <!-- CONTEXT COMPONENT ACTIONS PANEL ROUTE -->
                            <DataGridTemplateColumn Header="Actions" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                                            <Button Command="{Binding DataContext.ReplaceDocumentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#F59E0B" BorderBrush="Transparent" 
                                Padding="0" Width="28" Height="28" Margin="0,0,6,0" ToolTip="Replace / Overwrite File">
                                                <materialDesign:PackIcon Kind="FileReplace" Foreground="White" Width="14" Height="14"/>
                                            </Button>

                                            <Button Command="{Binding DataContext.DownloadDocumentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#0284C7" BorderBrush="Transparent" 
                                Padding="0" Width="28" Height="28" Margin="0,0,6,0" ToolTip="Download File to System">
                                                <materialDesign:PackIcon Kind="Download" Foreground="White" Width="14" Height="14"/>
                                            </Button>

                                            <Button Command="{Binding DataContext.DeleteDocumentFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#DC2626" BorderBrush="Transparent" 
                                Padding="0" Width="28" Height="28" ToolTip="Delete Document Permanently">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="White" Width="14" Height="14"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
