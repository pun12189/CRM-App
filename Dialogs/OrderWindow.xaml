<Window x:Class="Tijori.Dialogs.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tijori.Dialogs"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:Tijori.Converters"
        mc:Ignorable="d" 
        Icon="/Assets/opn.png" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        d:DesignHeight="450" d:DesignWidth="800">
    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Padding="15" Margin="0,0,0,20" Background="#F5F5F5">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="{Binding CurrentCustomer.CustomerName}" FontSize="20" FontWeight="Bold" Foreground="#1794A1"/>
                    <TextBlock Text="{Binding CurrentCustomer.Phone}" Foreground="Gray"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="NEW ORDER" Command="{Binding AddNewOrderCommand}" 
                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" BorderBrush="#2E7D32"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <DataGrid Grid.Row="1" ItemsSource="{Binding OrdersList}" AutoGenerateColumns="False" 
          IsReadOnly="True" SelectedItem="{Binding SelectedOrder}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, StringFormat='dd-MM-yyyy'}" Width="120"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>

                <DataGridTemplateColumn Header="Amount" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TotalAmount, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="8,2" CornerRadius="10" 
                            Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}">
                                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="PAY" Command="{Binding DataContext.CollectPaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}" Height="25" Padding="10,0" Style="{StaticResource MaterialDesignFlatMidBgButton}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
