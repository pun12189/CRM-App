<Window x:Class="CallMan.Dialogs.AdminVerificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Admin Authorization Required" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="Height"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="ShieldLock" Foreground="#2193b0" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="ADMIN AUTHORIZATION REQUIRED" FontWeight="Bold" HorizontalAlignment="Center" FontSize="13" Margin="0,0,0,5"/>
            <TextBlock Text="Please provide the 6-digit token from the Admin's Mobile Authenticator App to authorize this action." TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,0,0,15"/>

            <TextBox Text="{Binding AdminCode, UpdateSourceTrigger=PropertyChanged}" Padding="10,0" MaxLength="6" FontSize="20" FontWeight="Bold" TextAlignment="Center" Width="180" Height="45" VerticalContentAlignment="Center" materialDesign:HintAssist.Hint="000000" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>

            <Grid Margin="0,15,0,0">
                <Button Content="CANCEL" Command="{Binding CancelCommand}" Background="Transparent" BorderThickness="0" Foreground="Gray" HorizontalAlignment="Left" Width="100"/>
                <Button Content="CONFIRM" Command="{Binding ConfirmCommand}" IsDefault="True" Background="#2193b0" Foreground="White" HorizontalAlignment="Right" Width="100"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
