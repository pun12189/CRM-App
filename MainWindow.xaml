        xmlns:vm="clr-namespace:CallMan.ViewModels"
        xmlns:views="clr-namespace:CallMan.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="SofricONE CRM" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LeadViewModel}">
            <views:LeadView />
        </DataTemplate>
