<Window x:Class="CallMan.Dialogs.CustomerProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        xmlns:conv="clr-namespace:CallMan.Converters"
        mc:Ignorable="d"
        Title="Customer Section" Height="700" Width="1024" WindowStartupLocation="CenterOwner"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <materialDesign:BooleanToVisibilityConverter x:Key="InvertedVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <conv:StringContainsConverter x:Key="StringContainsConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Details Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Tabs & Data -->
        <materialDesign:Card Grid.Row="0" Padding="20" Background="#F5F5F5" Visibility="{Binding IsInfoTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Contact -->
                <StackPanel Grid.Column="0">
                    <TextBlock><Run Text="Firm name: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.CompanyName}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Email: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.Email}" Foreground="#2196F3"/></TextBlock>
                    <TextBlock><Run Text="Phone: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.Phone}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Location: " FontWeight="Bold"/><Run Text="{Binding SelectedLead.State}"/></TextBlock>
                </StackPanel>

                <!-- Column 2: Status -->
                <StackPanel Grid.Column="1">
                    <TextBlock><Run Text="Customer Since: " FontWeight="Bold"/><Run Text="{Binding Metrics.CustomerSince}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Last 3 months billing: " FontWeight="Bold"/><Run Text="{Binding Metrics.Last3MonthsBilling}"/></TextBlock>
                    <TextBlock><Run Text="Last order date: " FontWeight="Bold"/><Run Text="{Binding Metrics.LastOrderDate}"/></TextBlock>
                    <TextBlock Margin="0,5"><Run Text="Outstanding: " FontWeight="Bold"/><Run Text="{Binding Metrics.OutstandingAmount}" Foreground="Red"/></TextBlock>
                </StackPanel>

                <!-- Column 3: Business/Target -->
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Business Done/Target" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock><Run Text="Monthly: " Foreground="Red"/><Run Text="{Binding Metrics.MonthlyBusiness}"/></TextBlock>
                        <TextBlock><Run Text="Last 3 Months: " Foreground="Red"/><Run Text="{Binding Metrics.Last3MonthsBusiness}"/></TextBlock>
                        <TextBlock><Run Text="Overall: " Foreground="#2196F3"/><Run Text="{Binding Metrics.OverallBusiness}"/></TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </materialDesign:Card>

        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}" Margin="10" SelectedIndex="{Binding SelectedTabWorkspaceIndex, UpdateSourceTrigger=PropertyChanged}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Margin="0,0,4,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="ArrowDown" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsInfoTabSelected, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="True">
                                            <Setter Property="Kind" Value="ArrowUp"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Text="Info"/>
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem Header="Profile"/>
            <TabItem Header="Update Here" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>                    
                        <!-- 1. ACTION SELECTION (image_0d55ea.png radio buttons) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <RadioButton Content="Matured Followup" IsChecked="{Binding IsMaturedFollowup}" Margin="0,0,15,0"/>
                            <RadioButton Content="Matured Dead" IsChecked="{Binding IsMaturedDead}" Margin="0,0,15,0"/>
                            <RadioButton Content="Create Proforma" IsChecked="{Binding IsCreatingProforma}" Margin="0,0,15,0" Visibility="Visible"/>
                            <RadioButton Content="Create Order" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- 2. ORDER AMOUNTS (Specialized analytics) -->
                        <Grid Grid.Row="1"  Margin="0,0,0,15" Visibility="{Binding IsMaturedFollowup, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding Data.FirstOrderAmount, StringFormat={}{0:C2}, ConverterCulture=en-IN, Mode=OneWay}"
                                 materialDesign:HintAssist.Hint="First Order Amount" IsReadOnly="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <TextBox Grid.Column="2" Text="{Binding Data.LastOrderAmount, StringFormat={}{0:C2}, ConverterCulture=en-IN, Mode=OneWay}"
                                 materialDesign:HintAssist.Hint="Last Order Amount" IsReadOnly="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            <!-- Subtext for last order date/time would go here -->
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,0,0,15" Visibility="{Binding IsMaturedDead, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Dead Reason *" Foreground="#555"/>
                            <ComboBox ItemsSource="{Binding DeadStages}" Margin="0,5,0,0" SelectedItem="{Binding SelectedDeadStage}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Dead Reasons *" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,0,0,15" Visibility="{Binding IsMaturedFollowup, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Visibility="{Binding IsOrderReceived, Converter={StaticResource InvertedVisibilityConverter}}">
                                <TextBlock Text="Mature Stages *" Foreground="#555"/>
                                <ComboBox ItemsSource="{Binding MatureStages}" SelectedItem="{Binding SelectedMatureStage}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Mature Stages *" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,5,0,15"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <CheckBox Content="I have received an order" IsChecked="{Binding IsOrderReceived}" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsOrderReceived, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!-- Order Amount (Only show if checked) -->
                                    <TextBox Text="{Binding OrderValue}" materialDesign:HintAssist.Hint="Order Amount" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="10,0,0,10"/>

                                    <TextBox Text="{Binding PaymentReceived}" materialDesign:HintAssist.Hint="Payment Received" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="10,0,0,10"/>
                                </StackPanel>
                                <Border Background="#FFF4F4" Padding="10" CornerRadius="4" Visibility="{Binding IsOrderReceived, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Balance Due: " VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding BalancePayment, StringFormat='₹ {0:N2}'}" FontWeight="Bold" Foreground="Red" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding FollowupDateLabel}"/>
                                    <DatePicker SelectedDate="{Binding NextFollowupDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayDateStart="{Binding MinDate}" Margin="0,5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

                                    <TextBlock Text="{Binding FollowupTimeLabel}" Foreground="#555" Margin="0,0,0,5"/>

                                    <materialDesign:TimePicker SelectedTime="{Binding SelectedTime}" Is24Hours="False" materialDesign:HintAssist.Hint="Pick Time" materialDesign:TextFieldAssist.HasClearButton="True" VerticalAlignment="Center" xml:lang="en-IN" />

                                    <TextBlock Text="Clock icon appears on hover/focus" FontSize="10" FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>                      

                        <!-- 6. MESSAGE/HISTORY -->
                        <TextBox Grid.Row="4" Text="{Binding Message}" Visibility="{Binding IsCreatingProforma, Converter={StaticResource InvertedVisibilityConverter}}" materialDesign:HintAssist.Hint="Message *"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="100" TextWrapping="Wrap"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                        <!-- 7. SAVE BUTTON -->
                        <Button Grid.Row="5" Command="{Binding UpdateCustomerCommand}" Visibility="{Binding IsCreatingProforma, Converter={StaticResource InvertedVisibilityConverter}}" Content="Update" HorizontalAlignment="Right" 
                            Background="#FF8A3D" BorderBrush="#FF8A3D" Width="120" Height="40"/>

                        <StackPanel Grid.Row="6" Visibility="{Binding IsCreatingProforma, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <materialDesign:Card Padding="14" Margin="0,0,0,12" Background="#FAFAFA" UniformCornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="CartArrowDown" Foreground="#1794A1" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Step 1: Items &amp; Inventory" FontWeight="Bold" FontSize="14" Foreground="#374151" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.5*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.6*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct}" Text="{Binding CustomProductNameText, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Search Catalog or Type Custom Item..." IsEditable="True" Margin="4" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                        <TextBox Grid.Column="1" Text="{Binding InputBatchNo, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Batch No" Margin="4" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        <TextBox Grid.Column="2" Text="{Binding InputQuantity, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Qty" Margin="4" HorizontalContentAlignment="Center" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        <TextBox Grid.Column="3" Text="{Binding InputRate, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Rate (₹)" Margin="4" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        <TextBox Grid.Column="4" Text="{Binding InputGstPercent, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="GST %" Margin="4" HorizontalContentAlignment="Center" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                        <Button Grid.Column="5" Command="{Binding UploadItemImageCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Width="40" Height="40" Margin="4,0" ToolTip="Attach Image Specification">
                                            <Grid>
                                                <materialDesign:PackIcon Kind="CameraPlus" Width="22" Height="22" Foreground="#7F8C8D" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedImagePreview, Converter={StaticResource InvertedVisibilityConverter}}"/>
                                                <Image Source="{Binding SelectedImagePreview}" Width="38" Height="38" Stretch="UniformToFill" Margin="1" Visibility="{Binding SelectedImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Button>

                                        <Button Grid.Column="6" Command="{Binding AddLineItemCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Width="36" Height="36" Background="#1794A1" BorderBrush="#1794A1">
                                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <DataGrid MinHeight="140" MaxHeight="240" GridLinesVisibility="All" ItemsSource="{Binding ActiveProforma.Items}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowBackground="White" HorizontalContentAlignment="Stretch" Margin="0,0,0,16">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Preview" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" BorderThickness="1" BorderBrush="#E5E7EB" Width="38" Height="38" Margin="2" Background="#F9FAFB" ClipToBounds="True">
                                                    <Grid>
                                                        <materialDesign:PackIcon Kind="ImageOff" Foreground="#BDC3C7" HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" Visibility="{Binding LineItemImageSource, Converter={StaticResource InvertedVisibilityConverter}}"/>
                                                        <Image Source="{Binding LineItemImageSource}" Stretch="UniformToFill"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="1*"/>
                                    <DataGridTextColumn Header="Batch / Lot No" Binding="{Binding BatchNo}" Width="Auto"/>
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                                    <DataGridTextColumn Header="Rate" Binding="{Binding UnitPrice, StringFormat='₹{0:N2}'}" Width="100"/>
                                    <DataGridTextColumn Header="GST %" Binding="{Binding GstPercent}" Width="75"/>
                                    <DataGridTextColumn Header="Subtotal" Binding="{Binding SubTotal, StringFormat='₹{0:N2}'}" Width="120"/>
                                    <DataGridTemplateColumn Header="Action" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding DataContext.RemoveCartRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="Red" Width="18" Height="18"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width=".6*"/>
                                    <ColumnDefinition Width=".4*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:Card Padding="14" Margin="0,0,0,16" Background="#FAFAFA" UniformCornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Other Charges / Discounts" FontWeight="Bold" FontSize="13" Margin="2,0,0,10" Foreground="#475569"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <!-- Name Input -->
                                                <ColumnDefinition Width="1.2*"/>
                                                <!-- Action Dropdown Selector -->
                                                <ColumnDefinition Width="1.2*"/>
                                                <!-- Base Value Input -->
                                                <ColumnDefinition Width="1*"/>
                                                <!-- GST % Dropdown Selector -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Action Trigger Add Button -->
                                            </Grid.ColumnDefinitions>

                                            <!-- 1. Charge Name Input Field -->
                                            <TextBox Grid.Column="0" Text="{Binding InputChargeDescription, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Enter name" Margin="4" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                            <!-- 2. Action Dropdown Selector -->
                                            <ComboBox Grid.Column="1" SelectedValue="{Binding InputChargeAction}" SelectedValuePath="Content" materialDesign:HintAssist.Hint="Action" Margin="4" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                <ComboBoxItem Content="Add (+)"/>
                                                <ComboBoxItem Content="Subtract (-)"/>
                                                <ComboBoxItem Content="Percentage (+)"/>
                                                <ComboBoxItem Content="Percentage (-)"/>
                                            </ComboBox>

                                            <!-- 3. Base Amount/Percentage Value Input Field -->
                                            <TextBox Grid.Column="2" Text="{Binding InputChargeAmount, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Enter value" Margin="4" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                            <!-- 4. GST Percentage Dropdown Menu Selector -->
                                            <ComboBox Grid.Column="3" SelectedValue="{Binding InputChargeGst}" SelectedValuePath="Content" materialDesign:HintAssist.Hint="GST" Margin="4" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                <ComboBoxItem Content="0%"/>
                                                <ComboBoxItem Content="5%"/>
                                                <ComboBoxItem Content="12%"/>
                                                <ComboBoxItem Content="18%"/>
                                                <ComboBoxItem Content="28%"/>
                                            </ComboBox>

                                            <!-- 5. Add Button -->
                                            <Button Grid.Column="4" Command="{Binding AddExtraChargeCommand}" Content="ADD" Height="40" Background="#7F8C8D" BorderBrush="#7F8C8D" Width="75" Margin="4,0,2,0"/>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Grid.Column="1" Padding="12" Margin="8,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" UniformCornerRadius="6">
                                    <ListBox ItemsSource="{Binding ActiveProforma.ExtraCharges}" 
                                         MaxHeight="95" 
                                         ScrollViewer.CanContentScroll="True"
                                         HorizontalContentAlignment="Stretch"
                                         Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="340" Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width=".5*"/>
                                                        <ColumnDefinition Width=".3*"/>
                                                        <ColumnDefinition Width=".2*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ChargeDescription}" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Opacity="0.7">
                                                            <TextBlock Text="{Binding ChargeAction}" FontSize="10" Foreground="#64748B"/>
                                                            <TextBlock Text=" | Base: " FontSize="10" Foreground="#64748B" Margin="4,0,0,0"/>
                                                            <TextBlock Text="{Binding BaseValue}" FontSize="10" Foreground="#64748B"/>
                                                            <TextBlock Text=" (GST " FontSize="10" Foreground="#64748B" Margin="4,0,0,0"/>
                                                            <TextBlock Text="{Binding GstPercent, StringFormat='{}{0:N0}%'}" FontSize="10" Foreground="#64748B"/>
                                                            <TextBlock Text=")" FontSize="10" Foreground="#64748B"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" 
                                                           Text="{Binding ChargeAmount, StringFormat='₹{0:N2}'}" 
                                                           FontWeight="Bold" 
                                                           FontSize="12" 
                                                           Margin="8,0" 
                                                               HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ChargeAction, Converter={StaticResource StringContainsConverter}, ConverterParameter='Subtract'}" Value="True">
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ChargeAction, Converter={StaticResource StringContainsConverter}, ConverterParameter='Minus'}" Value="True">
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ChargeAction, Converter={StaticResource StringContainsConverter}, ConverterParameter='(-)'}" Value="True">
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Button Grid.Column="2" 
                                                        Style="{StaticResource MaterialDesignIconButton}" 
                                                        Width="24" 
                                                        Height="24" 
                                                        Padding="0" 
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveExtraChargeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                        CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="CloseCircle" Foreground="#EF4444" Width="16" Height="16"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </materialDesign:Card>
                            </Grid>

                            <materialDesign:Card Padding="16" Margin="0,0,0,16" Background="White" UniformCornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Step 2: Shipping, Invoicing, Terms &amp; Conditions" FontWeight="Bold" FontSize="14" Foreground="#374151" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ActiveProforma.BillTo, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Bill To" AcceptsReturn="True" Height="55" TextWrapping="Wrap" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        <TextBox Grid.Column="2" Text="{Binding ActiveProforma.DeliverTo, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Deliver To" AcceptsReturn="True" Height="55" TextWrapping="Wrap" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ActiveProforma.TermsAndConditions, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Terms &amp; Conditions" AcceptsReturn="True" Height="55" TextWrapping="Wrap" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        <TextBox Grid.Column="2" Text="{Binding ActiveProforma.PreferedTransport, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Preferred Transport (e.g., Porter, VRL)" Height="55" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ActiveProforma.InternalRemarks, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Internal Remarks (Office Notes...)" Style="{StaticResource MaterialDesignOutlinedTextBox}" VerticalContentAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                            <TextBlock Text="Next Followup DateTime *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="2,0,0,6"/>

                                            <!-- Splits Date and Time picking across a clean layout row grid -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <!-- Date Picker Card Box -->
                                                    <ColumnDefinition Width="1*"/>
                                                    <!-- Time Picker Card Box -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Date Component Input -->
                                                <DatePicker Grid.Column="0" SelectedDate="{Binding NextFollowupDate, Mode=TwoWay}" DisplayDateStart="{Binding MinDate}" Margin="0,0,6,0"/>

                                                <!-- Time Component Input -->
                                                <materialDesign:TimePicker Grid.Column="1" SelectedTime="{Binding SelectedTime, Mode=TwoWay}" Is24Hours="False" materialDesign:HintAssist.Hint="Pick Time" materialDesign:TextFieldAssist.HasClearButton="True" xml:lang="en-IN"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Padding="16" Background="#F8FAFC" UniformCornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width=".3*"/>
                                        <ColumnDefinition Width=".3*"/>
                                        <ColumnDefinition Width=".4*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Right Numeric Totals Summary Block Container -->
                                    
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                                            <TextBlock Text="Item SubTotal" Opacity="0.6" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding ActiveProforma.ItemSubTotal, StringFormat='₹{0:N2}'}" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#334155"/>
                                        </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,24,0">
                                            <TextBlock Text="Extra Surcharges" Opacity="0.6" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding ActiveProforma.ExtraChargesTotal, StringFormat='+ ₹{0:N2}'}" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#B45309"/>
                                        </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,28,0">
                                            <TextBlock Text="Grand Value Total" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignBody2TextBlock}" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding ActiveProforma.GrandTotal, StringFormat='₹{0:N2}'}" FontSize="24" FontWeight="Black" Foreground="#1794A1"/>
                                        </StackPanel>
                                    
                                    <Button Grid.Column="3" Content="SAVE &amp; GENERATE PROFORMA" Command="{Binding SaveProformaCommand}" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignRaisedButton}" Background="#673AB7" BorderBrush="#673AB7" Height="40" Width="220" FontSize="12" FontWeight="Bold" materialDesign:ButtonAssist.CornerRadius="4"/>
                                    
                                </Grid>
                            </materialDesign:Card>

                        </StackPanel>                        
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Lead History">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Lead History" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl ItemsSource="{Binding HistoryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Rectangle Grid.Column="0" 
               Fill="#D1D5DB" 
               Width="2" 
               HorizontalAlignment="Center" 
               Margin="0,20,0,-20"/>

                                        <Border Grid.Column="0" 
            Background="#A12E2E" 
            Width="24" Height="24" 
            CornerRadius="12" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Top" 
            Margin="0,14,0,0"
            Effect="{DynamicResource MaterialDesignShadowDepth1}">
                                            <materialDesign:PackIcon Kind="Plus" 
                                 Width="14" Height="14" 
                                 Foreground="White" 
                                 HorizontalAlignment="Center" 
                                 VerticalAlignment="Center"/>
                                        </Border>

                                        <Border Grid.Column="1" 
            Background="#F3F4F6" 
            BorderBrush="#E5E7EB" 
            BorderThickness="1" 
            CornerRadius="4" 
            Padding="16,12" 
            Margin="5,0,0,16"
            Effect="{DynamicResource MaterialDesignShadowDepth1}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="Message: " FontWeight="Bold" FontSize="14" Foreground="#4B5563"/>
                                                        <TextBlock Text="{Binding Message}" FontWeight="Bold" FontSize="14" Foreground="#4B5563"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="CalendarMonth" Width="14" Height="14" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding LogDate, StringFormat='\{0:dd-MM-yyyy hh:mm tt\}'}" 
                               FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" 
                               Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding Content}" 
                           FontSize="13" 
                           LineHeight="22"
                           Foreground="#1F2937" 
                           TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <Border Grid.Row="1" VerticalAlignment="Bottom" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,0,0,8"/>

                                                <StackPanel Grid.Row="2" Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <TextBlock Text="{Binding UpdatedBy}" FontWeight="SemiBold" Foreground="#2563EB" FontSize="13"/>
                                                        <TextBlock Text="{Binding UpdatedByContent}" Foreground="#991B1B" FontSize="13" Margin="4,0,0,0"/>
                                                        <!--<TextBlock Text="{Binding FollowupStage, StringFormat=({0})}" Foreground="#991B1B" FontSize="13" Margin="4,0,0,0"/>-->
                                                        <!--<TextBlock Text="{Binding NextFollowUpDisplay}" Foreground="#991B1B" FontSize="13" Margin="4,0,0,0"/>-->
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="Notification sent to: " FontWeight="SemiBold" Foreground="#4B5563" FontSize="13"/>
                                                        <!--<TextBlock Text="Customer" Foreground="#4B5563" FontSize="13"/>-->
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Products"/>
            <TabItem Header="Proforma">
                <Grid Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="10,10,0,12">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Product Proformas" FontSize="18" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Text="Manage and monitor custom quotations issued to this account location terminal." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                    Command="{Binding LaunchProformaCreationWizardCommand}"
                    Background="#E67E22" BorderBrush="#E67E22" 
                    Height="38" Padding="16,0"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePlus" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Create Proforma" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
              ItemsSource="{Binding AssociatedProformas}"
              SelectedItem="{Binding SelectedHistoricalProforma}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              IsReadOnly="True"
              Background="White"
              RowBackground="White"
              GridLinesVisibility="Horizontal"
              BorderThickness="0"
              HorizontalContentAlignment="Stretch"
              VerticalAlignment="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding ProformaId}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Proforma ID" Binding="{Binding ProformaNumber}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#1794A1"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Payment Type" Binding="{Binding PaymentType}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Date" Binding="{Binding FormattedDate}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₹{0:N2}'}" Width=".5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}" Padding="8,4" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Payment Status" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding PaymentStatusColor}" Padding="8,4" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PaymentStatus}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Invoice" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Padding="0" Margin="2,0"
                                    Command="{Binding DataContext.DownloadInvoicePdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Download" Foreground="#1D4ED8" Width="16" Height="16"/>
                                            </Button>

                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Padding="0" Margin="2,0">
                                                <materialDesign:PackIcon Kind="EmailOutline" Foreground="#0284C7" Width="16" Height="16"/>
                                            </Button>

                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Padding="0" Margin="2,0" 
                                                    Command="{Binding DataContext.WhatsappCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Whatsapp" Foreground="#16A34A" Width="16" Height="16"/>
                                            </Button>

                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Padding="0" Margin="6,0,2,0"
                                    Command="{Binding DataContext.DeleteProformaRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="DeleteForever" Foreground="#DC2626" Width="16" Height="16"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Other Tabs (Products, Lead History) here -->
        </TabControl>
    </Grid>
</Window>
