<Window x:Class="CallMan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan"
        xmlns:vm="clr-namespace:CallMan.ViewModels"
        xmlns:views="clr-namespace:CallMan.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="SofricONE CRM" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LeadViewModel}">
            <views:LeadView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaturedLeadsViewModel}">
            <views:MaturedLeadsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrderViewModel}">
            <views:OrderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AllOrdersViewModel}">
            <views:AllOrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminSettingsViewModel}">
            <views:AdminSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <views:UserManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GenericSettingsViewModel}">
            <views:GenericSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManageCategoriesViewModel}">
            <views:ManageCategoriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:ProductView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompanyProfileViewModel}">
            <views:CompanyProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrderStagesViewModel}">
            <views:OrderStagesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DepartmentsViewModel}">
            <views:DepartmentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginLogsViewModel}">
            <views:LoginLogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmailSettingsViewModel}">
            <views:EmailSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkflowViewModel}">
            <views:WorkflowView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LeadFollowupViewModel}">
            <views:LeadFollowupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OccupiedLocationViewModel}">
            <views:OccupiedLocationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:E2EReportsDashboardViewModel}">
            <views:E2EReportsView />
        </DataTemplate>
        <!--<Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            --><!--<Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>--><!--
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                </Trigger>
            </Style.Triggers>
        </Style>-->
    </Window.Resources>
    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Black" BorderBrush="#DCDDE1" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                
                <Image Source="/Assets/logo.png" Width="190" Stretch="Uniform" CacheMode="BitmapCache" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>                

                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#F1F3F6" CornerRadius="18" Width="400" Height="36">
                    <Grid>
                        <TextBox BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="15,0" Text="Search for leads, customers..."/>
                        <TextBlock Text="🔍" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#7F8C8D"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                         ToolTip="System Reminders &amp; Notification History"
                         Margin="0,0,24,0"
                         ToggleCheckedContentCommand="Close"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         Focusable="False">
                        
                        <materialDesign:PopupBox.ToggleContent>
                            <materialDesign:Badged Badge="{Binding HistoryService.UnreadCount}" 
                                           BadgeColorZoneMode="SecondaryLight">
                                <materialDesign:PackIcon Kind="Bell" Width="24" Height="24" Foreground="White" Cursor="Hand"/>
                            </materialDesign:Badged>
                        </materialDesign:PopupBox.ToggleContent>

                        <Border Width="340" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                            <StackPanel>
                                <Grid Background="#F3F4F6" Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Recent Notifications" FontWeight="Bold" FontSize="13" Foreground="#111827"/>
                                    <materialDesign:PackIcon Grid.Column="1" Kind="LanConnect" Foreground="#15803D" Width="18" Height="18"/>
                                </Grid>

                                <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="0"/>

                                <ListBox ItemsSource="{Binding HistoryService.ActiveNotifications}" 
                                     MaxHeight="300" 
                                     ScrollViewer.CanContentScroll="True"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="NotificationListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="4,10" Background="Transparent" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <materialDesign:PackIcon Kind="AlertCircle" Foreground="#D97706" Width="20" Height="20" Margin="0,2,10,0" VerticalAlignment="Top"/>

                                                    <StackPanel Grid.Column="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding ReminderType}" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#374151"/>

                                                            <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" Margin="10,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#9CA3AF" FontWeight="Normal"/>
                                                        </Grid>

                                                        <TextBlock Text="{Binding MessageText}" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </materialDesign:PopupBox>

                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding UserName}" Foreground="White" materialDesign:HintAssist.IsFloating="False" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding UserDepartment}" Foreground="White" FontSize="10" Opacity="0.6" HorizontalAlignment="Right"/>
                            </StackPanel>

                            <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges" StaysOpen="False" VerticalAlignment="Center">
                                <materialDesign:PopupBox.ToggleContent>
                                    <materialDesign:Card UniformCornerRadius="20" Width="36" Height="36" Background="#F1C40F">
                                        <materialDesign:PackIcon Kind="Account" Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                    </materialDesign:Card>
                                </materialDesign:PopupBox.ToggleContent>

                                <StackPanel Width="150">
                                    <Button Command="{Binding LogoutCommand}" Foreground="Red">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Logout" Margin="0,0,10,0"/>
                                            <TextBlock Text="Logout"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </materialDesign:PopupBox>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
        <materialDesign:ColorZone Grid.Row="1" Mode="Custom" Background="#1794A1" Foreground="White">
            <Menu x:Name="TopMenu" Background="Transparent" VerticalAlignment="Stretch">
                <Menu.Resources>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                        <!--<Setter Property="Height" Value="55"/>-->
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="IsSubmenuOpen" Value="True"/>
                                <Setter Property="Background" Value="#14838F"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#1794A1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style TargetType="ContextMenu" BasedOn="{StaticResource MaterialDesignContextMenu}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Background" Value="White"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ContextMenu">
                                    <materialDesign:Card UniformCornerRadius="2" 
                                     Background="White"
                                     Padding="0" 
                                     Margin="4">
                                        <ScrollViewer x:Name="SubMenuScrollViewer" 
                                  Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">

                                            <ItemsPresenter x:Name="ItemsPresenter" 
                                        KeyboardNavigation.TabNavigation="Cycle" 
                                        Margin="0" 
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </ScrollViewer>
                                    </materialDesign:Card>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="SubItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">                       
                        <Setter Property="Foreground" Value="#2D3436"/>
                        <Setter Property="materialDesign:MenuItemAssist.HighlightedBackground" Value="White"/>

                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1794A1"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Menu.Resources>

                <MenuItem Header="Dashboard" Icon="{materialDesign:PackIcon Kind=ViewDashboard}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                <MenuItem Header="Follow Ups" Icon="{materialDesign:PackIcon Kind=Storage}">
                    <MenuItem Header="Today's Followup" Style="{StaticResource SubItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Today"/>
                    <MenuItem Header="Future Followup" Style="{StaticResource SubItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Future"/>
                </MenuItem>
                <MenuItem Header="Leads" Icon="{materialDesign:PackIcon Kind=AccountGroup}">
                    <MenuItem Header="All Leads" Style="{StaticResource SubItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Leads"/>
                    <MenuItem Header="My Leads" Style="{StaticResource SubItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="MyLeads"/>
                </MenuItem>
                <MenuItem Header="Occupied Locations" Icon="{materialDesign:PackIcon Kind=LocalAreaNetwork}" Command="{Binding NavigateCommand}" CommandParameter="Location"/>
                <MenuItem Header="Dead Leads" Icon="{materialDesign:PackIcon Kind=MedicalBag}">
                    <MenuItem Header="Dead" Style="{StaticResource SubItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dead"/>
                    <MenuItem Header="Winback Pool" Style="{StaticResource SubItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="WinbackPool"/>
                </MenuItem>
                <MenuItem Header="Purchase" Icon="{materialDesign:PackIcon Kind=InboxArrowDown}" IsEnabled="False" Visibility="Collapsed"/>
                <MenuItem Header="CRM" Icon="{materialDesign:PackIcon Kind=AccountGroup}">
                    <MenuItem Header="Customers" Style="{StaticResource SubItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Customers"/>
                    <MenuItem Header="Orders" Style="{StaticResource SubItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Orders"/>
                    <MenuItem Header="Item/Product List" Style="{StaticResource SubItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Inventory"/>
                    <MenuItem Header="Ledger" Style="{StaticResource SubItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Ledger"/>
                    <MenuItem Header="Proforma" Style="{StaticResource SubItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Proforma"/>
                </MenuItem>
                <MenuItem Header="Admin Settings" Icon="{materialDesign:PackIcon Kind=Settings}" Command="{Binding NavigateCommand}" CommandParameter="Admin"/>
                <MenuItem Header="e2e Reports" HorizontalAlignment="Right" Visibility="Collapsed" Icon="{materialDesign:PackIcon Kind=FileDocument}" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
            </Menu>
        </materialDesign:ColorZone>
        <ContentControl Grid.Row="2" Content="{Binding CurrentView}"/>
        <materialDesign:DrawerHost Grid.RowSpan="3" IsRightDrawerOpen="{Binding IsAdminMenuOpen, Mode=TwoWay}">

            <materialDesign:DrawerHost.RightDrawerContent>
                <Grid Width="300" Background="{DynamicResource MaterialDesignPaper}" Margin="20,40">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0">

                        <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch" Height="50" Margin="0,0,0,12" Padding="8,0">
                            <Grid HorizontalAlignment="Stretch" Width="280">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="Lead Management System (LMS)" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"/>

                                <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch" Height="50" Margin="0,0,0,12" Padding="8,0">
                            <Grid HorizontalAlignment="Stretch" Width="280">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="Customer Relationship Management (CRM)" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"/>

                                <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch" Height="50" Margin="0,0,0,12" Padding="8,0">
                            <Grid HorizontalAlignment="Stretch" Width="280">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="Customer Relationship Management (CRM-Pro)" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"/>

                                <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch" Height="50" Margin="0,0,0,12" Padding="8,0">
                            <Grid HorizontalAlignment="Stretch" Width="280">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="Enterprise Resource Planning (ERP)" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13" Foreground="{DynamicResource MaterialDesignBody}"/>

                                <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:DrawerHost.RightDrawerContent>

            <Grid>
                <Button HorizontalAlignment="Right" 
                VerticalAlignment="Bottom"
                Width="100" 
                Height="100"                
                Click="SecretButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </materialDesign:DrawerHost>        
    </Grid>
</Window>
