<Window x:Class="CallMan.Dialogs.AddStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CallMan.Dialogs"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}" Height="550" Width="450"
        WindowStartupLocation="CenterOwner" Background="#F5F7F9"
        WindowStyle="None" AllowsTransparency="True">
    <Window.Resources>
        <materialDesign:BooleanToVisibilityConverter x:Key="InverseBoolToVis" TrueValue="Collapsed" FalseValue="Visible" />
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="#DDD" CornerRadius="8" Background="White">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" FontSize="20" 
                       FontWeight="Bold" Foreground="#1794A1" Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBox Text="{Binding CurrentUser.FullName}" materialDesign:HintAssist.Hint="Full Name" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                    <TextBox Text="{Binding CurrentUser.Email}" materialDesign:HintAssist.Hint="Email ID (Login)" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                    <TextBox Text="{Binding CurrentUser.Phone}" materialDesign:HintAssist.Hint="Phone/WhatsApp (Optional)" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15"/>

                    <PasswordBox x:Name="PassBox" materialDesign:HintAssist.Hint="Set Password" 
                                 Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,15"/>

                    <ComboBox ItemsSource="{Binding Roles}" SelectedValue="{Binding CurrentUser.Role}"
                              materialDesign:HintAssist.Hint="Assign Role"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,15"/>

                    <ComboBox ItemsSource="{Binding PotentialSeniors}" 
                              SelectedValue="{Binding CurrentUser.SeniorId}"
                              SelectedValuePath="UserId" DisplayMemberPath="DisplayName"
                              materialDesign:HintAssist.Hint="Assign Senior/Team Leader"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,15"/>

                    <TextBox Text="{Binding CurrentUser.MonthlyTarget}" materialDesign:HintAssist.Hint="Monthly Target (₹)" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                        <TextBlock Text="Account Status:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#666"/>
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                  IsChecked="{Binding CurrentUser.IsActive}" 
                  ToolTip="Toggle to Activate/Deactivate User Account"/>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Inactive"/>
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentUser.IsActive}" Value="True">
                                            <Setter Property="Text" Value="Active"/>
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="CANCEL" Click="Cancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                <Button Content="SAVE USER" Command="{Binding SaveCommand}" 
                        Background="#1794A1" BorderBrush="#1794A1" Width="120"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
