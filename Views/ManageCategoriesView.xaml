<UserControl x:Class="Tijori.Views.ManageCategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converter="clr-namespace:Tijori.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <materialDesign:BooleanToVisibilityConverter x:Key="InvertedBoolToVisConverter" TrueValue="Collapsed" FalseValue="Visible"/>
        <converter:BoolToEditIconConverter x:Key="BoolToEditIconConverter"/>
        <converter:SubCategoryColorConverter x:Key="SubCategoryColorConverter"/>
        <converter:SubCategoryWeightConverter x:Key="SubCategoryWeightConverter"/>
        <converter:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    <materialDesign:DialogHost Identifier="CategoryDialogHost"
                           Background="#F8FAFC" IsOpen="{Binding IsDialogOpen, Mode=TwoWay}"
                           DialogTheme="Light">
        <!-- DIALOG CONTENT TEMPLATE -->
        <materialDesign:DialogHost.DialogContent>
            <Border Background="White" CornerRadius="12" Width="440" Padding="24">
                <StackPanel>
                    <!-- Dialog Header -->
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="{Binding DialogIcon, FallbackValue=FolderPlus}" 
                                                Foreground="#1794A1" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DialogTitle, FallbackValue='Add Root Category'}" 
                                   FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            DockPanel.Dock="Right" Width="28" Height="28" Padding="0" HorizontalAlignment="Right">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#64748B"/>
                        </Button>
                    </DockPanel>

                    <!-- Parent Info Badge (Visible when creating/editing Sub-Category) -->
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                            Visibility="{Binding HasParent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="SubdirectoryArrowRight" Foreground="#64748B" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Parent: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ParentDisplayName}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Category Name Input -->
                    <TextBox Text="{Binding FormCategoryName, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Category Name (e.g. Tablets, Packaging)" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,16" Height="35" Padding="10,0"/>

                    <!-- Classification / Nature Combo -->
                    <ComboBox ItemsSource="{Binding AvailableClassifications}" 
                          SelectedItem="{Binding FormCategoryType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          materialDesign:HintAssist.Hint="Classification / Nature" 
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,24" Height="35" Padding="10,0"/>

                    <!-- Dialog Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" 
                            Content="CANCEL" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,10,0" Height="38" Padding="16,0"/>

                        <Button Command="{Binding SaveCategoryCommand}" 
                            Content="{Binding SubmitButtonText, FallbackValue='SAVE'}" 
                            Background="#1794A1" BorderBrush="#1794A1" Foreground="White"
                            FontWeight="SemiBold" Height="38" Padding="20,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <!-- MAIN PAGE CONTENT -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR: Title & Primary Root Action -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Command="{Binding OpenAddRootDialogCommand}"
                    Background="#1794A1" BorderBrush="#1794A1" Foreground="White"
                    FontWeight="SemiBold" Height="40" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderPlus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ADD ROOT CATEGORY" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- HIERARCHICAL DATA TABLE -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <DataGrid ItemsSource="{Binding AllCategories, IsAsync=True}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      RowHeight="44"
                      GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="#F1F5F9"
                      Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>

                        <!-- Category Hierarchy Column -->
                        <DataGridTemplateColumn Header="Category Structure" Width="2.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="{Binding IndentationMargin}" VerticalAlignment="Center">
                                        <!-- ROOT CATEGORY -->
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSubCategory, Converter={StaticResource InvertedBoolToVisConverter}}">
                                            <materialDesign:PackIcon Kind="Folder" Foreground="#0284C7" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            <Border Background="#F1F5F9" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="ROOT / MAIN" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- SUB CATEGORY -->
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSubCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="SubdirectoryArrowRight" Foreground="#94A3B8" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <materialDesign:PackIcon Kind="FolderOutline" Foreground="#64748B" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding CategoryName}" FontWeight="Medium" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Classification Badge -->
                        <DataGridTemplateColumn Header="Classification / Nature" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ClassificationBadgeBackground}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClassificationDisplay}" FontSize="10" FontWeight="Bold" Foreground="{Binding ClassificationBadgeForeground}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Parent Group -->
                        <DataGridTemplateColumn Header="Parent Group" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ParentName, FallbackValue='—'}" 
                                           Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Action Buttons -->
                        <DataGridTemplateColumn Header="Actions" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- 🌟 Direct Add Subcategory Button -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                            Command="{Binding DataContext.OpenAddSubCategoryDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" 
                                            ToolTip="Add Sub-Category"
                                            Width="28" Height="28" Padding="0" Margin="0,0,4,0">
                                            <materialDesign:PackIcon Kind="FolderPlus" Width="15" Height="15" Foreground="#1794A1"/>
                                        </Button>

                                        <!-- Edit Button -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                            Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" 
                                            ToolTip="Edit Category"
                                            Width="28" Height="28" Padding="0" Margin="0,0,4,0">
                                            <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Foreground="#D97706"/>
                                        </Button>

                                        <!-- Delete Button -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" 
                                            ToolTip="Delete Category"
                                            Width="28" Height="28" Padding="0">
                                            <materialDesign:PackIcon Kind="TrashCan" Width="14" Height="14" Foreground="#EF4444"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>
