<UserControl x:Class="Tijori.Views.CategorySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tijori.Views"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:enums="clr-namespace:Tijori.Models.Enums"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <md:InvertBooleanConverter x:Key="InvertBoolConverter"/>
    </UserControl.Resources>
    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource MaterialDesignCardBackground}" Grid.Column="0" Padding="10">
            <StackPanel>
                <TextBlock Text="SETTING DOMAINS" Style="{StaticResource MaterialDesignOverlineTextBlock}" Margin="10,10,0,15"/>

                <ListBox SelectedValue="{Binding SelectedContext, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource MaterialDesignNavigationListBox}">
                    <ListBoxItem Content="🏷️ Items" Tag="{x:Static enums:CategoryContext.Items}"/>
                    <ListBoxItem Content="🎯 Leads" Tag="{x:Static enums:CategoryContext.Leads}"/>
                    <ListBoxItem Content="🤝 Customers" Tag="{x:Static enums:CategoryContext.Customers}"/>
                    <ListBoxItem Content="📁 Documents" Tag="{x:Static enums:CategoryContext.Documents}"/>
                </ListBox>
            </StackPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource MaterialDesignDivider}"/>

        <Grid Grid.Column="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,25">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Category Registry" Style="{StaticResource MaterialDesignTitleMediumTextBlock}" FontWeight="Bold"/>
                    <TextBlock Text="Adjust parameters, global ledger flags, margin allocations, and workflow triggers." Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.7" Margin="0,4,0,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="+ CREATE CATEGORY" Command="{Binding OpenAddCategoryCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1794A1" BorderBrush="#1794A1" Height="42"/>
            </DockPanel>

            <ContentControl Grid.Row="1">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Content">
                            <Setter.Value>
                                <DataGrid RowHeight="40" VerticalContentAlignment="Center" ItemsSource="{Binding FilteredCategories, IsAsync=True}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource MaterialDesignDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Category Name" Binding="{Binding CategoryName}" Width="*"/>
                                        <DataGridTextColumn Header="Product Discount" Binding="{Binding MspDiscountPercentage, StringFormat={}{0}%}" Width="130"/>
                                        <DataGridTextColumn Header="Credit Limit" Binding="{Binding CreditLimitAmount, StringFormat={}{0:C}}" Width="140"/>
                                        <DataGridTemplateColumn Header="Operations" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                                        <Button Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignIconButton}" 
                                                            ToolTip="Modify Category Settings"
                                                            Width="32" Height="32" Padding="0" Margin="0,0,4,0">
                                                            <md:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                        </Button>

                                                        <Button Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding IsSystemDefined, Converter={StaticResource InvertBoolConverter}}" 
                                                            Style="{StaticResource MaterialDesignIconButton}" 
                                                            ToolTip="Permanently Delete Category"
                                                            Width="32" Height="32" Padding="0">
                                                            <md:PackIcon Kind="Delete" Width="18" Height="18" Foreground="{DynamicResource ErrorColor}"/>
                                                        </Button>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedContext}" Value="{x:Static enums:CategoryContext.Documents}">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <DataGrid RowHeight="40" VerticalContentAlignment="Center" ItemsSource="{Binding DocumentCategoriesDisplayCollection, IsAsync=True}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource MaterialDesignDataGrid}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Document Category Name" Binding="{Binding CategoryName}" Width="220"/>

                                                <!-- Displays linked modules cleanly like a tag list (e.g. "Lead, Customer, Staff") -->
                                                <DataGridTemplateColumn Header="Accessible Modules" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding LinkedModulesDisplay}" FontWeight="SemiBold" Opacity="0.8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Dynamic Operations Execution Buttons -->
                                                <DataGridTemplateColumn Header="Operations" Width="120">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                                                <Button Command="{Binding DataContext.EditDocCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignIconButton}" ToolTip="Modify Label &amp; Checkboxes" Width="32" Height="32" Margin="0,0,4,0">
                                                                    <md:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                                </Button>

                                                                <Button Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding RawCategory}"
                                                                    IsEnabled="{Binding IsSystemDefined, Converter={StaticResource InvertBoolConverter}}" 
                                                                    Style="{StaticResource MaterialDesignIconButton}" ToolTip="Permanently Delete Document Label" Width="32" Height="32">
                                                                    <md:PackIcon Kind="Delete" Width="18" Height="18" Foreground="{DynamicResource ErrorColor}"/>
                                                                </Button>

                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedContext}" Value="{x:Static enums:CategoryContext.Items}">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <local:ManageCategoriesView DataContext="{Binding ItemsManagementVm}"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
