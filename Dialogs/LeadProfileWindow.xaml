<Window x:Class="Tijori.Dialogs.LeadProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tijori.Dialogs"
        xmlns:view="clr-namespace:Tijori.Views"
        mc:Ignorable="d" x:Name="lpView"
        Icon="/Assets/opn.png" ShowInTaskbar="False"
        Title="{Binding SelectedLead.CustomerName, StringFormat='Profile: {0}', FallbackValue='Loading Profile...', TargetNullValue='New Lead'}"
        Height="700" Width="1024" WindowStartupLocation="CenterOwner">
    <view:LeadProfileView DataContext="{Binding ElementName=lpView, Path=DataContext}"/>
</Window>
