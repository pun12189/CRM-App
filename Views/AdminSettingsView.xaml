<UserControl x:Class="CallMan.Views.AdminSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CallMan.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <materialDesign:BooleanToVisibilityConverter x:Key="InverseBoolToVis" TrueValue="Collapsed" FalseValue="Visible" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>    
    <Grid Background="#F5F7F9" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            
            <TextBlock Text="Admin Settings" FontSize="24" FontWeight="Bold" Foreground="#1794A1" HorizontalAlignment="Left"/>
            <Button Command="{Binding BackToGridCommand}" 
    Visibility="{Binding IsMainGridVisible, Converter={StaticResource InverseBoolToVis}}"
    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Right" Content="&#8593; Back to Settings" FontSize="15"/>
        </DockPanel>

        <!--<ScrollViewer Grid.Row="1" Visibility="{Binding IsMainGridVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <UniformGrid Columns="4" VerticalAlignment="Top">
                    <Button Style="{StaticResource SettingTileStyle}" Content="Staff" CommandParameter="Staff" Command="{Binding NavigateToSettingCommand}"/>
                    <Button Style="{StaticResource SettingTileStyle}" Visibility="Collapsed" Content="Permissions" CommandParameter="Permissions" Command="{Binding NavigateToSettingCommand}"/>
                    <Button Style="{StaticResource SettingTileStyle}" Content="Departments" CommandParameter="Departments" Command="{Binding NavigateToSettingCommand}"/>
                    <Button Style="{StaticResource SettingTileStyle}" Content="Order Stages" CommandParameter="OrderStages" Command="{Binding NavigateToSettingCommand}"/>
                    <Button Style="{StaticResource SettingTileStyle}" Visibility="Collapsed" Content="Fetch Inquiries" CommandParameter="Fetch" Command="{Binding NavigateToSettingCommand}"/>
                    <Button Style="{StaticResource SettingTileStyle}" Content="Login Logs" CommandParameter="Logs" Command="{Binding NavigateToSettingCommand}"/>
                    <Button Style="{StaticResource SettingTileStyle}" Content="Workflows" CommandParameter="Workflows" Command="{Binding NavigateToSettingCommand}"/>
                    <Button Style="{StaticResource SettingTileStyle}" Content="Categories" CommandParameter="Category" Command="{Binding NavigateToSettingCommand}"/>
                    <Button Style="{StaticResource SettingTileStyle}" Content="Company Profile" CommandParameter="CProfile" Command="{Binding NavigateToSettingCommand}"/>
                    <Button Style="{StaticResource SettingTileStyle}" Content="Connect Email" CommandParameter="Email" Command="{Binding NavigateToSettingCommand}"/>
                    <Button Style="{StaticResource SettingTileStyle}" Content="Connect Whatsapp" CommandParameter="Whatsapp" Command="{Binding NavigateToSettingCommand}"/>
                </UniformGrid>

                <materialDesign:Card Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <Expander Header="Lead Settings" IsExpanded="True" Background="#1794A1" Foreground="White">
                            <StackPanel Background="White">
                                <Button Content="Add New Location" Style="{StaticResource SidebarLinkStyle}"/>
                                <Button Content="Dead Reasons" Style="{StaticResource SidebarLinkStyle}" CommandParameter="Dead Reasons" Command="{Binding NavigateToSettingCommand}"/>
                                <Button Content="Followup Stages" Style="{StaticResource SidebarLinkStyle}" CommandParameter="Followup Stages" Command="{Binding NavigateToSettingCommand}"/>
                                <Button Content="Mature Stages" Style="{StaticResource SidebarLinkStyle}" CommandParameter="Mature Stages" Command="{Binding NavigateToSettingCommand}"/>
                                <Button Content="Lead Tags" Style="{StaticResource SidebarLinkStyle}" CommandParameter="Lead Tags" Command="{Binding NavigateToSettingCommand}"/>
                                <Button Content="Custom Fields" Style="{StaticResource SidebarLinkStyle}"/>
                                <Button Content="Lead Source" Style="{StaticResource SidebarLinkStyle}" CommandParameter="Lead Source" Command="{Binding NavigateToSettingCommand}"/>
                                <Separator/>
                                <Button Content="Lead Label" Style="{StaticResource SidebarLinkStyle}" CommandParameter="Lead Labels" Command="{Binding NavigateToSettingCommand}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </ScrollViewer>-->

        <ScrollViewer Grid.Row="1" Visibility="{Binding IsMainGridVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <VirtualizingStackPanel Orientation="Vertical">
                <Expander Expanded="Expander_Expanded" Background="Transparent" Tag="1" Margin="5,10" BorderThickness="1" BorderBrush="Black" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsExpander1Open, Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <materialDesign:PackIcon Kind="Build" VerticalAlignment="Center" Height="24" Width="24"/>
                            <TextBlock Text="Internal Setup" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <UniformGrid Columns="4" VerticalAlignment="Top">
                        <Button Style="{StaticResource SettingTileStyle}" Content="Company Profile" CommandParameter="CProfile" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Departments" CommandParameter="Departments" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Staff" CommandParameter="Staff" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Order Stages" CommandParameter="OrderStages" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Categories" CommandParameter="Category" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Proforma Settings" CommandParameter="Fetch" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Notice Board" CommandParameter="Notice" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Login Logs" CommandParameter="Logs" Command="{Binding NavigateToSettingCommand}"/>
                    </UniformGrid>
                </Expander>
                <Expander Expanded="Expander_Expanded" Background="Transparent" Tag="2" Margin="5,10" BorderThickness="1" BorderBrush="Black" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsExpander2Open, Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <materialDesign:PackIcon Kind="Settings" VerticalAlignment="Center" Height="24" Width="24"/>
                            <TextBlock Text="Lead Settings" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <UniformGrid Columns="4" VerticalAlignment="Top">
                        <Button Content="Add New Location" Style="{StaticResource SettingTileStyle}"/>
                        <Button Content="Dead Reasons" Style="{StaticResource SettingTileStyle}" CommandParameter="Dead Reasons" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Content="Followup Stages" Style="{StaticResource SettingTileStyle}" CommandParameter="Followup Stages" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Content="Mature Stages" Style="{StaticResource SettingTileStyle}" CommandParameter="Mature Stages" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Content="Lead Tags" Style="{StaticResource SettingTileStyle}" CommandParameter="Lead Tags" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Content="Custom Fields" Style="{StaticResource SettingTileStyle}"/>
                        <Button Content="Lead Source" Style="{StaticResource SettingTileStyle}" CommandParameter="Lead Source" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Content="Lead Label" Style="{StaticResource SettingTileStyle}" CommandParameter="Lead Labels" Command="{Binding NavigateToSettingCommand}"/>
                    </UniformGrid>

                </Expander>
                <Expander Expanded="Expander_Expanded" Background="Transparent" Tag="3" Margin="5,10" BorderThickness="1" BorderBrush="Black" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsExpander3Open, Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <materialDesign:PackIcon Kind="SourceMerge" VerticalAlignment="Center" Height="24" Width="24"/>
                            <TextBlock Text="Third Party Integrations" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <UniformGrid Columns="4" VerticalAlignment="Top">
                        <Button Style="{StaticResource SettingTileStyle}" Content="Connect Email" CommandParameter="Email" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Connect Whatsapp" CommandParameter="Whatsapp" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Connect CallMan" CommandParameter="CallMan" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Connect ECom" CommandParameter="ECom" Command="{Binding NavigateToSettingCommand}"/>
                    </UniformGrid>
                </Expander>
                <Expander Expanded="Expander_Expanded" Background="Transparent" Tag="4" Margin="5,10" BorderThickness="1" BorderBrush="Black" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsExpander4Open, Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <materialDesign:PackIcon Kind="Automatic" VerticalAlignment="Center" Height="24" Width="24"/>
                            <TextBlock Text="Automations" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <UniformGrid Columns="4" VerticalAlignment="Top">
                        <Button Style="{StaticResource SettingTileStyle}" Content="Templates" CommandParameter="Templates" Command="{Binding NavigateToSettingCommand}"/>
                        <Button Style="{StaticResource SettingTileStyle}" Content="Enable AI" CommandParameter="Workflows" Command="{Binding NavigateToSettingCommand}"/>
                    </UniformGrid>
                </Expander>
            </VirtualizingStackPanel>
        </ScrollViewer>

        <ContentControl Grid.Row="1" Content="{Binding CurrentSettingView}" 
                    Visibility="{Binding IsMainGridVisible, Converter={StaticResource InverseBoolToVis}}"/>
    </Grid>
</UserControl>
